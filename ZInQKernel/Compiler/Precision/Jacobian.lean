import ZInQKernel.Model.Field.ShortWeierstrass

/-!
# Jacobian formulas on the weighted model

Blueprint: `compiler/natural/precision/jacobian-formulas.md`.

On the weighted model `𝓔(X, Y, Z) = Y² - X³ - A X Z⁴` of `y² = x³ + A x`, a triple `(X, Y, Z)`
with `Z ≠ 0` stands for the affine point `(X/Z², Y/Z³)`. This file defines the Jacobian doubling
`jdbl` and addition `jadd` over a commutative ring and proves the eight items of the article:
the curve equation is preserved (items 1, 2, with explicit cofactors), the formulas compute the
tangent and chord constructions over a field (items 3–6), and the exceptional branches (items
7, 8). It then defines the branching operations `jdblB`, `jaddB` (with `O = (1, 1, 0)`) and proves
that they compute the group law of `shortCurve A` on representatives (`Rep`).
-/

namespace ZInQ.Compiler.Precision

open WeierstrassCurve WeierstrassCurve.Affine

/-- A triple `(X, Y, Z)` of weighted (Jacobian) coordinates. -/
@[ext] structure JTriple (R : Type*) where
  X : R
  Y : R
  Z : R
  deriving DecidableEq, Repr

namespace JTriple

section CommRing

variable {R S : Type*} [CommRing R] [CommRing S]

/-- `𝓔(X, Y, Z) = Y² - X³ - A X Z⁴`. -/
def curveE (A : R) (P : JTriple R) : R := P.Y ^ 2 - P.X ^ 3 - A * P.X * P.Z ^ 4

/-- Jacobian doubling: `M = 3X² + AZ⁴`, `S = 4XY²`, `X₃ = M² - 2S`,
`dbl(X, Y, Z) = (X₃, M(S - X₃) - 8Y⁴, 2YZ)`. -/
def jdbl (A : R) (P : JTriple R) : JTriple R :=
  let M := 3 * P.X ^ 2 + A * P.Z ^ 4
  let S := 4 * P.X * P.Y ^ 2
  let X3 := M ^ 2 - 2 * S
  ⟨X3, M * (S - X3) - 8 * P.Y ^ 4, 2 * P.Y * P.Z⟩

/-- `H = U₂ - U₁` with `U₁ = X₁Z₂²`, `U₂ = X₂Z₁²`. -/
def jH (P Q : JTriple R) : R := Q.X * P.Z ^ 2 - P.X * Q.Z ^ 2

/-- `Λ = S₂ - S₁` with `S₁ = Y₁Z₂³`, `S₂ = Y₂Z₁³`. -/
def jΛ (P Q : JTriple R) : R := Q.Y * P.Z ^ 3 - P.Y * Q.Z ^ 3

/-- Jacobian addition: `X₃ = Λ² - H³ - 2U₁H²`, `Y₃ = Λ(U₁H² - X₃) - S₁H³`, `Z₃ = HZ₁Z₂`. -/
def jadd (P Q : JTriple R) : JTriple R :=
  let U1 := P.X * Q.Z ^ 2
  let S1 := P.Y * Q.Z ^ 3
  let H := jH P Q
  let Λ := jΛ P Q
  let X3 := Λ ^ 2 - H ^ 3 - 2 * U1 * H ^ 2
  ⟨X3, Λ * (U1 * H ^ 2 - X3) - S1 * H ^ 3, H * P.Z * Q.Z⟩

/-- Negation `(X, Y, Z) ↦ (X, -Y, Z)`. -/
def jneg (P : JTriple R) : JTriple R := ⟨P.X, -P.Y, P.Z⟩

/-- Componentwise image under a ring homomorphism. -/
def map (f : R →+* S) (P : JTriple R) : JTriple S := ⟨f P.X, f P.Y, f P.Z⟩

@[simp] theorem map_X (f : R →+* S) (P : JTriple R) : (P.map f).X = f P.X := rfl
@[simp] theorem map_Y (f : R →+* S) (P : JTriple R) : (P.map f).Y = f P.Y := rfl
@[simp] theorem map_Z (f : R →+* S) (P : JTriple R) : (P.map f).Z = f P.Z := rfl

theorem map_jdbl (f : R →+* S) (A : R) (P : JTriple R) :
    (jdbl A P).map f = jdbl (f A) (P.map f) := by
  ext <;> simp [jdbl, map, map_ofNat]

theorem map_jH (f : R →+* S) (P Q : JTriple R) : f (jH P Q) = jH (P.map f) (Q.map f) := by
  simp [jH, map]

theorem map_jΛ (f : R →+* S) (P Q : JTriple R) : f (jΛ P Q) = jΛ (P.map f) (Q.map f) := by
  simp [jΛ, map]

theorem map_jadd (f : R →+* S) (P Q : JTriple R) :
    (jadd P Q).map f = jadd (P.map f) (Q.map f) := by
  ext <;> simp [jadd, jH, jΛ, map, map_ofNat]

theorem map_jneg (f : R →+* S) (P : JTriple R) : (jneg P).map f = jneg (P.map f) := by
  ext <;> simp [jneg, map]

theorem map_curveE (f : R →+* S) (A : R) (P : JTriple R) :
    f (curveE A P) = curveE (f A) (P.map f) := by
  simp [curveE, map]

/-! ### Items 1 and 2: the curve equation is preserved -/

/-- Item 1 with its cofactor: `𝓔(dbl P) = 64 Y⁶ 𝓔(P)`. -/
theorem curveE_jdbl (A : R) (P : JTriple R) : curveE A (jdbl A P) = 64 * P.Y ^ 6 * curveE A P := by
  simp only [curveE, jdbl]; ring

/-- Item 1: `𝓔(dbl P)` lies in the ideal generated by `𝓔(P)`. -/
theorem curveE_jdbl_mem (A : R) (P : JTriple R) :
    curveE A (jdbl A P) ∈ Ideal.span {curveE A P} :=
  Ideal.mem_span_singleton'.mpr ⟨64 * P.Y ^ 6, by rw [curveE_jdbl]⟩

/-- The cofactor of `𝓔(P₁)` in `𝓔(add(P₁, P₂))`. -/
def addCofactor₁ (A : R) (P Q : JTriple R) : R :=
  Q.Z ^ 6 * (P.X * Q.Z ^ 2 - Q.X * P.Z ^ 2) ^ 3 *
    (A * Q.X * P.Z ^ 6 * Q.Z ^ 4 - P.X ^ 3 * Q.Z ^ 6 + 3 * P.X * Q.X ^ 2 * P.Z ^ 4 * Q.Z ^ 2 -
      Q.X ^ 3 * P.Z ^ 6 + P.Y ^ 2 * Q.Z ^ 6 - 2 * P.Y * Q.Y * P.Z ^ 3 * Q.Z ^ 3)

/-- The cofactor of `𝓔(P₂)` in `𝓔(add(P₁, P₂))`. -/
def addCofactor₂ (A : R) (P Q : JTriple R) : R :=
  -(P.Z ^ 6 * (P.X * Q.Z ^ 2 - Q.X * P.Z ^ 2) ^ 3 *
    (A * P.X * P.Z ^ 4 * Q.Z ^ 6 - P.X ^ 3 * Q.Z ^ 6 + 3 * P.X ^ 2 * Q.X * P.Z ^ 2 * Q.Z ^ 4 -
      Q.X ^ 3 * P.Z ^ 6 - 2 * P.Y * Q.Y * P.Z ^ 3 * Q.Z ^ 3 + Q.Y ^ 2 * P.Z ^ 6))

/-- Item 2 with its cofactors. -/
theorem curveE_jadd (A : R) (P Q : JTriple R) :
    curveE A (jadd P Q) = addCofactor₁ A P Q * curveE A P + addCofactor₂ A P Q * curveE A Q := by
  simp only [curveE, jadd, jH, jΛ, addCofactor₁, addCofactor₂]; ring

/-- Item 2: `𝓔(add(P₁, P₂))` lies in the ideal generated by `𝓔(P₁)` and `𝓔(P₂)`. -/
theorem curveE_jadd_mem (A : R) (P Q : JTriple R) :
    curveE A (jadd P Q) ∈ Ideal.span {curveE A P, curveE A Q} := by
  rw [curveE_jadd]
  exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
    (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))

theorem curveE_jneg (A : R) (P : JTriple R) : curveE A (jneg P) = curveE A P := by
  simp [curveE, jneg]

/-! ### Branching operations -/

/-- The identity `O = (1, 1, 0)`. -/
def jO : JTriple R := ⟨1, 1, 0⟩

theorem curveE_jO (A : R) : curveE A (jO : JTriple R) = 0 := by simp [curveE, jO]

theorem map_jO (f : R →+* S) : (jO : JTriple R).map f = jO := by ext <;> simp [jO, map]

variable [DecidableEq R] [DecidableEq S]

/-- Doubling with `O ↦ O` and points of zero ordinate `↦ O`. -/
def jdblB (A : R) (P : JTriple R) : JTriple R :=
  if P.Z = 0 ∨ P.Y = 0 then jO else jdbl A P

/-- The branching addition: if one argument has `Z = 0` return the other; if `H ≠ 0` use
`jadd`; if `H = 0` and `Λ = 0` double; if `H = 0` and `Λ ≠ 0` return `O`. -/
def jaddB (A : R) (P Q : JTriple R) : JTriple R :=
  if P.Z = 0 then Q
  else if Q.Z = 0 then P
  else if jH P Q ≠ 0 then jadd P Q
  else if jΛ P Q = 0 then jdblB A P
  else jO

theorem curveE_jdblB {A : R} {P : JTriple R} (hP : curveE A P = 0) :
    curveE A (jdblB A P) = 0 := by
  unfold jdblB; split_ifs
  · exact curveE_jO A
  · rw [curveE_jdbl, hP, mul_zero]

theorem curveE_jaddB {A : R} {P Q : JTriple R} (hP : curveE A P = 0) (hQ : curveE A Q = 0) :
    curveE A (jaddB A P Q) = 0 := by
  unfold jaddB; split_ifs
  · exact hQ
  · exact hP
  · rw [curveE_jadd, hP, hQ]; ring
  · exact curveE_jdblB hP
  · exact curveE_jO A

theorem map_jdblB {f : R →+* S} (hf : Function.Injective f) (A : R) (P : JTriple R) :
    (jdblB A P).map f = jdblB (f A) (P.map f) := by
  have hz : ∀ r : R, f r = 0 ↔ r = 0 := fun r => map_eq_zero_iff f hf
  simp only [jdblB, map_Z, map_Y, hz]
  split_ifs
  · exact map_jO f
  · exact map_jdbl f A P

theorem map_jaddB {f : R →+* S} (hf : Function.Injective f) (A : R) (P Q : JTriple R) :
    (jaddB A P Q).map f = jaddB (f A) (P.map f) (Q.map f) := by
  have hz : ∀ r : R, f r = 0 ↔ r = 0 := fun r => map_eq_zero_iff f hf
  simp only [jaddB, map_Z, ← map_jH, ← map_jΛ, ne_eq, hz]
  split_ifs <;> first | rfl | exact map_jadd f P Q | exact map_jdblB hf A P | exact map_jO f

end CommRing

/-! ### Items 3–8 over a field -/

section Field

variable {F : Type*} [Field F]

/-- The common computation of items 3–6: if `xᵢ = aᵢ/Z₃²`, `y₁ = b₁/Z₃³`, `X₃ = L² - a₁ - a₂`
and `Y₃ = L(a₁ - X₃) - b₁`, then with `λ = L/Z₃`, `X₃/Z₃² = λ² - x₁ - x₂` and
`Y₃/Z₃³ = λ(x₁ - X₃/Z₃²) - y₁`. -/
theorem chord_aux {X3 Y3 Z3 L a1 a2 b1 x1 x2 y1 : F} (hZ3 : Z3 ≠ 0) (hx1 : x1 = a1 / Z3 ^ 2)
    (hx2 : x2 = a2 / Z3 ^ 2) (hy1 : y1 = b1 / Z3 ^ 3) (hX3 : X3 = L ^ 2 - a1 - a2)
    (hY3 : Y3 = L * (a1 - X3) - b1) :
    X3 / Z3 ^ 2 = (L / Z3) ^ 2 - x1 - x2 ∧ Y3 / Z3 ^ 3 = L / Z3 * (x1 - X3 / Z3 ^ 2) - y1 := by
  subst hx1 hx2 hy1 hY3 hX3
  constructor <;> field_simp

/-- Items 3 and 4: for `YZ ≠ 0`, with `x = X/Z²`, `y = Y/Z³` and `λ = (3x² + A)/(2y) = M/Z₃`,
doubling gives `X₃/Z₃² = λ² - 2x` and `Y₃/Z₃³ = λ(x - X₃/Z₃²) - y`. -/
theorem jdbl_affine (A : F) (P : JTriple F) (h2 : (2 : F) ≠ 0) (hY : P.Y ≠ 0) (hZ : P.Z ≠ 0) :
    let x := P.X / P.Z ^ 2
    let y := P.Y / P.Z ^ 3
    let l := (3 * x ^ 2 + A) / (2 * y)
    (jdbl A P).Z ≠ 0 ∧ l = (3 * P.X ^ 2 + A * P.Z ^ 4) / (jdbl A P).Z ∧
      (jdbl A P).X / (jdbl A P).Z ^ 2 = l ^ 2 - 2 * x ∧
      (jdbl A P).Y / (jdbl A P).Z ^ 3 = l * (x - (jdbl A P).X / (jdbl A P).Z ^ 2) - y := by
  intro x y l
  have hZ3 : (jdbl A P).Z ≠ 0 := by simp only [jdbl]; exact mul_ne_zero (mul_ne_zero h2 hY) hZ
  refine ⟨hZ3, ?_, ?_, ?_⟩ <;> simp only [x, y, l, jdbl] <;> field_simp <;> ring

/-- Items 5 and 6: for `Z₁Z₂H ≠ 0`, with `xᵢ = Xᵢ/Zᵢ²`, `yᵢ = Yᵢ/Zᵢ³` and
`λ = (y₂ - y₁)/(x₂ - x₁) = Λ/Z₃`, addition gives `X₃/Z₃² = λ² - x₁ - x₂` and
`Y₃/Z₃³ = λ(x₁ - X₃/Z₃²) - y₁`. -/
theorem jadd_affine (P Q : JTriple F) (hP : P.Z ≠ 0) (hQ : Q.Z ≠ 0) (hH : jH P Q ≠ 0) :
    let x₁ := P.X / P.Z ^ 2
    let y₁ := P.Y / P.Z ^ 3
    let x₂ := Q.X / Q.Z ^ 2
    let y₂ := Q.Y / Q.Z ^ 3
    let l := (y₂ - y₁) / (x₂ - x₁)
    x₁ ≠ x₂ ∧ (jadd P Q).Z ≠ 0 ∧ l = jΛ P Q / (jadd P Q).Z ∧
      (jadd P Q).X / (jadd P Q).Z ^ 2 = l ^ 2 - x₁ - x₂ ∧
      (jadd P Q).Y / (jadd P Q).Z ^ 3 = l * (x₁ - (jadd P Q).X / (jadd P Q).Z ^ 2) - y₁ := by
  intro x₁ y₁ x₂ y₂ l
  have hx : x₁ ≠ x₂ := by
    intro h; apply hH; simp only [x₁, x₂] at h; field_simp at h; simp only [jH]; linear_combination -h
  have hx' : x₂ - x₁ ≠ 0 := sub_ne_zero.mpr (Ne.symm hx)
  have hZ3 : (jadd P Q).Z ≠ 0 := by simp only [jadd]; exact mul_ne_zero (mul_ne_zero hH hP) hQ
  have hl : l = jΛ P Q / (jadd P Q).Z := by
    simp only [l, jadd, x₁, x₂, y₁, y₂] at hx' ⊢
    rw [div_eq_div_iff hx' (mul_ne_zero (mul_ne_zero hH hP) hQ)]
    simp only [jH, jΛ]; field_simp
  have hZ3' : jH P Q * P.Z * Q.Z ≠ 0 := hZ3
  obtain ⟨h5, h6⟩ := chord_aux (Z3 := (jadd P Q).Z) (L := jΛ P Q) (a1 := P.X * Q.Z ^ 2 * jH P Q ^ 2)
    (a2 := Q.X * P.Z ^ 2 * jH P Q ^ 2) (b1 := P.Y * Q.Z ^ 3 * jH P Q ^ 3) (x1 := x₁) (x2 := x₂) (y1 := y₁)
    (X3 := (jadd P Q).X) (Y3 := (jadd P Q).Y) hZ3
    (by simp only [x₁, jadd]; rw [div_eq_div_iff (pow_ne_zero 2 hP) (pow_ne_zero 2 hZ3')]; ring)
    (by simp only [x₂, jadd]; rw [div_eq_div_iff (pow_ne_zero 2 hQ) (pow_ne_zero 2 hZ3')]; ring)
    (by simp only [y₁, jadd]; rw [div_eq_div_iff (pow_ne_zero 3 hP) (pow_ne_zero 3 hZ3')]; ring)
    (by simp only [jadd, jH]; ring) (by simp only [jadd])
  exact ⟨hx, hZ3, hl, by rw [hl]; exact h5, by rw [hl]; exact h6⟩

/-- Item 7: for `Z₁Z₂ ≠ 0`, `H = 0 ↔ x₁ = x₂`, and then `Λ = 0 ↔ y₁ = y₂`. -/
theorem jH_eq_zero_iff (P Q : JTriple F) (hP : P.Z ≠ 0) (hQ : Q.Z ≠ 0) :
    jH P Q = 0 ↔ P.X / P.Z ^ 2 = Q.X / Q.Z ^ 2 := by
  rw [div_eq_div_iff (pow_ne_zero 2 hP) (pow_ne_zero 2 hQ), jH, sub_eq_zero]
  constructor <;> intro h <;> linear_combination -h

theorem jΛ_eq_zero_iff (P Q : JTriple F) (hP : P.Z ≠ 0) (hQ : Q.Z ≠ 0) :
    jΛ P Q = 0 ↔ P.Y / P.Z ^ 3 = Q.Y / Q.Z ^ 3 := by
  rw [div_eq_div_iff (pow_ne_zero 3 hP) (pow_ne_zero 3 hQ), jΛ, sub_eq_zero]
  constructor <;> intro h <;> linear_combination -h

/-! ### Representatives and the group law -/

/-- `T` represents the point `P` of `y² = x³ + A x`: `Z = 0` and `P = O`, or `Z ≠ 0` and
`P = (X/Z², Y/Z³)`. -/
def Rep (A : F) (T : JTriple F) (P : (shortCurve A).toAffine.Point) : Prop :=
  (T.Z = 0 ∧ P = 0) ∨
    (T.Z ≠ 0 ∧ ∃ h : (shortCurve A).toAffine.Nonsingular (T.X / T.Z ^ 2) (T.Y / T.Z ^ 3),
      P = .some _ _ h)

theorem some_eq_some_of {W : WeierstrassCurve F} {x y x' y' : F} (h : W.toAffine.Nonsingular x y)
    (hx : x = x') (hy : y = y') : ∃ h' : W.toAffine.Nonsingular x' y', Point.some x y h = .some _ _ h' := by
  subst hx hy; exact ⟨h, rfl⟩

theorem rep_jO (A : F) : Rep A jO 0 := Or.inl ⟨rfl, rfl⟩

theorem Rep.congr_point {A : F} {T : JTriple F} {P Q : (shortCurve A).toAffine.Point}
    (h : Rep A T P) (e : P = Q) : Rep A T Q := e ▸ h

theorem Rep.eq_zero_iff {A : F} {T : JTriple F} {P} (h : Rep A T P) : P = 0 ↔ T.Z = 0 := by
  rcases h with ⟨hZ, hP⟩ | ⟨hZ, h, hP⟩
  · exact ⟨fun _ => hZ, fun _ => hP⟩
  · exact ⟨fun h' => absurd (hP ▸ h') (Point.some_ne_zero _), fun h' => absurd h' hZ⟩

/-- Item 8 (negation): `(X, -Y, Z)` represents `-P`. -/
theorem rep_jneg {A : F} {T : JTriple F} {P} (h : Rep A T P) : Rep A (jneg T) (-P) := by
  rcases h with ⟨hZ, rfl⟩ | ⟨hZ, h, rfl⟩
  · exact Or.inl ⟨hZ, by simp⟩
  · refine Or.inr ⟨hZ, ?_⟩
    rw [Point.neg_some]
    exact some_eq_some_of _ rfl (by rw [shortCurve_negY, jneg, neg_div])

variable [DecidableEq F]

/-- Item 8 (zero ordinate): a point `(x, 0)` has order two. -/
theorem two_nsmul_of_Y_eq_zero [NeZero (2 : F)] {A x : F}
    (h : (shortCurve A).toAffine.Nonsingular x 0) : 2 • Point.some x 0 h = 0 :=
  (shortCurve_two_nsmul_some_eq_zero_iff h).mpr rfl

/-- `jdblB` computes doubling on representatives. -/
theorem rep_jdblB [NeZero (2 : F)] {A : F} {T : JTriple F} {P} (h : Rep A T P) :
    Rep A (jdblB A T) (P + P) := by
  have h2 : (2 : F) ≠ 0 := NeZero.ne 2
  rcases h with ⟨hZ, rfl⟩ | ⟨hZ, hns, rfl⟩
  · rw [jdblB, ite_eq_left (Or.inl hZ), add_zero]; exact rep_jO A
  · by_cases hY : T.Y = 0
    · rw [jdblB, ite_eq_left (Or.inr hY)]
      have : T.Y / T.Z ^ 3 = (shortCurve A).toAffine.negY (T.X / T.Z ^ 2) (T.Y / T.Z ^ 3) := by
        rw [shortCurve_negY, hY]; simp
      rw [Point.add_self_of_Y_eq this]
      exact rep_jO A
    · rw [jdblB, ite_eq_right (not_or.mpr ⟨hZ, hY⟩)]
      have hy : T.Y / T.Z ^ 3 ≠ (shortCurve A).toAffine.negY (T.X / T.Z ^ 2) (T.Y / T.Z ^ 3) := by
        rw [shortCurve_negY]
        intro h'
        have : 2 * (T.Y / T.Z ^ 3) = 0 := by linear_combination h'
        exact div_ne_zero hY (pow_ne_zero 3 hZ) ((mul_eq_zero.mp this).resolve_left h2)
      obtain ⟨hZ3, hl, hX3, hY3⟩ := jdbl_affine A T h2 hY hZ
      refine Or.inr ⟨hZ3, ?_⟩
      rw [Point.add_self_of_Y_ne hy]
      have hs : (shortCurve A).toAffine.slope (T.X / T.Z ^ 2) (T.X / T.Z ^ 2) (T.Y / T.Z ^ 3)
          (T.Y / T.Z ^ 3) = (3 * (T.X / T.Z ^ 2) ^ 2 + A) / (2 * (T.Y / T.Z ^ 3)) := by
        rw [slope_of_Y_ne rfl hy, shortCurve_negY]; simp; ring
      apply some_eq_some_of
      · rw [hX3, addX, hs]; simp; ring
      · rw [hY3, addY, negAddY, addX, hs, shortCurve_negY, hX3]; simp; ring

/-- `jaddB` computes addition on representatives. -/
theorem rep_jaddB [NeZero (2 : F)] {A : F} {T T' : JTriple F} {P Q} (h : Rep A T P)
    (h' : Rep A T' Q) : Rep A (jaddB A T T') (P + Q) := by
  rcases h with ⟨hZ, rfl⟩ | ⟨hZ, hns, rfl⟩
  · rw [jaddB, ite_eq_left hZ, zero_add]; exact h'
  rcases h' with ⟨hZ', rfl⟩ | ⟨hZ', hns', rfl⟩
  · rw [jaddB, ite_eq_right hZ, ite_eq_left hZ', add_zero]; exact Or.inr ⟨hZ, hns, rfl⟩
  rw [jaddB, ite_eq_right hZ, ite_eq_right hZ']
  by_cases hH : jH T T' ≠ 0
  · rw [ite_eq_left hH]
    obtain ⟨hx, hZ3, hl, hX3, hY3⟩ := jadd_affine T T' hZ hZ' hH
    refine Or.inr ⟨hZ3, ?_⟩
    rw [Point.add_of_X_ne hx]
    have hs : (shortCurve A).toAffine.slope (T.X / T.Z ^ 2) (T'.X / T'.Z ^ 2) (T.Y / T.Z ^ 3)
        (T'.Y / T'.Z ^ 3) = (T'.Y / T'.Z ^ 3 - T.Y / T.Z ^ 3) / (T'.X / T'.Z ^ 2 - T.X / T.Z ^ 2) := by
      rw [slope_of_X_ne hx, div_eq_div_iff (sub_ne_zero.mpr hx) (sub_ne_zero.mpr (Ne.symm hx))]
      ring
    apply some_eq_some_of
    · rw [hX3, addX, hs]; simp
    · rw [hY3, addY, negAddY, addX, hs, shortCurve_negY, hX3]; simp; ring
  · rw [ite_eq_right hH]
    push Not at hH
    have hx := (jH_eq_zero_iff T T' hZ hZ').mp hH
    by_cases hΛ : jΛ T T' = 0
    · rw [ite_eq_left hΛ]
      have hy := (jΛ_eq_zero_iff T T' hZ hZ').mp hΛ
      have hPQ : Point.some _ _ hns' = Point.some _ _ hns := by
        obtain ⟨h'', e⟩ := some_eq_some_of hns' hx.symm hy.symm
        exact e
      rw [hPQ]
      exact rep_jdblB (Or.inr ⟨hZ, hns, rfl⟩)
    · rw [ite_eq_right hΛ]
      have hy := (jΛ_eq_zero_iff T T' hZ hZ').not.mp hΛ
      have hy' := (Y_eq_of_X_eq hns.1 hns'.1 hx).resolve_left hy
      rw [Point.add_of_Y_eq hx hy']
      exact rep_jO A

end Field

end JTriple

end ZInQ.Compiler.Precision
