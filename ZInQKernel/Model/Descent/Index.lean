import ZInQKernel.Model.Descent.SecondImage

/-!
# The descent index `[E(K₀) : 2E(K₀)] = 8`

Blueprint: `model/descent/descent-index.md`.

The direct route of the article: the second descent image is trivial, so the kernel theorem
for `φ = φ_{-d²} : E → E'` gives `φ(E(K₀)) = E'(K₀)`; the kernel theorem for
`φ_{4d²} : E' → E_{-16d²}`, transported by the rescaling `λ_{-d²}`, gives
`ker α = λ(φ_{4d²}(E'(K₀)))`; and `λ ∘ φ_{4d²} ∘ φ = [2]`. Hence `2E(K₀) = ker α`, and
`E(K₀)/2E(K₀) ≅ α(E(K₀))`, of order eight by the first descent image.
-/

namespace ZInQ

open QuadraticAlgebra K0 Descent WeierstrassCurve WeierstrassCurve.Affine

instance shortCurve_neg_sixteen_genD_sq_isElliptic : (shortCurve (-16 * genD ^ 2)).IsElliptic :=
  shortCurve_isElliptic (mul_ne_zero (by norm_num) (pow_ne_zero 2 genD_ne_zero))

theorem four_genD_sq_eq : 4 * genD ^ 2 = -4 * -genD ^ 2 := by ring
theorem neg_sixteen_genD_sq_eq : -16 * genD ^ 2 = -4 * (4 * genD ^ 2) := by ring
theorem neg_sixteen_genD_sq_eq' : -16 * genD ^ 2 = 16 * -genD ^ 2 := by ring

/-- The two-isogeny `φ : E → E'`. -/
noncomputable abbrev phiE : (shortCurve (-genD ^ 2)).toAffine.Point →
    (shortCurve (4 * genD ^ 2)).toAffine.Point :=
  phi four_genD_sq_eq

/-- The dual isogeny `φ̂ = λ_{-d²} ∘ φ_{4d²} : E' → E`. -/
noncomputable def phiHatE (Q : (shortCurve (4 * genD ^ 2)).toAffine.Point) :
    (shortCurve (-genD ^ 2)).toAffine.Point :=
  rescale neg_sixteen_genD_sq_eq' (phi neg_sixteen_genD_sq_eq Q)

/-- `φ̂ ∘ φ = [2]` on `E(K₀)`. -/
theorem phiHatE_phiE (P : (shortCurve (-genD ^ 2)).toAffine.Point) :
    phiHatE (phiE P) = 2 • P :=
  rescale_phi_phi four_genD_sq_eq neg_sixteen_genD_sq_eq P

/-- `φ(E(K₀)) = E'(K₀)`. -/
theorem phiE_surjective : Function.Surjective phiE := fun Q =>
  (kummer_eq_one_iff four_genD_sq_eq Q).mp (kummer_E'_trivial Q)

/-- `ker α = φ̂(E'(K₀))`. -/
theorem kummer_eq_one_iff_mem_range_phiHatE (P : (shortCurve (-genD ^ 2)).toAffine.Point) :
    kummer (-genD ^ 2) P = 1 ↔ P ∈ Set.range phiHatE := by
  rw [← (rescale neg_sixteen_genD_sq_eq').apply_symm_apply P, kummer_rescale,
    kummer_eq_one_iff neg_sixteen_genD_sq_eq]
  constructor
  · rintro ⟨Q, hQ⟩
    exact ⟨Q, by rw [phiHatE, hQ]⟩
  · rintro ⟨Q, hQ⟩
    refine ⟨Q, ?_⟩
    rw [phiHatE] at hQ
    exact (rescale neg_sixteen_genD_sq_eq').injective hQ

/-- `2E(K₀)` is the kernel of the Kummer map: `P ∈ 2E(K₀) ↔ α(P) = 1`. -/
theorem mem_two_smul_iff_kummer_eq_one (P : (shortCurve (-genD ^ 2)).toAffine.Point) :
    (∃ Q, 2 • Q = P) ↔ kummer (-genD ^ 2) P = 1 := by
  constructor
  · rintro ⟨Q, rfl⟩
    exact kummer_two_nsmul Q
  · intro h
    obtain ⟨Q', rfl⟩ := (kummer_eq_one_iff_mem_range_phiHatE P).mp h
    obtain ⟨Q, rfl⟩ := phiE_surjective Q'
    exact ⟨Q, (phiHatE_phiE Q).symm⟩

/-- `2E(K₀) = ker α` as subgroups. -/
theorem two_smul_range_eq_ker :
    (nsmulAddMonoidHom (α := (shortCurve (-genD ^ 2)).toAffine.Point) 2).range =
      (kummerHom (b := -genD ^ 2)).ker := by
  ext P
  rw [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
  exact mem_two_smul_iff_kummer_eq_one P

/-- **The descent index**: `[E(K₀) : 2E(K₀)] = 8`. -/
theorem index_two_E :
    (nsmulAddMonoidHom (α := (shortCurve (-genD ^ 2)).toAffine.Point) 2).range.index = 8 := by
  rw [two_smul_range_eq_ker, AddSubgroup.index_eq_card,
    Nat.card_congr (QuotientAddGroup.quotientKerEquivRange _).toEquiv, ← card_kummer_range_E]
  rfl

/-- `α` induces an isomorphism of `E(K₀)/2E(K₀)` onto the subgroup generated by `-1`, `ε`,
`d`. -/
theorem kummer_range_eq_descentGroup :
    (kummerHom (b := -genD ^ 2)).range = descentGroup.toAddSubgroup := by
  ext c
  rw [AddMonoidHom.mem_range]
  change c ∈ Set.range (kummer (-genD ^ 2)) ↔ Additive.toMul c ∈ (descentGroup : Set (SqClass K0))
  rw [kummer_range_E]
  rfl

/-- The descent index for `E = genCurve`. -/
theorem index_two_genCurve :
    (nsmulAddMonoidHom (α := genCurve.toAffine.Point) 2).range.index = 8 :=
  index_two_E

instance finiteIndex_two_E :
    (nsmulAddMonoidHom (α := (shortCurve (-genD ^ 2)).toAffine.Point) 2).range.FiniteIndex :=
  ⟨by rw [index_two_E]; norm_num⟩

end ZInQ
