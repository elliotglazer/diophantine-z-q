import ZInQKernel.Model.Descent.Factor

/-!
# The first descent image

Blueprint: `model/descent/first-descent-image.md`.

The Kummer map `α = α_{-d²}` of `E = genCurve = shortCurve (-d²)` has image the subgroup
`descentGroup` of `K₀ˣ/K₀ˣ²` generated by the classes of `-1`, `ε = 1 + s` and `d`, which has
order eight. The two-torsion points give `α(O) = 1`, `α((0,0)) = -d² ≡ -1`, `α((d,0)) = d`,
`α((-d,0)) = -d`, and `θ⁻¹(R)` has class `ε`.

The order is computed with the invariant `sqcInvariant : K₀ˣ/K₀ˣ² →* (ℤ/2) × signs`,
`x ↦ (v_d(x) mod 2, sign vector of x)`, which separates the eight classes.
-/

namespace ZInQ

open QuadraticAlgebra K0 Descent WeierstrassCurve WeierstrassCurve.Affine

/-! ### Lifting to square classes -/

namespace Descent

variable {K : Type*} [Field K] {M : Type*} [CommMonoid M]

/-- A homomorphism on `Kˣ` that kills squares descends to `Kˣ/Kˣ²`. -/
def SqClass.lift (φ : Kˣ →* M) (h : ∀ u, φ (u ^ 2) = 1) : SqClass K →* M :=
  QuotientGroup.lift _ φ (by
    rintro _ ⟨u, rfl⟩
    exact h u)

@[simp] theorem SqClass.lift_mk (φ : Kˣ →* M) (h : ∀ u, φ (u ^ 2) = 1) (u : Kˣ) :
    SqClass.lift φ h (SqClass.mk u) = φ u := rfl

theorem SqClass.lift_sqc (φ : Kˣ →* M) (h : ∀ u, φ (u ^ 2) = 1) {x : K} (hx : x ≠ 0) :
    SqClass.lift φ h (sqc x) = φ (Units.mk0 x hx) := by
  rw [sqc_of_ne_zero hx, SqClass.lift_mk]

end Descent

/-! ### The invariant `(v_d mod 2, sign vector)` -/

theorem signVector_mul (x y : K0) : signVector (x * y) = signVector x * signVector y := by
  simp [signVector, sign_mul]

/-- `u ↦ (v_d(u) mod 2, sign vector of u)` on `K₀ˣ`. -/
noncomputable def unitInvariant : K0ˣ →* Multiplicative (ZMod 2) × (SignType × SignType) where
  toFun u := (Multiplicative.ofAdd ((vp genDZ (u : K0) : ℤ) : ZMod 2), signVector (u : K0))
  map_one' := by simp [vp_one prime_genDZ, signVector_one]
  map_mul' u v := by
    simp only [Units.val_mul, vp_mul prime_genDZ u.ne_zero v.ne_zero, Int.cast_add, ofAdd_add,
      signVector_mul, Prod.mk_mul_mk]

theorem unitInvariant_sq (u : K0ˣ) : unitInvariant (u ^ 2) = 1 := by
  simp only [unitInvariant, MonoidHom.coe_mk, OneHom.coe_mk, Units.val_pow_eq_pow_val,
    vp_pow prime_genDZ]
  rw [show (u : K0) ^ 2 = 1 * (u : K0) ^ 2 by ring, signVector_mul_sq _ u.ne_zero, signVector_one]
  have : ((((2 : ℕ) : ℤ) * vp genDZ (u : K0) : ℤ) : ZMod 2) = 0 := by
    rw [Int.cast_mul, Int.cast_natCast, Nat.cast_ofNat, show (2 : ZMod 2) = 0 from rfl, zero_mul]
  rw [this]; rfl

/-- The invariant on square classes. -/
noncomputable def sqcInvariant : SqClass K0 →* Multiplicative (ZMod 2) × (SignType × SignType) :=
  SqClass.lift unitInvariant unitInvariant_sq

theorem sqcInvariant_sqc {x : K0} (hx : x ≠ 0) :
    sqcInvariant (sqc x) = (Multiplicative.ofAdd ((vp genDZ x : ℤ) : ZMod 2), signVector x) := by
  rw [sqcInvariant, SqClass.lift_sqc _ _ hx]; rfl

theorem vp_genDZ_epsilon : vp genDZ epsilon = 0 := by
  rw [← toK0_epsUnit]; exact vp_unit prime_genDZ _

theorem vp_genDZ_genD : vp genDZ genD = 1 := by
  rw [← toK0_genDZ]; exact vp_self prime_genDZ

theorem signVector_genD : signVector genD = (1, 1) :=
  totallyPositive_iff_signVector.mp totallyPositive_genD

theorem sqcInvariant_neg_one :
    sqcInvariant (sqc (-1 : K0)) = (Multiplicative.ofAdd 0, (-1, -1)) := by
  rw [sqcInvariant_sqc (by norm_num), vp_neg prime_genDZ, vp_one prime_genDZ, signVector_neg_one]
  rfl

theorem sqcInvariant_epsilon : sqcInvariant (sqc epsilon) = (Multiplicative.ofAdd 0, (1, -1)) := by
  rw [sqcInvariant_sqc epsilon_ne_zero, vp_genDZ_epsilon, signVector_epsilon]; rfl

theorem sqcInvariant_genD : sqcInvariant (sqc genD) = (Multiplicative.ofAdd 1, (1, 1)) := by
  rw [sqcInvariant_sqc genD_ne_zero, vp_genDZ_genD, signVector_genD]; rfl

/-! ### The group generated by `-1`, `ε`, `d` has order eight -/

@[simp] theorem zmod2_val_one : (1 : ZMod 2).val = 1 := rfl

theorem SqClass.pow_eq_pow_mod {K : Type*} [Field K] (g : SqClass K) (n : ℕ) :
    g ^ n = g ^ (n % 2) := by
  conv_lhs => rw [← Nat.div_add_mod n 2, pow_add, pow_mul, SqClass.pow_two, one_pow, one_mul]

/-- `(a, b, c) ↦ (-1)ᵃ εᵇ dᶜ` on `(ℤ/2)³`. -/
noncomputable def descentParam : Multiplicative (ZMod 2 × ZMod 2 × ZMod 2) →* SqClass K0 where
  toFun v := sqc (-1 : K0) ^ (Multiplicative.toAdd v).1.val *
    sqc epsilon ^ (Multiplicative.toAdd v).2.1.val * sqc genD ^ (Multiplicative.toAdd v).2.2.val
  map_one' := by simp
  map_mul' v w := by
    simp only [toAdd_mul, Prod.fst_add, Prod.snd_add, ZMod.val_add]
    rw [← SqClass.pow_eq_pow_mod, ← SqClass.pow_eq_pow_mod, ← SqClass.pow_eq_pow_mod,
      pow_add, pow_add, pow_add]
    ac_rfl

theorem sqcInvariant_descentParam (v : Multiplicative (ZMod 2 × ZMod 2 × ZMod 2)) :
    sqcInvariant (descentParam v) =
      (Multiplicative.ofAdd 0, ((-1 : SignType), (-1 : SignType))) ^ (Multiplicative.toAdd v).1.val *
      (Multiplicative.ofAdd 0, ((1 : SignType), (-1 : SignType))) ^ (Multiplicative.toAdd v).2.1.val *
      (Multiplicative.ofAdd 1, ((1 : SignType), (1 : SignType))) ^ (Multiplicative.toAdd v).2.2.val := by
  simp only [descentParam, MonoidHom.coe_mk, OneHom.coe_mk, map_mul, map_pow, sqcInvariant_neg_one,
    sqcInvariant_epsilon, sqcInvariant_genD]

theorem invariant_table_injective : ∀ v w : ZMod 2 × ZMod 2 × ZMod 2,
    ((Multiplicative.ofAdd (0 : ZMod 2), ((-1 : SignType), (-1 : SignType))) ^ v.1.val *
      (Multiplicative.ofAdd (0 : ZMod 2), ((1 : SignType), (-1 : SignType))) ^ v.2.1.val *
      (Multiplicative.ofAdd (1 : ZMod 2), ((1 : SignType), (1 : SignType))) ^ v.2.2.val) =
    ((Multiplicative.ofAdd (0 : ZMod 2), ((-1 : SignType), (-1 : SignType))) ^ w.1.val *
      (Multiplicative.ofAdd (0 : ZMod 2), ((1 : SignType), (-1 : SignType))) ^ w.2.1.val *
      (Multiplicative.ofAdd (1 : ZMod 2), ((1 : SignType), (1 : SignType))) ^ w.2.2.val) →
    v = w := by
  decide

theorem descentParam_injective : Function.Injective descentParam := by
  intro v w h
  have := congrArg sqcInvariant h
  rw [sqcInvariant_descentParam, sqcInvariant_descentParam] at this
  exact invariant_table_injective (Multiplicative.toAdd v) (Multiplicative.toAdd w) this

theorem descentParam_range : descentParam.range = descentGroup := by
  apply le_antisymm
  · rintro _ ⟨v, rfl⟩
    exact mul_mem (mul_mem (pow_mem sqc_neg_one_mem _) (pow_mem sqc_epsilon_mem _))
      (pow_mem sqc_genD_mem _)
  · rw [descentGroup, Subgroup.closure_le]
    rintro _ (rfl | rfl | rfl)
    · exact ⟨Multiplicative.ofAdd (1, 0, 0), by simp [descentParam]⟩
    · exact ⟨Multiplicative.ofAdd (0, 1, 0), by simp [descentParam]⟩
    · exact ⟨Multiplicative.ofAdd (0, 0, 1), by simp [descentParam]⟩

/-- The subgroup generated by the classes of `-1`, `ε`, `d` has order eight. -/
theorem card_descentGroup : Nat.card descentGroup = 8 := by
  rw [← descentParam_range, ← Nat.card_congr (MonoidHom.ofInjective descentParam_injective).toEquiv]
  simp [Nat.card_eq_fintype_card]

instance : Finite descentGroup :=
  Nat.finite_of_card_ne_zero (by rw [card_descentGroup]; norm_num)

/-- The eight classes `±1, ±ε, ±d, ±εd` are pairwise distinct. -/
theorem descentGroup_eq :
    (descentGroup : Set (SqClass K0)) = {1, sqc (-1), sqc epsilon, sqc (-epsilon), sqc genD,
      sqc (-genD), sqc (epsilon * genD), sqc (-(epsilon * genD))} := by
  rw [← descentParam_range]
  have hm1 : (-1 : K0) ≠ 0 := by norm_num
  have e1 : sqc (-epsilon) = sqc (-1 : K0) * sqc epsilon := by
    rw [← sqc_mul hm1 epsilon_ne_zero]; ring_nf
  have e2 : sqc (-genD) = sqc (-1 : K0) * sqc genD := by
    rw [← sqc_mul hm1 genD_ne_zero]; ring_nf
  have e3 : sqc (epsilon * genD) = sqc epsilon * sqc genD := sqc_mul epsilon_ne_zero genD_ne_zero
  have e4 : sqc (-(epsilon * genD)) = sqc (-1 : K0) * sqc epsilon * sqc genD := by
    rw [← sqc_mul hm1 epsilon_ne_zero, ← sqc_mul (mul_ne_zero hm1 epsilon_ne_zero) genD_ne_zero]
    ring_nf
  rw [e1, e2, e3, e4]
  ext c
  simp only [MonoidHom.coe_range, Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨v, rfl⟩
    obtain ⟨⟨a, b, c⟩, rfl⟩ : ∃ w, v = Multiplicative.ofAdd w := ⟨Multiplicative.toAdd v, rfl⟩
    simp only [descentParam, MonoidHom.coe_mk, OneHom.coe_mk, toAdd_ofAdd]
    have ha : a.val = 0 ∨ a.val = 1 := by have := ZMod.val_lt a; omega
    have hb : b.val = 0 ∨ b.val = 1 := by have := ZMod.val_lt b; omega
    have hc : c.val = 0 ∨ c.val = 1 := by have := ZMod.val_lt c; omega
    rcases ha with ha | ha <;> rcases hb with hb | hb <;> rcases hc with hc | hc <;>
      simp [ha, hb, hc]
  · rintro (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl)
    · exact ⟨Multiplicative.ofAdd (0, 0, 0), by simp [descentParam]⟩
    · exact ⟨Multiplicative.ofAdd (1, 0, 0), by simp [descentParam]⟩
    · exact ⟨Multiplicative.ofAdd (0, 1, 0), by simp [descentParam]⟩
    · exact ⟨Multiplicative.ofAdd (1, 1, 0), by simp [descentParam]⟩
    · exact ⟨Multiplicative.ofAdd (0, 0, 1), by simp [descentParam]⟩
    · exact ⟨Multiplicative.ofAdd (1, 0, 1), by simp [descentParam]⟩
    · exact ⟨Multiplicative.ofAdd (0, 1, 1), by simp [descentParam, mul_assoc]⟩
    · exact ⟨Multiplicative.ofAdd (1, 1, 1), by simp [descentParam]⟩

/-! ### The image of the Kummer map of `E` -/

/-- The Kummer map of `E` as a monoid homomorphism. -/
noncomputable def kummerE : Multiplicative (shortCurve (-genD ^ 2)).toAffine.Point →* SqClass K0 where
  toFun P := kummer (-genD ^ 2) (Multiplicative.toAdd P)
  map_one' := rfl
  map_mul' P Q := kummer_add (Multiplicative.toAdd P) (Multiplicative.toAdd Q)

theorem kummer_genT0 : kummer (-genD ^ 2) genT0 = sqc (-1 : K0) :=
  (kummer_some_zero (-genD ^ 2) _).trans (by
    rw [show -genD ^ 2 = -1 * genD ^ 2 by ring, sqc_mul_sq _ genD_ne_zero])

theorem kummer_genTd : kummer (-genD ^ 2) genTd = sqc genD :=
  kummer_some_of_ne (-genD ^ 2) _ genD_ne_zero

theorem kummer_genTnegd : kummer (-genD ^ 2) genTnegd = sqc (-genD) :=
  kummer_some_of_ne (-genD ^ 2) _ (neg_ne_zero.mpr genD_ne_zero)

theorem kummer_theta_symm_pointR : kummer (-genD ^ 2) (theta.symm pointR) = sqc epsilon := by
  have hx : epsilon⁻¹ ^ 4 * epsilon = epsilon * (epsilon⁻¹ ^ 2) ^ 2 := by ring
  have hx0 : epsilon⁻¹ ^ 4 * epsilon ≠ 0 := by
    rw [hx]
    exact mul_ne_zero epsilon_ne_zero (pow_ne_zero _ (pow_ne_zero _ (inv_ne_zero epsilon_ne_zero)))
  have e := theta_symm_some (equation_iff_nonsingular.mp pointR_equation)
  refine (congrArg (kummer (-genD ^ 2)) e).trans ((kummer_some_of_ne (-genD ^ 2) _ hx0).trans ?_)
  rw [hx, sqc_mul_sq _ (pow_ne_zero _ (inv_ne_zero epsilon_ne_zero))]

/-- The Kummer clause of `model/descent/coordinate-change.md`:
`α_{-δ²}(θ(P)) = α_{-d²}(P)`. -/
theorem kummer_theta (P : genCurve.toAffine.Point) :
    kummer (-delta ^ 2) (theta P) = kummer (-genD ^ 2) P :=
  kummer_scaleEquiv (A := -genD ^ 2) (B := -delta ^ 2) epsilon_sq_ne_zero neg_delta_sq_eq P

/-- Even valuations of abscissas on `E` away from `d`. -/
theorem even_vp_x_E {x y : K0} (hx : x ≠ 0) (h : y ^ 2 = x ^ 3 + -genD ^ 2 * x) {π : Zs}
    (hπ : Prime π) (hπd : ¬Associated π genDZ) : Even (vp π x) := by
  have hd : vp π genD = 0 := by
    rw [← toK0_genDZ]; exact vp_prime_eq_zero hπ prime_genDZ hπd
  have hB : vp π (-genD ^ 2) = 0 := by rw [vp_neg hπ, vp_pow hπ, hd, mul_zero]
  rcases even_vp_or_of_curve hπ hx (neg_ne_zero.mpr (pow_ne_zero 2 genD_ne_zero)) h
    (by rw [hB]; exact ⟨0, rfl⟩) with h1 | h1
  · exact h1
  · rw [hB] at h1; exact ⟨0, by omega⟩

/-- **The first descent image**: the image of the Kummer map `α_{-d²}` of `E` is the subgroup
generated by the classes of `-1`, `ε` and `d`. -/
theorem kummer_range_E :
    Set.range (kummer (-genD ^ 2)) = descentGroup := by
  apply Set.Subset.antisymm
  · rintro _ ⟨P, rfl⟩
    rcases P with _ | ⟨x, y, h⟩
    · exact one_mem _
    by_cases hx : x = 0
    · subst hx
      rw [kummer_some_zero, show -genD ^ 2 = -1 * genD ^ 2 by ring, sqc_mul_sq _ genD_ne_zero]
      exact sqc_neg_one_mem
    · rw [kummer_some_of_ne _ _ hx]
      have he := (shortCurve_equation_iff _ x y).mp h.1
      exact sqc_mem_closure_of_even hx fun π hπ hπd => even_vp_x_E hx he hπ hπd
  · have : descentGroup ≤ kummerE.range := by
      rw [descentGroup, Subgroup.closure_le]
      rintro _ (rfl | rfl | rfl)
      · exact ⟨Multiplicative.ofAdd genT0, kummer_genT0⟩
      · exact ⟨Multiplicative.ofAdd (theta.symm pointR), kummer_theta_symm_pointR⟩
      · exact ⟨Multiplicative.ofAdd genTd, kummer_genTd⟩
    intro c hc
    obtain ⟨P, hP⟩ := this hc
    exact ⟨Multiplicative.toAdd P, hP⟩

/-- The first descent image has order eight. -/
theorem card_kummer_range_E :
    Nat.card (Set.range (kummer (-genD ^ 2))) = 8 := by
  rw [kummer_range_E]; exact card_descentGroup

end ZInQ
