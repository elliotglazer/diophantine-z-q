import ZInQKernel.Model.Field
import ZInQKernel.Model.Descent.Kummer

/-!
# Unique factorization and valuations on the curves `y² = x³ + B x` over `K₀`

Helpers for the two descent images (`model/descent/first-descent-image.md`,
`model/descent/second-descent-image.md`):

* `eq_unit_mul_genD_pow_mul_sq`: an element `x ∈ K₀ˣ` whose valuations `v_π(x)` are even at
  every prime `π` not associate to `d` is `u dᵉ z²` with `u` a unit of `ℤ[s]` and `e ∈ {0, 1}`;
* `sqc_mem_closure_of_even`: its square class lies in the subgroup generated by the classes
  of `-1`, `ε`, `d`;
* `even_vp_or_of_curve`: on `y² = x³ + B x`, if `v_π(B)` is even, then `v_π(x)` is even or
  `2 v_π(x) = v_π(B)`;
* `vp_sq_add_four_eq_zero`: if `v_d(w) = 0` then `v_d(w² + 4) = 0` (since `-1` is not a square
  modulo `d`).
-/

namespace ZInQ

open QuadraticAlgebra K0 Descent

theorem Zs.natAbs_norm_lt_of_not_isUnit {π c : Zs} (hπ0 : π ≠ 0) (hπ : ¬IsUnit π) (hc : c ≠ 0) :
    (QuadraticAlgebra.norm c).natAbs < (QuadraticAlgebra.norm (π * c)).natAbs := by
  rw [map_mul, Int.natAbs_mul]
  have h1 : (QuadraticAlgebra.norm π).natAbs ≠ 1 := fun h => hπ (Zs.isUnit_iff_natAbs_norm.mpr h)
  have h1' : (QuadraticAlgebra.norm π).natAbs ≠ 0 := Int.natAbs_ne_zero.mpr (Zs.norm_ne_zero hπ0)
  have h2 : 0 < (QuadraticAlgebra.norm c).natAbs := Int.natAbs_pos.mpr (Zs.norm_ne_zero hc)
  have : 2 ≤ (QuadraticAlgebra.norm π).natAbs := by omega
  nlinarith

/-- A prime `π` has valuation zero at a non-associate prime `ρ`. -/
theorem vp_prime_eq_zero {ρ π : Zs} (hρ : Prime ρ) (hπ : Prime π) (h : ¬Associated ρ π) :
    vp ρ (Zs.toK0 π) = 0 :=
  (vp_eq_zero_iff hρ hπ.ne_zero).mpr fun hd => h (hρ.associated_of_dvd hπ hd)

/-- In `ℤ[s]`: if `v_π(c)` is even for every prime `π` not associate to `d`, then
`c = u dᵉ z²` with `u` a unit and `e < 2`. -/
theorem Zs.eq_unit_mul_genD_pow_mul_sq (c : Zs) (hc : c ≠ 0)
    (h : ∀ π : Zs, Prime π → ¬Associated π genDZ → Even (vp π (Zs.toK0 c))) :
    ∃ (u : Zsˣ) (e : ℕ) (z : Zs), e < 2 ∧ z ≠ 0 ∧ c = u * genDZ ^ e * z ^ 2 := by
  induction hn : (QuadraticAlgebra.norm c).natAbs using Nat.strong_induction_on generalizing c with
  | _ n ih =>
  by_cases hu : IsUnit c
  · obtain ⟨u, rfl⟩ := hu
    exact ⟨u, 0, 1, by norm_num, one_ne_zero, by simp⟩
  obtain ⟨π, hπi, hπc⟩ := WfDvdMonoid.exists_irreducible_factor hu hc
  have hπ : Prime π := hπi.prime
  obtain ⟨c', rfl⟩ := hπc
  have hc' : c' ≠ 0 := right_ne_zero_of_mul hc
  by_cases hd : Associated π genDZ
  · have hlt : (QuadraticAlgebra.norm c').natAbs < n :=
      hn ▸ Zs.natAbs_norm_lt_of_not_isUnit hπ.ne_zero hπ.not_isUnit hc'
    obtain ⟨u, e, z, he, hz, rfl⟩ := ih _ hlt c' hc' (fun ρ hρ hρd => by
      have h1 := h ρ hρ hρd
      rwa [map_mul, vp_mul hρ (toK0_ne_zero hπ.ne_zero) (toK0_ne_zero hc'),
        vp_prime_eq_zero hρ hπ (fun h' => hρd (h'.trans hd)), zero_add] at h1) rfl
    obtain ⟨v, hv⟩ := hd
    have hπ' : π = genDZ * ↑v⁻¹ := by rw [← hv, mul_assoc, Units.mul_inv, mul_one]
    interval_cases e
    · exact ⟨v⁻¹ * u, 1, z, by norm_num, hz, by rw [hπ']; push_cast; ring⟩
    · exact ⟨v⁻¹ * u, 0, genDZ * z, by norm_num, mul_ne_zero prime_genDZ.ne_zero hz,
        by rw [hπ']; push_cast; ring⟩
  · have h1 : Even (vp π (Zs.toK0 (π * c'))) := h π hπ hd
    have hpos : 0 < vp π (Zs.toK0 (π * c')) := (vp_pos_iff hπ hc).mpr (dvd_mul_right _ _)
    have h2 : ((2 : ℕ) : ℤ) ≤ vp π (Zs.toK0 (π * c')) := by
      obtain ⟨k, hk⟩ := h1; rw [hk] at hpos ⊢; push_cast; omega
    obtain ⟨c'', hc''⟩ := (le_vp_iff_pow_dvd hπ hc 2).mp h2
    have hc''0 : c'' ≠ 0 := by rintro rfl; rw [mul_zero] at hc''; exact hc hc''
    have hlt : (QuadraticAlgebra.norm c'').natAbs < n := by
      rw [← hn, hc'', pow_two, mul_assoc]
      exact lt_trans (Zs.natAbs_norm_lt_of_not_isUnit hπ.ne_zero hπ.not_isUnit hc''0)
        (Zs.natAbs_norm_lt_of_not_isUnit hπ.ne_zero hπ.not_isUnit (mul_ne_zero hπ.ne_zero hc''0))
    obtain ⟨u, e, z, he, hz, hcz⟩ := ih _ hlt c'' hc''0 (fun ρ hρ hρd => by
      have h3 := h ρ hρ hρd
      rw [hc'', map_mul, map_pow, vp_mul hρ (pow_ne_zero 2 (toK0_ne_zero hπ.ne_zero))
        (toK0_ne_zero hc''0), vp_pow hρ] at h3
      obtain ⟨k, hk⟩ := h3
      exact ⟨k - vp ρ (Zs.toK0 π), by push_cast at hk; linarith⟩) rfl
    exact ⟨u, e, π * z, he, mul_ne_zero hπ.ne_zero hz, by rw [hc'', hcz]; ring⟩

/-- In `K₀`: if `v_π(x)` is even for every prime `π` not associate to `d`, then
`x = u dᵉ z²` with `u ∈ ℤ[s]ˣ`, `e < 2` and `z ≠ 0`. -/
theorem eq_unit_mul_genD_pow_mul_sq {x : K0} (hx : x ≠ 0)
    (h : ∀ π : Zs, Prime π → ¬Associated π genDZ → Even (vp π x)) :
    ∃ (u : Zsˣ) (e : ℕ) (z : K0), e < 2 ∧ z ≠ 0 ∧ x = Zs.toK0 u * genD ^ e * z ^ 2 := by
  obtain ⟨a, b, hb, rfl⟩ := exists_eq_div_Zs x
  have ha : a ≠ 0 := by rintro rfl; simp at hx
  have ha' := toK0_ne_zero ha
  have hb' := toK0_ne_zero hb
  obtain ⟨u, e, z, he, hz, hc⟩ := Zs.eq_unit_mul_genD_pow_mul_sq (a * b) (mul_ne_zero ha hb)
    (fun π hπ hπd => by
      obtain ⟨k, hk⟩ := h π hπ hπd
      rw [vp_div hπ ha' hb'] at hk
      rw [map_mul, vp_mul hπ ha' hb']
      exact ⟨k + vp π (Zs.toK0 b), by linarith⟩)
  refine ⟨u, e, Zs.toK0 z / Zs.toK0 b, he, div_ne_zero (toK0_ne_zero hz) hb', ?_⟩
  have := congrArg Zs.toK0 hc
  rw [map_mul, map_mul, map_mul, map_pow, map_pow, toK0_genDZ] at this
  field_simp
  rw [← this]

/-! ### Square classes in `K₀` -/

/-- The subgroup of `K₀ˣ/K₀ˣ²` generated by the classes of `-1`, `ε` and `d`. -/
noncomputable def descentGroup : Subgroup (SqClass K0) :=
  Subgroup.closure {sqc (-1 : K0), sqc epsilon, sqc genD}

theorem sqc_neg_one_mem : sqc (-1 : K0) ∈ descentGroup := Subgroup.subset_closure (by simp)
theorem sqc_epsilon_mem : sqc epsilon ∈ descentGroup := Subgroup.subset_closure (by simp)
theorem sqc_genD_mem : sqc genD ∈ descentGroup := Subgroup.subset_closure (by simp)

theorem sqc_pow {K : Type*} [Field K] (x : K) (n : ℕ) : sqc (x ^ n) = sqc x ^ n := by
  by_cases hx : x = 0
  · subst hx
    rcases n with _ | n
    · simp
    · simp
  induction n with
  | zero => simp
  | succ n ih => rw [pow_succ, sqc_mul (pow_ne_zero _ hx) hx, ih, pow_succ]

/-- The class of a unit of `ℤ[s]` is that of `1`, `-1`, `ε` or `-ε`. -/
theorem sqc_unit_mem (u : Zsˣ) : sqc (Zs.toK0 u) ∈ descentGroup := by
  obtain ⟨w, h | h | h | h⟩ := Zs_unit_sqClass u <;> rw [h]
  · simp only [Units.val_pow_eq_pow_val, map_pow, sqc_sq]; exact one_mem _
  · rw [Units.val_neg, Units.val_pow_eq_pow_val, map_neg, map_pow, neg_eq_neg_one_mul,
      sqc_mul_sq _ (toK0_ne_zero w.ne_zero)]
    exact sqc_neg_one_mem
  · rw [Units.val_mul, Units.val_pow_eq_pow_val, map_mul, map_pow,
      sqc_mul_sq _ (toK0_ne_zero w.ne_zero), toK0_epsUnit]
    exact sqc_epsilon_mem
  · rw [Units.val_neg, Units.val_mul, Units.val_pow_eq_pow_val, map_neg, map_mul, map_pow,
      toK0_epsUnit, neg_eq_neg_one_mul, ← mul_assoc, sqc_mul_sq _ (toK0_ne_zero w.ne_zero),
      sqc_mul (by norm_num) epsilon_ne_zero]
    exact mul_mem sqc_neg_one_mem sqc_epsilon_mem

theorem sqc_mem_closure_of_even {x : K0} (hx : x ≠ 0)
    (h : ∀ π : Zs, Prime π → ¬Associated π genDZ → Even (vp π x)) :
    sqc x ∈ descentGroup := by
  obtain ⟨u, e, z, -, hz, rfl⟩ := eq_unit_mul_genD_pow_mul_sq hx h
  rw [sqc_mul_sq _ hz, sqc_mul (toK0_ne_zero u.ne_zero) (pow_ne_zero _ genD_ne_zero), sqc_pow]
  exact mul_mem (sqc_unit_mem u) (pow_mem sqc_genD_mem _)

/-! ### Valuations on `y² = x³ + B x` -/

/-- On `y² = x³ + B x` with `x, B ≠ 0`: if `v_π(B)` is even, then `v_π(x)` is even or
`2 v_π(x) = v_π(B)`. -/
theorem even_vp_or_of_curve {π : Zs} (hπ : Prime π) {x y B : K0} (hx : x ≠ 0) (hB : B ≠ 0)
    (h : y ^ 2 = x ^ 3 + B * x) (hk : Even (vp π B)) :
    Even (vp π x) ∨ 2 * vp π x = vp π B := by
  by_contra hcon
  push Not at hcon
  obtain ⟨hodd, hne⟩ := hcon
  rw [Int.not_even_iff_odd] at hodd
  have hx3 : x ^ 3 ≠ 0 := pow_ne_zero 3 hx
  have hBx : B * x ≠ 0 := mul_ne_zero hB hx
  have hv3 : vp π (x ^ 3) = 3 * vp π x := by rw [vp_pow hπ]; norm_num
  have hvB : vp π (B * x) = vp π B + vp π x := vp_mul hπ hB hx
  have hdiff : vp π (x ^ 3) ≠ vp π (B * x) := by rw [hv3, hvB]; omega
  have hsum : x ^ 3 + B * x ≠ 0 := by
    intro h0
    apply hdiff
    rw [show x ^ 3 = -(B * x) by linear_combination h0, vp_neg hπ]
  have hy : y ≠ 0 := by rintro rfl; apply hsum; rw [← h]; ring
  have hmin := vp_add_eq_min_of_ne hπ hx3 hBx hdiff
  rw [← h, vp_pow hπ, hv3, hvB] at hmin
  obtain ⟨k, hk⟩ := hk
  obtain ⟨m, hm⟩ := hodd
  rcases min_choice (3 * vp π x) (vp π B + vp π x) with h' | h' <;> rw [h'] at hmin <;>
    push_cast at hmin <;> omega

/-! ### Elements prime to `d` -/

/-- An element of `K₀ˣ` with `v_π = 0` is a quotient of two elements of `ℤ[s]` prime to `π`. -/
theorem exists_eq_div_of_vp_eq_zero {π : Zs} (hπ : Prime π) {z : K0} (hz : z ≠ 0)
    (h : vp π z = 0) : ∃ a b : Zs, ¬π ∣ a ∧ ¬π ∣ b ∧ z = Zs.toK0 a / Zs.toK0 b := by
  obtain ⟨a, b, hb, rfl⟩ := exists_eq_div_Zs z
  have ha : a ≠ 0 := by rintro rfl; simp at hz
  obtain ⟨i, a', ha', rfl⟩ := WfDvdMonoid.max_power_factor ha hπ.irreducible
  obtain ⟨j, b', hb', rfl⟩ := WfDvdMonoid.max_power_factor hb hπ.irreducible
  have ha0 : a' ≠ 0 := right_ne_zero_of_mul ha
  have hb0 : b' ≠ 0 := right_ne_zero_of_mul hb
  have hπ0 := toK0_ne_zero hπ.ne_zero
  simp only [map_mul, map_pow] at h ⊢
  rw [vp_div hπ (mul_ne_zero (pow_ne_zero _ hπ0) (toK0_ne_zero ha0))
    (mul_ne_zero (pow_ne_zero _ hπ0) (toK0_ne_zero hb0)),
    vp_mul hπ (pow_ne_zero _ hπ0) (toK0_ne_zero ha0),
    vp_mul hπ (pow_ne_zero _ hπ0) (toK0_ne_zero hb0), vp_pow hπ, vp_pow hπ, vp_self hπ,
    (vp_eq_zero_iff hπ ha0).mpr ha', (vp_eq_zero_iff hπ hb0).mpr hb'] at h
  have hij : i = j := by push_cast at h; omega
  subst hij
  refine ⟨a', b', ha', hb', ?_⟩
  rw [mul_div_mul_left _ _ (pow_ne_zero _ hπ0)]

theorem residue_sq_add_four_mul_sq_ne_zero :
    ∀ p q : ZMod 7, q ≠ 0 → p ^ 2 + 4 * q ^ 2 ≠ 0 := by decide

/-- If `v_d(w) = 0` then `v_d(w² + 4) = 0`: otherwise `(w/2)² ≡ -1` modulo `d`. -/
theorem vp_sq_add_four_eq_zero {w : K0} (hw : w ≠ 0) (h : vp genDZ w = 0) :
    vp genDZ (w ^ 2 + 4) = 0 := by
  obtain ⟨a, b, ha, hb, rfl⟩ := exists_eq_div_of_vp_eq_zero prime_genDZ hw h
  have hb0 : b ≠ 0 := by rintro rfl; exact hb (dvd_zero _)
  have hb' := toK0_ne_zero hb0
  have hab : a ^ 2 + 4 * b ^ 2 ≠ 0 := by
    intro h0
    apply residue_sq_add_four_mul_sq_ne_zero (residueSeven a) (residueSeven b)
      (fun h1 => hb ((genDZ_dvd_iff b).mpr h1))
    have := congrArg residueSeven h0
    simpa only [map_add, map_mul, map_pow, map_ofNat, map_zero] using this
  have e : (Zs.toK0 a / Zs.toK0 b) ^ 2 + 4 = Zs.toK0 (a ^ 2 + 4 * b ^ 2) / Zs.toK0 b ^ 2 := by
    simp only [map_add, map_mul, map_pow, map_ofNat]
    field_simp
  rw [e, vp_div prime_genDZ (toK0_ne_zero hab) (pow_ne_zero 2 hb'), vp_pow prime_genDZ,
    (vp_eq_zero_iff prime_genDZ hb0).mpr hb, mul_zero, sub_zero,
    vp_eq_zero_iff prime_genDZ hab, genDZ_dvd_iff]
  intro h0
  apply residue_sq_add_four_mul_sq_ne_zero (residueSeven a) (residueSeven b)
    (fun h1 => hb ((genDZ_dvd_iff b).mpr h1))
  simpa only [map_add, map_mul, map_pow, map_ofNat] using h0

end ZInQ
