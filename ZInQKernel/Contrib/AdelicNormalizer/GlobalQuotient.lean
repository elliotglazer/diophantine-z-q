import ZInQKernel.Contrib.AdelicNormalizer.Adelic
import ZInQKernel.Contrib.AdelicNormalizer.LocalQuotient
import ZInQKernel.Contrib.AdelicNormalizer.RestrictedQuotient

/-!
# The actual adelic normalizer quotient

`N` is the conjugation normalizer in `BAˣ`.  `globalDenom` is generated by the
image of actual finite ideles and `K0`.  Its pointwise description is proved
with scalar witnesses equal to one at all places where the original unit is
integral.  Only then is the restricted-product quotient lemma applied.
-/

open Quaternion
open IsDedekindDomain
open scoped RestrictedProduct Pointwise

namespace G1

noncomputable section

open ZInQ.Contrib.AdelicNormalizer.RestrictedQuotient

abbrev NormalizerRP := Πʳ v : Place, [localNormalizer (primeAt v).1, localH (primeAt v).1]
abbrev LocalQuotientRP := Πʳ v : Place,
  [(localNormalizer (primeAt v).1) ⧸ localS (primeAt v).1,
    (⊥ : Subgroup ((localNormalizer (primeAt v).1) ⧸ localS (primeAt v).1))]

/-- Forget the proof of local normalization but retain the genuine restrictedness condition. -/
def forgetNormalizer (x : NormalizerRP) : UnitRP := ⟨fun v => (x v).val, x.2⟩

/-- The actual normalizer, identified with restricted tuples of local normalizers. -/
def normalizerEquiv : N ≃* NormalizerRP where
  toFun u := ⟨fun v => ⟨unitEval v u.val, (mem_N u.val).1 u.property v⟩,
    (unitEquiv u.val).2⟩
  invFun x := ⟨unitEquiv.symm (forgetNormalizer x), (mem_N _).2 (by
    intro v
    have h := congrArg (fun y : UnitRP => y v)
      (unitEquiv.apply_symm_apply (forgetNormalizer x))
    exact h.symm ▸ (x v).property)⟩
  left_inv u := by
    apply Subtype.ext
    apply unitEquiv.injective
    apply RestrictedProduct.ext
    intro v
    exact congrArg (fun y : UnitRP => y v) (unitEquiv.apply_symm_apply _)
  right_inv x := by
    apply RestrictedProduct.ext
    intro v
    apply Subtype.ext
    exact congrArg (fun y : UnitRP => y v) (unitEquiv.apply_symm_apply _)
  map_mul' u w := by
    apply RestrictedProduct.ext
    intro v
    apply Subtype.ext
    exact map_mul (unitEval v) u.val w.val

@[simp] theorem normalizerEquiv_apply (u : N) (v : Place) :
    (normalizerEquiv u v).val = unitEval v u.val := rfl

/-- Scalar finite ideles are central as actual adelic quaternion units. -/
theorem scalarIdeles_comm (c : Afˣ) (u : BAˣ) :
    scalarIdeles c * u = u * scalarIdeles c := by
  apply Units.ext
  exact Algebra.commutes (c : Af) (u : BA)

instance scalarSubgroup_normal : scalarSubgroup.Normal := by
  apply Subgroup.normal_of_le_center
  rintro _ ⟨c, rfl⟩
  exact Subgroup.mem_center_iff.2 fun u => (scalarIdeles_comm c u).symm

/-- Local scalar maps and the actual finite-idele embedding commute. -/
theorem unitEval_scalar (c : Afˣ) (v : Place) :
    unitEval v (scalarIdeles c) = localScalar (primeAt v).1 (ideleEquiv c v) := by
  apply Units.ext
  change quaternionMap (scalarEval v) (algebraMap Af BA (c : Af)) =
    algebraMap (Qv v) (Bv v) (scalarEval v (c : Af))
  apply QuaternionAlgebra.ext <;> simp [quaternionMap, QuaternionAlgebra.algebraMap_eq]

theorem K0_le_N : K0 ≤ N := by
  intro u hu
  apply (mem_N u).2
  intro v
  exact localOrderUnits_le_normalizer _ ((mem_K0 u).1 hu v)

theorem scalarSubgroup_le_N : scalarSubgroup ≤ N := by
  rintro _ ⟨c, rfl⟩
  apply (mem_N _).2
  intro v
  rw [unitEval_scalar]
  exact localScalar_mem_normalizer _ _

/-- Scalar finite ideles times the actual completed-order units. -/
def globalDenom : Subgroup BAˣ := scalarSubgroup ⊔ K0

theorem globalDenom_le_N : globalDenom ≤ N := sup_le scalarSubgroup_le_N K0_le_N

/-- The product carrier is proved from the central scalar subgroup. -/
theorem mem_globalDenom_factor (u : BAˣ) :
    u ∈ globalDenom ↔ ∃ c : Afˣ, ∃ k : BAˣ, k ∈ K0 ∧ u = scalarIdeles c * k := by
  constructor
  · intro hu
    change u ∈ scalarSubgroup ⊔ K0 at hu
    rw [← SetLike.mem_coe, Subgroup.normal_mul] at hu
    rcases hu with ⟨a, ⟨c, rfl⟩, k, hk, h⟩
    exact ⟨c, k, hk, h.symm⟩
  · rintro ⟨c, k, hk, rfl⟩
    exact globalDenom.mul_mem
      ((le_sup_left : scalarSubgroup ≤ globalDenom) ⟨c, rfl⟩)
      ((le_sup_right : K0 ≤ globalDenom) hk)

/-- Group-valued version of the local scalar factorization. -/
theorem localDenom_factor (p : ℕ) [Fact p.Prime] (x : (Bp p)ˣ) :
    x ∈ localDenom p ↔ ∃ c : ℚ_[p]ˣ, ∃ k : (Bp p)ˣ,
      k ∈ localOrderUnits p ∧ x = localScalar p c * k := by
  rw [mem_localDenom]
  constructor
  · rintro ⟨c, k, hk, h⟩
    refine ⟨c, k, hk, ?_⟩
    apply Units.ext
    simpa [localScalar, Algebra.smul_def] using h
  · rintro ⟨c, k, hk, rfl⟩
    exact ⟨c, k, hk, (Algebra.smul_def (c : ℚ_[p]) (k : Bp p)).symm⟩

/-- Pointwise scalar-times-units membership is equivalent to membership in the
actual global denominator.  The reverse direction constructs finite ideles,
not an unrestricted family of local scalar units. -/
theorem mem_globalDenom (u : BAˣ) :
    u ∈ globalDenom ↔ ∀ v, unitEval v u ∈ localDenom (primeAt v).1 := by
  classical
  constructor
  · intro hu v
    obtain ⟨c, k, hk, rfl⟩ := (mem_globalDenom_factor u).1 hu
    rw [map_mul, unitEval_scalar]
    apply (localDenom_factor _ _).2
    exact ⟨ideleEquiv c v, unitEval v k, (mem_K0 k).1 hk v, rfl⟩
  · intro hu
    have hf : ∀ v, ∃ d : (Qv v)ˣ × (Bv v)ˣ,
        d.2 ∈ localOrderUnits (primeAt v).1 ∧
        unitEval v u = localScalar (primeAt v).1 d.1 * d.2 ∧
        (unitEval v u ∈ localOrderUnits (primeAt v).1 → d.1 = 1) := by
      intro v
      by_cases hv : unitEval v u ∈ localOrderUnits (primeAt v).1
      · exact ⟨(1, unitEval v u), hv, by simp, fun _ => rfl⟩
      · obtain ⟨c, k, hk, h⟩ := (localDenom_factor _ _).1 (hu v)
        exact ⟨(c, k), hk, h, fun h' => False.elim (hv h')⟩
    choose d hd using hf
    let c : IdeleRP := ⟨fun v => (d v).1, by
      filter_upwards [(unitEquiv u).2] with v hv
      change unitEval v u ∈ localOrderUnits (primeAt v).1 at hv
      rw [(hd v).2.2 hv]
      exact Subgroup.one_mem _⟩
    let k : UnitRP := ⟨fun v => (d v).2, Filter.Eventually.of_forall (fun v => (hd v).1)⟩
    refine (mem_globalDenom_factor u).2 ⟨ideleEquiv.symm c, unitEquiv.symm k, ?_, ?_⟩
    · apply (mem_K0 _).2
      intro v
      have h := congrArg (fun y : UnitRP => y v) (unitEquiv.apply_symm_apply k)
      exact h.symm ▸ (hd v).1
    · apply unitEquiv.injective
      apply RestrictedProduct.ext
      intro v
      change unitEval v u = unitEval v (scalarIdeles (ideleEquiv.symm c) * unitEquiv.symm k)
      rw [map_mul, unitEval_scalar]
      have hc := congrArg (fun y : IdeleRP => y v) (ideleEquiv.apply_symm_apply c)
      have hk : unitEval v (unitEquiv.symm k) = k v :=
        congrArg (fun y : UnitRP => y v) (unitEquiv.apply_symm_apply k)
      rw [hc, hk]
      exact (hd v).2.1

/-- The actual denominator inside the actual normalizer. -/
def D0 : Subgroup N := globalDenom.subgroupOf N

/-- Coordinate quotient map on actual normalizer elements. -/
def normalizerQuotientHom : N →* LocalQuotientRP :=
  (ZInQ.Contrib.AdelicNormalizer.RestrictedQuotient.quotientHom (Filter.Eventually.of_forall fun v => localH_le_localS (primeAt v).1)).comp
    normalizerEquiv.toMonoidHom

theorem ker_normalizerQuotientHom : normalizerQuotientHom.ker = D0 := by
  ext u
  change normalizerEquiv u ∈
    (ZInQ.Contrib.AdelicNormalizer.RestrictedQuotient.quotientHom
      (Filter.Eventually.of_forall fun v => localH_le_localS (primeAt v).1)).ker ↔
    u.val ∈ globalDenom
  rw [ZInQ.Contrib.AdelicNormalizer.RestrictedQuotient.ker_quotientHom]
  change (∀ v, unitEval v u.val ∈ localDenom (primeAt v).1) ↔ u.val ∈ globalDenom
  exact (mem_globalDenom u.val).symm

theorem normalizerQuotientHom_surjective : Function.Surjective normalizerQuotientHom :=
  (ZInQ.Contrib.AdelicNormalizer.RestrictedQuotient.quotientHom_surjective
    (Filter.Eventually.of_forall fun v => localH_le_localS (primeAt v).1)).comp
      normalizerEquiv.surjective

instance D0_normal : D0.Normal := by
  rw [← ker_normalizerQuotientHom]
  infer_instance

/-- Actual adelic normalizer quotient, identified through its component map and
its proven actual scalar-idele kernel. -/
def normalizerQuotientEquiv : N ⧸ D0 ≃* LocalQuotientRP :=
  (QuotientGroup.quotientMulEquivOfEq ker_normalizerQuotientHom.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective normalizerQuotientHom
      normalizerQuotientHom_surjective)

/-- The prime-two place in Mathlib's actual index set. -/
def placeTwo : Place := Rat.HeightOneSpectrum.primesEquiv.symm ⟨2, Nat.prime_two⟩
/-- The prime-three place in Mathlib's actual index set. -/
def placeThree : Place := Rat.HeightOneSpectrum.primesEquiv.symm ⟨3, Nat.prime_three⟩

theorem primeAt_placeTwo : primeAt placeTwo = ⟨2, Nat.prime_two⟩ :=
  Rat.HeightOneSpectrum.primesEquiv.apply_symm_apply _

theorem primeAt_placeThree : primeAt placeThree = ⟨3, Nat.prime_three⟩ :=
  Rat.HeightOneSpectrum.primesEquiv.apply_symm_apply _

theorem primeAt_eq_two (v : Place) : (primeAt v).1 = 2 ↔ v = placeTwo := by
  constructor
  · intro h
    apply Rat.HeightOneSpectrum.primesEquiv.injective
    exact (Subtype.ext h).trans primeAt_placeTwo.symm
  · rintro rfl
    exact congrArg (fun p : Nat.Primes => p.1) primeAt_placeTwo

theorem primeAt_eq_three (v : Place) : (primeAt v).1 = 3 ↔ v = placeThree := by
  constructor
  · intro h
    apply Rat.HeightOneSpectrum.primesEquiv.injective
    exact (Subtype.ext h).trans primeAt_placeThree.symm
  · rintro rfl
    exact congrArg (fun p : Nat.Primes => p.1) primeAt_placeThree

theorem placeTwo_ne_placeThree : placeTwo ≠ placeThree := by
  intro h
  have h2 : (primeAt placeThree).1 = 2 := (primeAt_eq_two _).2 h.symm
  have h3 : (primeAt placeThree).1 = 3 := (primeAt_eq_three _).2 rfl
  omega

/-- Exactly the two ramified places, within the full finite-prime index set. -/
def ramifiedPlaces : Set Place := {placeTwo, placeThree}

theorem mem_ramifiedPlaces (v : Place) :
    v ∈ ramifiedPlaces ↔ (primeAt v).1 = 2 ∨ (primeAt v).1 = 3 := by
  simp only [ramifiedPlaces, Set.mem_insert_iff, Set.mem_singleton_iff,
    primeAt_eq_two, primeAt_eq_three]

theorem ramifiedPlaces_finite : ramifiedPlaces.Finite :=
  (Set.finite_singleton placeThree).insert placeTwo

theorem card_ramifiedPlaces : Nat.card ramifiedPlaces = 2 := by
  classical
  let s : Finset Place := {placeTwo, placeThree}
  have h : (s : Set Place) = ramifiedPlaces := by simp [s, ramifiedPlaces]
  rw [← h]
  change Nat.card s = 2
  rw [Nat.card_eq_finsetCard]
  simp [s, placeTwo_ne_placeThree]

/-- The local quotient restricted product really has only the two ramified factors. -/
def localQuotientsEquiv : LocalQuotientRP ≃*
    ((v : ramifiedPlaces) → (localNormalizer (primeAt v.val).1) ⧸ localS (primeAt v.val).1) :=
  ZInQ.Contrib.AdelicNormalizer.RestrictedQuotient.restrictedQuotientEquivPi ramifiedPlaces ramifiedPlaces_finite.compl_mem_cofinite
    (by
      intro v hv
      exact localS_eq_top_unramified _
        (fun h => hv ((mem_ramifiedPlaces v).2 (Or.inl h)))
        (fun h => hv ((mem_ramifiedPlaces v).2 (Or.inr h))))

/-- Cardinality of the actual scalar/order-unit quotient is four. -/
theorem card_normalizer_quotient : Nat.card (N ⧸ D0) = 4 := by
  classical
  letI := ramifiedPlaces_finite.fintype
  rw [Nat.card_congr normalizerQuotientEquiv.toEquiv,
    Nat.card_congr localQuotientsEquiv.toEquiv, Nat.card_pi]
  have hc : ∀ v : ramifiedPlaces,
      Nat.card ((localNormalizer (primeAt v.val).1) ⧸ localS (primeAt v.val).1) = 2 :=
    fun v => local_quotient_card_ramified _ ((mem_ramifiedPlaces v.val).1 v.property)
  simp_rw [hc]
  rw [Finset.prod_const, Finset.card_univ, ← Nat.card_eq_fintype_card, card_ramifiedPlaces]
  norm_num

instance normalizerQuotient_finite : Finite (N ⧸ D0) :=
  Nat.finite_of_card_ne_zero (by rw [card_normalizer_quotient]; norm_num)

end

end G1
