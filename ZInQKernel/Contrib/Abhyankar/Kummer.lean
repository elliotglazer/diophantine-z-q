/-!
# The pure Kummer case, with the actual integral closure

This proves the root-ring DVR and normalization bridges without completeness,
henselianity, perfection, or invertibility of the exponent. It treats the
trivial `L/K` case of T2, not the general tame compositum. Every prime above the
closed point is covered; the residue field map is actually surjective.
-/

namespace ZInQ.Contrib.Abhyankar

open Polynomial IsLocalRing IsDiscreteValuationRing

/-- In an algebra generated by a root of a uniformizer, every maximal ideal
is generated by that root. -/
theorem maximalIdeal_eq_span_root
    {R S : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [Algebra R S] {π : R} (hπ : Irreducible π)
    {n : ℕ} (hn : 0 < n) {t : S} (ht : t ^ n = algebraMap R S π)
    (hadjoin : Algebra.adjoin R {t} = ⊤) (P : Ideal S) [P.IsMaximal] :
    P = Ideal.span {t} := by
  have : Module.Finite R S :=
    ⟨by simpa [hadjoin] using (isIntegral_root hn ht).fg_adjoin_singleton⟩
  have hunder : P.under R = maximalIdeal R := eq_maximalIdeal (Ideal.IsMaximal.under R P)
  have htP : t ∈ P := by
    refine (Ideal.IsMaximal.isPrime ‹_›).mem_of_pow_mem n ?_
    rw [ht, ← Ideal.mem_comap, ← Ideal.under_def, hunder, hπ.maximalIdeal_eq]
    exact Ideal.mem_span_singleton_self π
  refine le_antisymm (fun z hz ↦ ?_) ((Ideal.span_singleton_le_iff_mem P).mpr htP)
  have hzgen : z ∈ Algebra.adjoin R {t} := hadjoin ▸ Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hzgen
  obtain ⟨p, rfl⟩ := hzgen
  have hsub : t ∣ aeval t p - algebraMap R S (p.coeff 0) := by
    simpa using _root_.map_dvd (aeval t) (X_dvd_sub_C (p := p))
  have hp0 : p.coeff 0 ∈ maximalIdeal R := by
    rw [← hunder, Ideal.under_def, Ideal.mem_comap]
    simpa using P.sub_mem hz (P.mem_of_dvd hsub htP)
  rw [hπ.maximalIdeal_eq, Ideal.mem_span_singleton] at hp0
  have hπt : t ∣ algebraMap R S π := by
    rw [← ht]
    exact dvd_pow_self t hn.ne'
  rw [Ideal.mem_span_singleton]
  simpa using dvd_add hsub (hπt.trans (_root_.map_dvd (algebraMap R S) hp0))

/-- A domain containing the base DVR and generated by a root of its uniformizer
is a DVR. No separability or residue-field condition is needed. -/
theorem dvr_of_root_adjoin_eq_top
    {R S : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [Algebra R S] [FaithfulSMul R S]
    {π : R} (hπ : Irreducible π) {n : ℕ} (hn : 0 < n) {t : S}
    (ht : t ^ n = algebraMap R S π) (hadjoin : Algebra.adjoin R {t} = ⊤) :
    IsDiscreteValuationRing S := by
  have : Module.Finite R S :=
    ⟨by simpa [hadjoin] using (isIntegral_root hn ht).fg_adjoin_singleton⟩
  have : IsNoetherianRing S := IsNoetherianRing.of_finite R S
  obtain ⟨P, hP⟩ := Ideal.exists_maximal S
  have hPspan := maximalIdeal_eq_span_root hπ hn ht hadjoin P
  have hmax : (Ideal.span {t}).IsMaximal := hPspan ▸ hP
  have : IsLocalRing S := IsLocalRing.of_unique_max_ideal
    ⟨Ideal.span {t}, hmax, fun Q hQ ↦ maximalIdeal_eq_span_root hπ hn ht hadjoin Q⟩
  have hm : maximalIdeal S = Ideal.span {t} := maximalIdeal_eq_span_root hπ hn ht hadjoin _
  have ht0 : t ≠ 0 := by
    intro hz
    have hπS : algebraMap R S π ≠ 0 :=
      (map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective R S)).mpr hπ.ne_zero
    exact hπS (by rw [← ht, hz, zero_pow hn.ne'])
  have hnf : ¬ IsField S := by
    rw [isField_iff_maximalIdeal_eq, hm]
    simpa only [Ideal.span_singleton_eq_bot] using ht0
  exact ((IsDiscreteValuationRing.TFAE S hnf).out 1 5).mpr
    (⟨t, hm⟩ : (maximalIdeal S).IsPrincipal)

/-- The ramification index of the generated root ring is the exponent. -/
theorem ramificationIdx_root_ring
    {R S : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [Algebra R S] [FaithfulSMul R S]
    {π : R} (hπ : Irreducible π) {n : ℕ} (hn : 0 < n) {t : S}
    (ht : t ^ n = algebraMap R S π) (hadjoin : Algebra.adjoin R {t} = ⊤)
    (P : Ideal S) [P.IsMaximal] : P.ramificationIdx R = n := by
  have : IsDiscreteValuationRing S := dvr_of_root_adjoin_eq_top hπ hn ht hadjoin
  have : Module.Finite R S :=
    ⟨by simpa [hadjoin] using (isIntegral_root hn ht).fg_adjoin_singleton⟩
  have : P.LiesOver (maximalIdeal R) := ⟨(eq_maximalIdeal (Ideal.IsMaximal.under R P)).symm⟩
  have hP0 : P ≠ ⊥ := (eq_maximalIdeal ‹P.IsMaximal›).symm ▸ not_a_field S
  have : IsDiscreteValuationRing (Localization.AtPrime P) :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain S hP0 _
  have hmap : (maximalIdeal R).map (algebraMap R S) = P ^ n := by
    rw [hπ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton,
      maximalIdeal_eq_span_root hπ hn ht hadjoin P, Ideal.span_singleton_pow, ht]
  apply ramificationIdx_eq_of_local_map_eq_pow (maximalIdeal R) P
  rw [IsScalarTower.algebraMap_eq R S (Localization.AtPrime P), ← Ideal.map_map, hmap,
    Ideal.map_pow, IsLocalization.AtPrime.map_eq_maximalIdeal]

/-- The residue map of a generated root ring is surjective: each polynomial in
the root reduces to its constant coefficient. -/
theorem root_ring_residue_surjective
    {R S : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [Algebra R S] {π : R} (hπ : Irreducible π)
    {n : ℕ} (hn : 0 < n) {t : S} (ht : t ^ n = algebraMap R S π)
    (hadjoin : Algebra.adjoin R {t} = ⊤) (P : Ideal S) [P.IsMaximal]
    [P.LiesOver (maximalIdeal R)] :
    Function.Surjective (algebraMap (R ⧸ maximalIdeal R) (S ⧸ P)) := by
  intro z
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
  have hz : z ∈ Algebra.adjoin R {t} := hadjoin ▸ Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hz
  obtain ⟨p, rfl⟩ := hz
  refine ⟨Ideal.Quotient.mk _ (p.coeff 0), ?_⟩
  rw [Ideal.Quotient.algebraMap_mk_of_liesOver, Eq.comm, Ideal.Quotient.eq,
    maximalIdeal_eq_span_root hπ hn ht hadjoin P, Ideal.mem_span_singleton]
  simpa using _root_.map_dvd (aeval t) (X_dvd_sub_C (p := p))

private theorem adjoin_root_subalgebra_eq_top
    {R M : Type*} [CommRing R] [CommRing M] [Algebra R M] {t : M}
    {S : Subalgebra R M} (hS : Algebra.adjoin R {t} = S) (h : t ∈ S) :
    Algebra.adjoin R {(⟨t, h⟩ : S)} = ⊤ := by
  apply Subalgebra.map_injective (f := S.val) Subtype.val_injective
  rw [AlgHom.map_adjoin, Set.image_singleton, Algebra.map_top, Subalgebra.range_val]
  exact hS

/-- **Normalization bridge.** In the pure root field the actual integral closure
is the root adjoin, by its proved DVR structure and proved fraction-field identity. -/
theorem integralClosure_eq_adjoin_root
    {R K M : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [Field M] [Algebra K M] [Algebra R M] [IsScalarTower R K M]
    {π : R} (hπ : Irreducible π) {n : ℕ} (hn : 0 < n) {t : M}
    (ht : t ^ n = algebraMap R M π)
    (hadjoin : IntermediateField.adjoin K {t} = ⊤) :
    integralClosure R M = Algebra.adjoin R {t} := by
  have hint : IsIntegral R t := isIntegral_root hn ht
  let S := Algebra.adjoin R {t}
  have hmem : t ∈ S := Algebra.self_mem_adjoin_singleton R t
  let s : S := ⟨t, hmem⟩
  have hs : s ^ n = algebraMap R S π := Subtype.ext ht
  have hgen : Algebra.adjoin R {s} = ⊤ := adjoin_root_subalgebra_eq_top rfl hmem
  have : FaithfulSMul R S := FaithfulSMul.of_field_isFractionRing R S K M
  have : IsDiscreteValuationRing S := dvr_of_root_adjoin_eq_top hπ hn hs hgen
  have : Module.Finite R S :=
    ⟨by simpa [hgen] using (isIntegral_root hn hs).fg_adjoin_singleton⟩
  have : IsFractionRing S M := isFractionRing_adjoin_of_adjoin_eq_top hadjoin
  have : IsIntegralClosure S R M := IsIntegralClosure.of_isIntegrallyClosed _ _ _
  refine le_antisymm (fun z hz ↦ ?_) (Algebra.adjoin_le (Set.singleton_subset_iff.mpr hint))
  obtain ⟨y, rfl⟩ := (IsIntegralClosure.isIntegral_iff (A := S)).mp hz
  exact y.2

/-- **All-prime pure Kummer conclusion.** This is T2 when `M = K(t)`, and holds
even without invertibility of `n`; it is not the general `M = L(t)` conclusion. -/
theorem pureKummer_at_every_prime
    {R K M : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [Field M] [Algebra K M] [Algebra R M] [IsScalarTower R K M]
    {π : R} (hπ : Irreducible π) {n : ℕ} (hn : 0 < n) {t : M}
    (ht : t ^ n = algebraMap R M π)
    (hadjoin : IntermediateField.adjoin K {t} = ⊤)
    (Q : Ideal (integralClosure R M)) [Q.IsPrime] [Q.LiesOver (maximalIdeal R)] :
    Q.ramificationIdx R = n ∧
      Algebra.IsSeparable (R ⧸ maximalIdeal R) (integralClosure R M ⧸ Q) := by
  have hint : t ∈ integralClosure R M := isIntegral_root hn ht
  let s : integralClosure R M := ⟨t, hint⟩
  have hs : s ^ n = algebraMap R (integralClosure R M) π := Subtype.ext ht
  have hgen : Algebra.adjoin R {s} = ⊤ := adjoin_root_subalgebra_eq_top
    (integralClosure_eq_adjoin_root hπ hn ht hadjoin).symm hint
  have : FaithfulSMul R (integralClosure R M) :=
    FaithfulSMul.of_field_isFractionRing R (integralClosure R M) K M
  have : Q.IsMaximal := integralClosure_prime_isMaximal Q
  refine ⟨ramificationIdx_root_ring hπ hn hs hgen Q, ?_⟩
  let := Ideal.Quotient.field (maximalIdeal R)
  constructor
  intro x
  obtain ⟨a, rfl⟩ := root_ring_residue_surjective hπ hn hs hgen Q x
  exact isSeparable_algebraMap a

/-- **Trivial intermediate extension, in an arbitrary presentation.**
Surjectivity of the given `K → L` map reduces the original `M = L(t)`
condition to `M = K(t)`; all integral-closure primes have the exact T2 conclusion. -/
theorem trivialExtension_at_every_prime
    {R K L M : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [Field L] [Algebra K L]
    [Field M] [Algebra K M] [Algebra R M] [Algebra L M]
    [IsScalarTower R K M] [IsScalarTower K L M]
    (hKL : Function.Surjective (algebraMap K L))
    {π : R} (hπ : Irreducible π) {n : ℕ} (hn : 0 < n) {t : M}
    (ht : t ^ n = algebraMap R M π)
    (hadjoin : IntermediateField.adjoin L {t} = ⊤)
    (Q : Ideal (integralClosure R M)) [Q.IsPrime] [Q.LiesOver (maximalIdeal R)] :
    Q.ramificationIdx R = n ∧
      Algebra.IsSeparable (R ⧸ maximalIdeal R) (integralClosure R M ⧸ Q) :=
  pureKummer_at_every_prime hπ hn ht
    (adjoin_eq_top_of_surjective_scalarMap hKL hadjoin) Q

end ZInQ.Contrib.Abhyankar
