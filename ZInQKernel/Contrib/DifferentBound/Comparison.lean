import ZInQKernel.Contrib.DifferentBound.Transport

/-!
# The local/global ramification comparison from actual prime images

This is the arithmetic comparison for a genuine DVR model, not a construction
of that model. The index is computed from the image of the ideal generated by
`p`, then from the global multiplicity of that same integer. No local-field
normalization theorem or ramification-index equality is assumed.
-/

namespace ZInQ.Contrib.DifferentBound

open NumberField IsLocalRing

/-- In a DVR model whose base maximal ideal is generated by `p` and whose upper maximal ideal
is the image of `P`, the genuine local ramification index is the baseline's global one.
The two prime-image equalities are structural model inputs, not bound hypotheses. -/
theorem ramificationIdx_local_model_eq_global
    (L : Type*) [Field L] [NumberField L] (p : ℕ) (hp : p.Prime)
    (P : Ideal (𝓞 L)) [P.IsPrime] [P.LiesOver (Ideal.span {(p : ℤ)})]
    (A B : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B]
    [Module.Finite A B] [Module.IsTorsionFree A B]
    [Algebra (𝓞 L) B] [FaithfulSMul (𝓞 L) B]
    (hbase : maximalIdeal A = Ideal.span {(p : A)})
    (hmapP : P.map (algebraMap (𝓞 L) B) = maximalIdeal B) :
    (maximalIdeal B).ramificationIdx A = P.ramificationIdx ℤ := by
  have hP0 : P ≠ ⊥ := primeAbove_ne_bot L hp P
  have : P.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hP0
  have : (maximalIdeal B).LiesOver (maximalIdeal A) := inferInstance
  have hmapA0 : (maximalIdeal A).map (algebraMap A B) ≠ ⊥ :=
    Ideal.map_ne_bot_of_ne_bot (IsDiscreteValuationRing.not_a_field A)
  rw [Ideal.IsDedekindDomain.ramificationIdx_eq_multiplicity
    (maximalIdeal A) (maximalIdeal B) hmapA0,
    hbase, Ideal.map_span, Set.image_singleton, map_natCast]
  have hspan : (Ideal.span {(p : 𝓞 L)} : Ideal (𝓞 L)) ≠ ⊥ := by
    simpa only [ne_eq, Ideal.span_singleton_eq_bot, Nat.cast_eq_zero] using hp.ne_zero
  have h := multiplicity_map_eq_of_prime_maps_to_maximal (𝓞 L) B P hP0 hmapP
    (Ideal.span {(p : 𝓞 L)}) hspan
  rw [Ideal.map_span, Set.image_singleton, map_natCast] at h
  rw [h, primeAbove_multiplicity_natCast L p hp P hp.ne_zero,
    padicValNat.self hp.one_lt, Nat.mul_one]

#print axioms ramificationIdx_local_model_eq_global

end ZInQ.Contrib.DifferentBound
