/-!
# An unramified intermediate DVR from a separable residue generator

The construction uses a monic lift of a residue minimal polynomial, lifts its
simple root by Hensel's lemma in the actual extension ring, and takes the
subalgebra generated by that root. No different estimate is an input.

The output's reduction map is the residue of its actual inclusion in the upper
ring. `Degree.lean` consumes its residue-surjectivity to obtain rank equal to
ramification index, and `Tower.lean` consumes its unramified-at-the-maximal-ideal
instance to preserve the actual ramification index and different. Those
arithmetic consequences are not assumed in this construction. This module is
not a closed proof of the global different bound or a protocol acceptance.
-/

noncomputable section

namespace ZInQ.Contrib.DifferentBound

open IsLocalRing Polynomial Module

namespace UnramifiedFactor

/-- Ideal-theoretic Henselianity at the maximal ideal gives the local version. -/
theorem henselianLocalRing_of_henselian_maximal (R : Type*) [CommRing R]
    [IsLocalRing R] [HenselianRing R (maximalIdeal R)] : HenselianLocalRing R where
  is_henselian f hf a₀ h₁ h₂ :=
    HenselianRing.is_henselian (I := maximalIdeal R) f hf a₀ h₁ (h₂.map _)

section AdjoinRoot

variable {R S : Type*} [CommRing R] [IsLocalRing R] [CommRing S]

/-- Every maximal ideal in an integral algebra over a local ring contains the
extension of its maximal ideal. -/
theorem map_maximalIdeal_le_of_isMaximal [Algebra R S] [Algebra.IsIntegral R S]
    {M : Ideal S} (hM : M.IsMaximal) :
    (maximalIdeal R).map (algebraMap R S) ≤ M := by
  have hunder : (M.under R).IsMaximal := Ideal.isMaximal_under_of_isIntegral_of_isMaximal M
  rw [← IsLocalRing.eq_maximalIdeal hunder]
  exact Ideal.map_comap_le

omit [IsLocalRing R] in
@[simp]
theorem adjoinRoot_map_mk {f : R →+* S} {p : R[X]} {q : S[X]}
    (h : q ∣ p.map f) (x : R[X]) :
    AdjoinRoot.map f p q h (AdjoinRoot.mk p x) = AdjoinRoot.mk q (x.map f) := by
  rw [AdjoinRoot.map, AdjoinRoot.lift_mk, ← Polynomial.eval₂_map]
  exact AdjoinRoot.aeval_eq (x.map f)

omit [IsLocalRing R] in
/-- Base-map surjectivity passes to the adjoin-root map. The Tau Ceti source credits the
Apache-2.0 AINTLIB/HasseWeil project, `HasseWeil/WeilPairing/FrobeniusFunctionFieldEquiv.lean`
(`dev/hasse-weil` at `513e83879e2f`), for the polynomial-lifting argument. This attribution is
retained; the port was checked against the pinned Tau Ceti source listed above. -/
theorem adjoinRoot_map_surjective {f : R →+* S} (hf : Function.Surjective f)
    {p : R[X]} {q : S[X]} (h : q ∣ p.map f) :
    Function.Surjective (AdjoinRoot.map f p q h) := fun y ↦ by
  obtain ⟨t, rfl⟩ := AdjoinRoot.mk_surjective y
  obtain ⟨u, rfl⟩ := Polynomial.map_surjective f hf t
  exact ⟨AdjoinRoot.mk p u, adjoinRoot_map_mk h u⟩

variable {g : R[X]}

/-- A polynomial whose reduction vanishes maps into the extended maximal ideal. -/
theorem adjoinRoot_mk_mem_map_maximalIdeal {p : R[X]} (hp : p.map (residue R) = 0) :
    AdjoinRoot.mk g p ∈ (maximalIdeal R).map (algebraMap R (AdjoinRoot g)) := by
  have hC : p ∈ (maximalIdeal R).map (C : R →+* R[X]) := by
    rw [Ideal.mem_map_C_iff]
    intro n
    rw [← residue_eq_zero_iff, ← coeff_map, hp, coeff_zero]
  rw [AdjoinRoot.algebraMap_eq, AdjoinRoot.of, ← Ideal.map_map]
  exact Ideal.mem_map_of_mem _ hC

/-- Irreducible reduction gives a maximal extended ideal in the adjoin-root algebra. -/
theorem adjoinRoot_isMaximal_map_maximalIdeal
    (hirr : Irreducible (g.map (residue R))) :
    ((maximalIdeal R).map (algebraMap R (AdjoinRoot g))).IsMaximal := by
  have : Fact (Irreducible (g.map (residue R))) := ⟨hirr⟩
  let φ := AdjoinRoot.map (residue R) g (g.map (residue R)) dvd_rfl
  have hφ : Function.Surjective φ := adjoinRoot_map_surjective residue_surjective dvd_rfl
  suffices h : RingHom.ker φ = (maximalIdeal R).map (algebraMap R (AdjoinRoot g)) from
    h ▸ RingHom.ker_isMaximal_of_surjective φ hφ
  refine le_antisymm (fun x hx ↦ ?_) (Ideal.map_le_iff_le_comap.mpr fun r hr ↦ ?_)
  · obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective x
    rw [RingHom.mem_ker, adjoinRoot_map_mk, AdjoinRoot.mk_eq_zero] at hx
    obtain ⟨q', hq'⟩ := hx
    obtain ⟨q, rfl⟩ := Polynomial.map_surjective _ residue_surjective q'
    have hp : AdjoinRoot.mk g p = AdjoinRoot.mk g (p - g * q) := by simp
    rw [hp]
    exact adjoinRoot_mk_mem_map_maximalIdeal
      (by simp [Polynomial.map_sub, Polynomial.map_mul, hq'])
  · simp [φ, (residue_eq_zero_iff r).mpr hr]

/-- A monic polynomial with irreducible reduction gives a local adjoin-root algebra. -/
theorem adjoinRoot_isLocalRing (hg : g.Monic)
    (hirr : Irreducible (g.map (residue R))) : IsLocalRing (AdjoinRoot g) :=
  have : Module.Finite R (AdjoinRoot g) := (AdjoinRoot.powerBasis' hg).finite
  have hmax := adjoinRoot_isMaximal_map_maximalIdeal hirr
  .of_unique_max_ideal ⟨_, hmax, fun _ hM ↦
    (hmax.eq_of_le hM.ne_top (map_maximalIdeal_le_of_isMaximal hM)).symm⟩

theorem adjoinRoot_maximalIdeal_eq_map [IsLocalRing (AdjoinRoot g)]
    (hirr : Irreducible (g.map (residue R))) :
    maximalIdeal (AdjoinRoot g) = (maximalIdeal R).map (algebraMap R (AdjoinRoot g)) :=
  (IsLocalRing.eq_maximalIdeal (adjoinRoot_isMaximal_map_maximalIdeal hirr)).symm

/-- A monic lift of a separable residue polynomial is separable over the local ring. -/
theorem separable_of_separable_map_residue (hg : g.Monic)
    (hsep : (g.map (residue R)).Separable) : g.Separable := by
  suffices hunit : IsUnit (AdjoinRoot.mk g (derivative g)) by
    obtain ⟨v, hv⟩ := hunit.exists_right_inv
    obtain ⟨b, rfl⟩ := AdjoinRoot.mk_surjective v
    rw [← map_mul, ← sub_eq_zero, ← map_one (AdjoinRoot.mk g), ← map_sub,
      AdjoinRoot.mk_eq_zero] at hv
    obtain ⟨a, ha⟩ := hv
    exact ⟨-a, b, by linear_combination ha⟩
  by_contra hunit
  obtain ⟨M, hM, hmem⟩ := Ideal.exists_le_maximal _
    ((Ideal.span_singleton_ne_top hunit) : Ideal.span {AdjoinRoot.mk g (derivative g)} ≠ ⊤)
  obtain ⟨a', b', hab'⟩ := (separable_def' _).mp hsep
  obtain ⟨a, rfl⟩ := Polynomial.map_surjective _ residue_surjective a'
  obtain ⟨b, rfl⟩ := Polynomial.map_surjective _ residue_surjective b'
  have : Module.Finite R (AdjoinRoot g) := (AdjoinRoot.powerBasis' hg).finite
  have hM' : AdjoinRoot.mk g (a * g + b * derivative g - 1) ∈ M := by
    refine map_maximalIdeal_le_of_isMaximal hM (adjoinRoot_mk_mem_map_maximalIdeal ?_)
    rw [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul,
      ← derivative_map, hab', Polynomial.map_one, sub_self]
  have hder : AdjoinRoot.mk g (derivative g) ∈ M :=
    hmem (Ideal.mem_span_singleton_self _)
  apply hM.ne_top
  rw [Ideal.eq_top_iff_one]
  have h1 : (1 : AdjoinRoot g) = AdjoinRoot.mk g b * AdjoinRoot.mk g (derivative g) -
      AdjoinRoot.mk g (a * g + b * derivative g - 1) := by
    simp [AdjoinRoot.mk_self]
  rw [h1]
  exact M.sub_mem (M.mul_mem_left _ hder) hM'

end AdjoinRoot

/-- Adjoining a root of a separable monic polynomial is a standard etale algebra. -/
theorem isStandardEtale_adjoinRoot {R : Type*} [CommRing R] {f : R[X]}
    (hf : f.Monic) (hs : f.Separable) : Algebra.IsStandardEtale R (AdjoinRoot f) := by
  obtain ⟨a, b, hab⟩ := (separable_def' f).mp hs
  let P : StandardEtalePair R :=
    ⟨f, hf, 1, b, a, 0, by rw [pow_zero, ← hab]; ring⟩
  have hroot : P.HasMap (AdjoinRoot.root f) :=
    ⟨AdjoinRoot.aeval_eq f ▸ AdjoinRoot.mk_self, by simp [P]⟩
  have hX : f.eval₂ (Algebra.ofId R P.Ring : R →+* P.Ring) P.X = 0 := P.hasMap_X.1
  let φ : P.Ring →ₐ[R] AdjoinRoot f := P.lift _ hroot
  let ψ : AdjoinRoot f →ₐ[R] P.Ring := AdjoinRoot.liftAlgHom f (Algebra.ofId R _) P.X hX
  have hψ : ψ (AdjoinRoot.root f) = P.X := AdjoinRoot.liftAlgHom_root f _ _ hX
  have hφψ : φ.comp ψ = AlgHom.id R _ :=
    AdjoinRoot.algHom_ext (by rw [AlgHom.comp_apply, hψ]; exact P.lift_X _ hroot)
  have hψφ : ψ.comp φ = AlgHom.id R _ :=
    P.hom_ext (by rw [AlgHom.comp_apply, P.lift_X, hψ, AlgHom.id_apply])
  have : Algebra.IsStandardEtale R P.Ring := inferInstance
  exact this.of_equiv (AlgEquiv.ofAlgHom φ ψ hφψ hψφ)

section Completeness

variable {R : Type*} [CommRing R] (I : Ideal R)

/-- Finite products of adically precomplete modules are precomplete. -/
theorem precomplete_pi {ι : Type*} [Finite ι] (M : ι → Type*)
    [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, IsPrecomplete I (M i)] : IsPrecomplete I (∀ i, M i) := by
  classical
  have := Fintype.ofFinite ι
  refine AdicCompletion.of_surjective_iff.mp fun y ↦ ?_
  choose x hx using fun j ↦
    AdicCompletion.of_surjective I (M j) (AdicCompletion.pi I M y j)
  refine ⟨x, (AdicCompletion.piEquivOfFintype I M).injective
    (_root_.funext fun j ↦ ?_)⟩
  simp only [AdicCompletion.piEquivOfFintype_apply, AdicCompletion.pi]
  exact hx j

/-- Adic precompleteness passes to a surjective image. -/
theorem precomplete_of_surjective {M N : Type*} [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] [IsPrecomplete I M]
    (f : M →ₗ[R] N) (hf : Function.Surjective f) : IsPrecomplete I N := by
  refine AdicCompletion.of_surjective_iff.mp fun y ↦ ?_
  obtain ⟨z, rfl⟩ := AdicCompletion.map_surjective I hf y
  obtain ⟨x, rfl⟩ := AdicCompletion.of_surjective I M z
  exact ⟨f x, (AdicCompletion.map_of I f x).symm⟩

/-- Every finite module over an adically precomplete ring is precomplete. -/
theorem precomplete_of_finite (M : Type*) [AddCommGroup M] [Module R M]
    [IsPrecomplete I R] [Module.Finite R M] : IsPrecomplete I M := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  have := precomplete_pi I (fun _ : Fin n ↦ R)
  exact precomplete_of_surjective I f hf

/-- Every finite module over an adically complete Noetherian ring is complete. -/
theorem adicComplete_of_finite (M : Type*) [AddCommGroup M] [Module R M]
    [IsNoetherianRing R] [IsAdicComplete I R] [Module.Finite R M] :
    IsAdicComplete I M where
  toIsHausdorff := IsHausdorff.of_le_jacobson I M (IsAdicComplete.le_jacobson_bot I)
  toIsPrecomplete := precomplete_of_finite I M

/-- Completeness transfers between cofinal ideal-power filtrations. -/
theorem adicComplete_of_cofinal {J : Ideal R} {M : Type*} [AddCommGroup M] [Module R M]
    [IsAdicComplete I M] {k l : ℕ} (hJI : J ^ k ≤ I) (hIJ : I ^ l ≤ J) :
    IsAdicComplete J M := by
  have hpow {A B : Ideal R} {a : ℕ} (h : A ^ a ≤ B) (m : ℕ) :
      A ^ ((a + 1) * m) ≤ B ^ m :=
    (pow_mul A (a + 1) m).le.trans
      (Ideal.pow_right_mono ((Ideal.pow_le_pow_right a.le_succ).trans h) m)
  refine {
    toIsHausdorff := ⟨fun x hx ↦ IsHausdorff.haus' (I := I) x fun m ↦
      (hx (k * m)).mono (Submodule.smul_mono_left
        ((pow_mul J k m).le.trans (Ideal.pow_right_mono hJI m)))⟩
    toIsPrecomplete := ⟨fun f hf ↦ ?_⟩ }
  obtain ⟨L, hL⟩ := IsPrecomplete.prec' (I := I) (fun m ↦ f ((k + 1) * m))
    fun {m n} hmn ↦ (hf (Nat.mul_le_mul_left _ hmn)).mono
      (Submodule.smul_mono_left (hpow hJI m))
  exact ⟨L, fun m ↦ (hf ((Nat.le_mul_of_pos_left m l.succ_pos).trans
    (Nat.le_mul_of_pos_left _ k.succ_pos))).trans
    ((hL ((l + 1) * m)).mono (Submodule.smul_mono_left (hpow hIJ m)))⟩

end Completeness

section DVRExtension

variable {A B : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B]
    [Module.IsTorsionFree A B] [(maximalIdeal B).LiesOver (maximalIdeal A)]

/-- The extended maximal ideal is the actual ramification-index power of the upper one. -/
theorem map_maximalIdeal_eq_pow_ramificationIdx :
    (maximalIdeal A).map (algebraMap A B) =
      maximalIdeal B ^ (maximalIdeal B).ramificationIdx A := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible A
  rw [hπ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  ext x
  rw [Ideal.mem_span_singleton, ← IsDiscreteValuationRing.addVal_le_iff_dvd,
    mem_maximalIdeal_pow_iff_le_addVal, addVal_algebraMap,
    IsDiscreteValuationRing.addVal_uniformizer hπ]
  simp

/-- A finite faithful DVR algebra over a complete DVR is complete at its own maximal ideal. -/
theorem adicComplete_dvr_of_finite [Module.Finite A B]
    [IsAdicComplete (maximalIdeal A) A] : IsAdicComplete (maximalIdeal B) B := by
  let J := (maximalIdeal A).map (algebraMap A B)
  have : IsAdicComplete J B := (IsAdicComplete.map_algebraMap_iff _ _).mpr
    (adicComplete_of_finite (maximalIdeal A) B)
  exact adicComplete_of_cofinal J
    (map_maximalIdeal_eq_pow_ramificationIdx (A := A) (B := B)).ge
    ((pow_one J).trans_le (IsLocalRing.map_maximalIdeal_le (algebraMap A B)))

end DVRExtension

/-- A local Noetherian domain with the same maximal-ideal generator as a faithful DVR base
is itself a DVR. No regular-local-ring API is needed. -/
theorem dvr_of_map_maximalIdeal_eq {R S : Type*} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [CommRing S] [IsDomain S] [IsLocalRing S]
    [IsNoetherianRing S] [Algebra R S] [FaithfulSMul R S]
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    IsDiscreteValuationRing S := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hS : maximalIdeal S = Ideal.span {algebraMap R S π} := by
    rw [← h, hπ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  have hπS : algebraMap R S π ≠ 0 := by
    simpa only [map_zero] using
      (FaithfulSMul.algebraMap_injective R S).ne_iff.mpr hπ.ne_zero
  have hfield : ¬ IsField S := fun hfield ↦ hπS <| by
    have hzero : maximalIdeal S = ⊥ := isField_iff_maximalIdeal_eq.mp hfield
    rwa [hS, Ideal.span_singleton_eq_bot] at hzero
  have hprin : (maximalIdeal S).IsPrincipal := ⟨⟨_, hS⟩⟩
  exact ((IsDiscreteValuationRing.TFAE S hfield).out 1 5).mpr hprin

/-- An irreducible monic polynomial vanishing at an integral element is its actual minimal
polynomial over the integrally closed base. -/
theorem minpoly_eq_of_irreducible_monic {R S : Type*} [CommRing R] [IsDomain R]
    [IsIntegrallyClosed R] [CommRing S] [IsDomain S] [Algebra R S]
    [Module.IsTorsionFree R S] {g : R[X]} (hg : g.Monic) (hirr : Irreducible g)
    {b : S} (hb : aeval b g = 0) : minpoly R b = g := by
  have hint : IsIntegral R b := ⟨g, hg, hb⟩
  obtain ⟨q, hq⟩ := minpoly.isIntegrallyClosed_dvd hint hb
  symm
  apply eq_of_monic_of_associated hg (minpoly.monic hint)
  convert Associated.mul_left (minpoly R b) (associated_one_iff_isUnit.mpr
    ((hirr.isUnit_or_isUnit hq).resolve_left (minpoly.not_isUnit R b)))
  rw [mul_one]

end UnramifiedFactor

/-- An actual intermediate finite unramified DVR whose reduction surjects onto the residue
field of the upper ring. The carrier is a subalgebra, so both structural maps are the actual
inclusions, not unrelated rings with isomorphic residue fields. -/
structure UnramifiedDVRFactor (A B : Type*) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [Algebra A B] where
  carrier : Subalgebra A B
  isDvr : IsDiscreteValuationRing carrier
  finiteBase : Module.Finite A carrier
  faithfulBase : FaithfulSMul A carrier
  finiteTop : Module.Finite carrier B
  etale : Algebra.Etale A carrier
  residue_surjective : Function.Surjective ((residue B).comp carrier.val.toRingHom)

attribute [instance] UnramifiedDVRFactor.isDvr UnramifiedDVRFactor.finiteBase
  UnramifiedDVRFactor.faithfulBase UnramifiedDVRFactor.finiteTop UnramifiedDVRFactor.etale

namespace UnramifiedFactor

section Construction

variable {A B : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B]
    [Module.Finite A B] [FaithfulSMul A B]
    [Algebra.IsSeparable (ResidueField A) (ResidueField B)]

/-- In a Henselian upper DVR, a finite separable residue extension has an actual finite etale
intermediate DVR. Its generator is a Hensel lift of a primitive residue element. -/
theorem nonempty_of_henselian [HenselianLocalRing B] :
    Nonempty (UnramifiedDVRFactor A B) := by
  obtain ⟨α, hα⟩ := Field.exists_primitive_element (ResidueField A) (ResidueField B)
  have hαint : IsIntegral (ResidueField A) α := .of_finite _ _
  obtain ⟨g, hgmap, -, hg⟩ := lifts_and_degree_eq_and_monic
    (Polynomial.map_surjective _ residue_surjective (minpoly (ResidueField A) α))
    (minpoly.monic hαint)
  have hirr : Irreducible (g.map (residue A)) := hgmap ▸ minpoly.irreducible hαint
  have hsep : (g.map (residue A)).Separable :=
    hgmap ▸ Algebra.IsSeparable.isSeparable (ResidueField A) α
  have hbase (p : A[X]) : aeval α (p.map (algebraMap A B)) =
      aeval α (p.map (residue A)) := by
    rw [aeval_def, eval₂_map, aeval_def, eval₂_map]
    congr 1
  have hroot : aeval α (g.map (algebraMap A B)) = 0 := by
    rw [hbase, hgmap]
    exact minpoly.aeval _ _
  have hder : aeval α (derivative (g.map (algebraMap A B))) ≠ 0 := by
    rw [derivative_map, hbase, ← derivative_map, hgmap]
    exact (Algebra.IsSeparable.isSeparable (ResidueField A) α).aeval_derivative_ne_zero
      (minpoly.aeval _ _)
  obtain ⟨b, hb, hbres⟩ := ((HenselianLocalRing.TFAE B).out 1 2 rfl rfl).mp
    (inferInstance : HenselianLocalRing B) (g.map (algebraMap A B)) (hg.map _) α hroot hder
  have hb' : aeval b g = 0 := by simpa only [IsRoot, eval_map, aeval_def] using hb
  have hbint : IsIntegral A b := ⟨g, hg, hb'⟩
  have hmin : minpoly A b = g := minpoly_eq_of_irreducible_monic hg
    (Polynomial.Monic.irreducible_of_irreducible_map (residue A) g hg hirr) hb'
  let U : Subalgebra A B := Algebra.adjoin A {b}
  let e : AdjoinRoot g ≃ₐ[A] U := by
    rw [← hmin]
    exact minpoly.equivAdjoin hbint
  have : IsLocalRing (AdjoinRoot g) := adjoinRoot_isLocalRing hg hirr
  have : IsLocalRing U := e.toRingEquiv.isLocalRing
  have : Module.Finite A U := (Algebra.adjoin.powerBasis' hbint).finite
  have : IsNoetherianRing U := Algebra.FiniteType.isNoetherianRing A U
  have hmap : (maximalIdeal A).map (algebraMap A U) = maximalIdeal U := by
    calc
      _ = ((maximalIdeal A).map (algebraMap A (AdjoinRoot g))).map e.toRingEquiv.toRingHom := by
        rw [Ideal.map_map]
        congr 1
        ext a
        exact congrArg (fun u : U ↦ (u : B)) (e.commutes a).symm
      _ = (maximalIdeal (AdjoinRoot g)).map e.toRingEquiv.toRingHom := by
        rw [adjoinRoot_maximalIdeal_eq_map hirr]
      _ = maximalIdeal U := IsLocalRing.map_ringEquiv_maximalIdeal e.toRingEquiv
  have : IsDiscreteValuationRing U := dvr_of_map_maximalIdeal_eq hmap
  have : Algebra.IsStandardEtale A (AdjoinRoot g) := isStandardEtale_adjoinRoot hg
    (separable_of_separable_map_residue hg hsep)
  have : Algebra.Etale A U := Algebra.Etale.of_equiv e
  have : Module.Finite U B := Module.Finite.of_restrictScalars_finite A U B
  have hαgen : Algebra.adjoin (ResidueField A) {α} = ⊤ :=
    Algebra.adjoin_eq_top_of_primitive_element hαint.isAlgebraic hα
  have hres : Function.Surjective ((residue B).comp U.val.toRingHom) := by
    intro x
    have hx : x ∈ Algebra.adjoin (ResidueField A) {α} := by rw [hαgen]; trivial
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hx
    obtain ⟨p, hp⟩ := hx
    obtain ⟨q, hq⟩ := Polynomial.map_surjective _ residue_surjective p
    let u : U := ⟨aeval b q, by
      change aeval b q ∈ Algebra.adjoin A {b}
      rw [Algebra.adjoin_singleton_eq_range_aeval]
      exact ⟨q, rfl⟩⟩
    refine ⟨u, ?_⟩
    change residue B (aeval b q) = x
    rw [map_aeval_eq_aeval_map (ψ := residue B) (φ := residue A) rfl, hbres, hq]
    exact hp
  exact ⟨{
    carrier := U
    isDvr := inferInstance
    finiteBase := inferInstance
    faithfulBase := inferInstance
    finiteTop := inferInstance
    etale := inferInstance
    residue_surjective := hres }⟩

/-- A finite faithful extension of complete DVRs with separable residue extension contains an
actual finite unramified intermediate DVR having the entire upper residue field. Completeness
of the upper ring is derived from completeness of the base; it is not an extra premise. -/
theorem nonempty [IsAdicComplete (maximalIdeal A) A] :
    Nonempty (UnramifiedDVRFactor A B) := by
  have : IsAdicComplete (maximalIdeal B) B := adicComplete_dvr_of_finite (A := A) (B := B)
  have : HenselianLocalRing B := henselianLocalRing_of_henselian_maximal B
  exact nonempty_of_henselian (A := A) (B := B)

end Construction

section PerfectResidue

variable {A B : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B]
    [Module.Finite A B] [FaithfulSMul A B] [IsAdicComplete (maximalIdeal A) A]

/-- Perfectness of the base residue field supplies the separability used in the construction. -/
theorem nonempty_of_perfect [PerfectField (ResidueField A)] :
    Nonempty (UnramifiedDVRFactor A B) := nonempty (A := A) (B := B)

/-- The finite-residue specialization needed for extensions of number-field completions. -/
theorem nonempty_of_finite_residue [Finite (ResidueField A)] :
    Nonempty (UnramifiedDVRFactor A B) := nonempty_of_perfect (A := A) (B := B)

end PerfectResidue

end UnramifiedFactor

namespace UnramifiedDVRFactor

variable {A B : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B]
    (F : UnramifiedDVRFactor A B)

/-- The canonical inclusion of the base into the constructed DVR is local. -/
instance isLocalHom_base : IsLocalHom (algebraMap A F.carrier) :=
  Algebra.IsIntegral.isLocalHom A F.carrier

/-- The canonical inclusion of the constructed DVR into the upper ring is local. -/
instance isLocalHom_top : IsLocalHom (algebraMap F.carrier B) :=
  Algebra.IsIntegral.isLocalHom F.carrier B

/-- The surjectivity field is literally the canonical algebra-map interface used for the
ramification-degree comparison and residue-surjective uniformizer generation. -/
theorem residue_surjective_algebraMap :
    Function.Surjective ((residue B).comp (algebraMap F.carrier B)) :=
  F.residue_surjective

/-- The canonical map of the constructed and upper residue fields is surjective. -/
theorem residueField_surjective :
    Function.Surjective (algebraMap (ResidueField F.carrier) (ResidueField B)) := by
  intro y
  obtain ⟨u, hu⟩ := F.residue_surjective_algebraMap y
  refine ⟨residue F.carrier u, ?_⟩
  simpa only [ResidueField.algebraMap_residue, RingHom.comp_apply] using hu

/-- The isomorphism of residue fields is induced by the actual inclusion in the upper ring. -/
def residueFieldEquiv : ResidueField F.carrier ≃+* ResidueField B :=
  RingEquiv.ofBijective (algebraMap (ResidueField F.carrier) (ResidueField B))
    ⟨RingHom.injective _, F.residueField_surjective⟩

@[simp]
theorem residueFieldEquiv_apply_residue (u : F.carrier) :
    F.residueFieldEquiv (residue F.carrier u) = residue B (algebraMap F.carrier B u) :=
  ResidueField.algebraMap_residue u

/-- Etaleness gives the exact Mathlib unramified-at-the-maximal-ideal instance needed by the
unramified tower theorem. -/
theorem isUnramifiedAt : Algebra.IsUnramifiedAt A (maximalIdeal F.carrier) := inferInstance

/-- The maximal ideal of the base generates exactly that of the constructed DVR. -/
theorem map_maximalIdeal :
    (maximalIdeal A).map (algebraMap A F.carrier) = maximalIdeal F.carrier :=
  Algebra.FormallyUnramified.map_maximalIdeal

/-- The intermediate DVR is complete whenever the original base is complete. This supplies
the complete base for residue-surjective uniformizer generation over the intermediate ring. -/
theorem adicComplete [IsAdicComplete (maximalIdeal A) A] :
    IsAdicComplete (maximalIdeal F.carrier) F.carrier :=
  UnramifiedFactor.adicComplete_dvr_of_finite (A := A) (B := F.carrier)

end UnramifiedDVRFactor

end ZInQ.Contrib.DifferentBound
