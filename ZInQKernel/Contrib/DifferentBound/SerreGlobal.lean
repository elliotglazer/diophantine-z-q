import ZInQKernel.Contrib.DifferentBound.FixedField
import ZInQKernel.Contrib.DifferentBound.Equivalence
import ZInQKernel.Contrib.DifferentBound.Presentation

/-!
# The exact global Serre different bound

Every number field is transported to its actual fixed-field presentation in a
finite Galois closure. Every input prime is transported by the literal integral
isomorphism and lifted by the integral lying-over theorem. The actual F/U/E
localized tower supplies the proved bound. Exact different, ramification-index
and integer-principal-ideal multiplicities return it to the original field.

No Galois/completeness/perfectness hypothesis is added to the original target,
no bound or model comparison is assumed, and the baseline definition is unchanged.
-/

namespace ZInQ.Contrib.DifferentBound

open NumberField
open GlobalDifferentTransport

/-- The absolute different exponent bound for every number field and every nonzero prime.
This stronger integral form uses the valuation of the actual principal ideal generated by e. -/
theorem numberFieldDifferentMultiplicityBound
    (L : Type*) [Field L] [NumberField L] (P : Ideal (𝓞 L)) [P.IsPrime] (hP : P ≠ ⊥) :
    multiplicity P (differentIdeal ℤ (𝓞 L)) ≤
      P.ramificationIdx ℤ - 1 +
        multiplicity P (Ideal.span {(P.ramificationIdx ℤ : 𝓞 L)}) := by
  let M := Presentation.ambient L
  let : NumberField M := Presentation.ambient_numberField L
  let : IsGalois ℚ M := Presentation.ambient_isGalois L
  let H := Presentation.subgroup L
  let K := originalFixedField M H
  let e : L ≃ₐ[ℚ] K := Presentation.equiv L
  let q : Ideal (𝓞 K) := P.map (integersEquiv e)
  let : q.IsPrime := Ideal.map_isPrime_of_surjective (integersEquiv e).surjective (by simp)
  have hq : q ≠ ⊥ := by
    intro hq
    exact hP ((Ideal.map_eq_bot_iff_of_injective (integersEquiv e).injective).mp hq)
  let : FaithfulSMul (𝓞 K) (𝓞 M) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (NumberField.RingOfIntegers.algebraMap.injective K M)
  let : Algebra.IsIntegral (𝓞 K) (𝓞 M) := NumberField.RingOfIntegers.extension_algebra_isIntegral K M
  -- This choice is made for each arbitrary input prime q. No unique-prime
  -- assumption or smaller prime family is used at this presentation step.
  let Q : q.primesOver (𝓞 M) := Classical.choice (inferInstance : Nonempty (q.primesOver (𝓞 M)))
  have hQ : (Q : Ideal (𝓞 M)) ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot hq Q.1
  have hunder : (Q : Ideal (𝓞 M)).under (𝓞 K) = q := (Ideal.over_def Q.1 q).symm
  have hb := fixedFieldDifferentMultiplicityBound M Q.1 H hQ
  change multiplicity (Q.1.under (𝓞 K)) (differentIdeal ℤ (𝓞 K)) ≤
    (Q.1.under (𝓞 K)).ramificationIdx ℤ - 1 +
      multiplicity (Q.1.under (𝓞 K))
        (Ideal.span {((Q.1.under (𝓞 K)).ramificationIdx ℤ : 𝓞 K)}) at hb
  rw [hunder] at hb
  have he : q.ramificationIdx ℤ = P.ramificationIdx ℤ := ramificationIdx_integersEquiv e P hP
  rw [he] at hb
  change multiplicity (P.map (integersEquiv e)) (differentIdeal ℤ (𝓞 K)) ≤
    P.ramificationIdx ℤ - 1 +
      multiplicity (P.map (integersEquiv e)) (Ideal.span {(P.ramificationIdx ℤ : 𝓞 K)}) at hb
  rw [multiplicity_absoluteDifferent_equiv e P,
    multiplicity_natCast_equiv e P (P.ramificationIdx ℤ)] at hb
  exact hb

/-- **The exact closed GLOBAL T21 proposition.** All number fields, rational primes and
primes above them are covered. The field/model/ideal comparisons and the local Serre bound
are proved; Hilbert's formula and Serre's bound are not additional assumptions. -/
theorem serreDifferentBound : GlueConductor.SerreDifferentBound := by
  unfold GlueConductor.SerreDifferentBound
  intro L _ _ p hp P _ hPl
  let := hPl
  have hP : P ≠ ⊥ := primeAbove_ne_bot L hp P
  have hb := numberFieldDifferentMultiplicityBound L P hP
  have he0 : P.ramificationIdx ℤ ≠ 0 := (global_ramificationIdx_pos L P).ne'
  rw [primeAbove_multiplicity_natCast L p hp P he0] at hb
  exact (not_pow_dvd_global_different_iff L P _).mpr hb

#check @numberFieldDifferentMultiplicityBound
#check @serreDifferentBound
#print axioms numberFieldDifferentMultiplicityBound
#print axioms serreDifferentBound

end ZInQ.Contrib.DifferentBound
