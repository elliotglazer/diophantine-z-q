import ZInQKernel.Contrib.HilbertDifferent.Counting
import Mathlib.RingTheory.DedekindDomain.Different

open Finset Polynomial
open scoped Classical

namespace ZInQ.Contrib.HilbertDifferent

section IntegralClosure

variable (A K L B : Type*) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
  [Field K] [Field L] [CommRing B] [IsDedekindDomain B]
  [Algebra A K] [IsFractionRing A K] [Algebra K L] [Algebra A L]
  [Algebra A B] [Algebra B L] [IsScalarTower A K L] [IsScalarTower A B L]
  [IsIntegralClosure B A L] [FiniteDimensional K L] [IsGalois K L]
  [Module.IsTorsionFree A B] [Module.Finite A B]

include K L

/-- In a monogenic integral closure, the different is the principal ideal generated by the
product of all nonidentity displacements in exactly `Aut(B/A)`. -/
theorem differentIdeal_eq_span_autProd_of_monogenic (x : B) (hx : Algebra.adjoin A {x} = ⊤) :
    differentIdeal A B =
      Ideal.span {∏ σ ∈ (univ : Finset (B ≃ₐ[A] B)).erase 1, (x - σ x)} := by
  have := IsIntegralClosure.isFractionRing_of_finite_extension A K L B
  have hfield : IntermediateField.adjoin K {algebraMap B L x} = ⊤ :=
    field_adjoin_eq_top_of_ring_adjoin_eq_top hx
  have hK : Algebra.adjoin K {algebraMap B L x} = ⊤ :=
    (IntermediateField.adjoin_eq_top_iff_of_isAlgebraic
      (fun y _ ↦ IsAlgebraic.of_finite K y)).mp hfield
  have hdiff : differentIdeal A B = Ideal.span {aeval x (derivative (minpoly A x))} := by
    rw [← conductor_mul_differentIdeal A K L x hK, conductor_eq_top_of_adjoin_eq_top hx,
      Ideal.top_mul]
  rw [hdiff]
  have hprod : aeval x (derivative (minpoly A x)) =
      ∏ σ ∈ (univ : Finset Gal(L/K)).erase 1, (x - galRestrict A K L B σ x) := by
    apply IsIntegralClosure.algebraMap_injective B A L
    have hint : IsIntegral A x := IsIntegral.of_finite A x
    have h : algebraMap B L (aeval x (derivative (minpoly A x))) =
        aeval (algebraMap B L x) (derivative (minpoly K (algebraMap B L x))) := by
      rw [minpoly.isIntegrallyClosed_eq_field_fractions K L hint, derivative_map,
        aeval_map_algebraMap, aeval_algebraMap_apply]
    rw [h, aeval_derivative_minpoly_eq_prod_of_adjoin_eq_top hfield]
    simp only [map_prod, map_sub, algebraMap_galRestrict_apply]
  rw [hprod]
  congr 2
  let e := galRestrict A K L B
  refine Finset.prod_bij (fun σ _ ↦ e σ) ?_ ?_ ?_ ?_
  · intro σ hσ
    refine mem_erase.mpr ⟨?_, mem_univ _⟩
    intro h
    exact (ne_of_mem_erase hσ) (e.injective (h.trans e.map_one.symm))
  · intro σ _ τ _ h
    exact e.injective h
  · intro τ hτ
    refine ⟨e.symm τ, mem_erase.mpr ⟨?_, mem_univ _⟩, e.apply_symm_apply τ⟩
    intro h
    apply ne_of_mem_erase hτ
    calc τ = e (e.symm τ) := (e.apply_symm_apply τ).symm
      _ = e 1 := congrArg e h
      _ = 1 := e.map_one
  · intro σ _
    rfl

/-- Generic algebraic Hilbert formula with all arithmetic hypotheses explicit. In particular
this applies to a genuinely finite, monogenic DVR extension with Galois fraction fields, but
it never asserts that a selected global-prime localization is automatically finite. -/
theorem hilbertDifferentAt_integralClosure_of_monogenic (x : B)
    (hx : Algebra.adjoin A {x} = ⊤) (P : Ideal B) [P.IsPrime] (hP : P ≠ ⊥) :
    ∃ n, (P ^ (n + 1)).inertia (B ≃ₐ[A] B) = ⊥ ∧
      P ^ (∑ i ∈ range n, (Nat.card ((P ^ (i + 1)).inertia (B ≃ₐ[A] B)) - 1)) ∣
        differentIdeal A B ∧
      ¬ P ^ ((∑ i ∈ range n, (Nat.card ((P ^ (i + 1)).inertia (B ≃ₐ[A] B)) - 1)) + 1) ∣
        differentIdeal A B := by
  obtain ⟨n, hn⟩ := exists_forall_powerInertia_eq_bot (G := B ≃ₐ[A] B) (Q := P)
    Ideal.IsPrime.ne_top'
  have hne : ∀ σ ∈ (univ : Finset (B ≃ₐ[A] B)).erase 1,
      Ideal.span {x - σ x} ≠ (⊥ : Ideal B) := by
    intro σ hσ hzero
    have hfix : σ • x = x := (sub_eq_zero.mp (Ideal.span_singleton_eq_bot.mp hzero)).symm
    exact (ne_of_mem_erase hσ) (eq_one_of_smul_generator_eq hx hfix)
  have hD : differentIdeal A B ≠ ⊥ := by
    rw [differentIdeal_eq_span_autProd_of_monogenic A K L B x hx, span_singleton_finsetProd]
    exact Finset.prod_ne_zero_iff.mpr hne
  have hfinite : FiniteMultiplicity P (differentIdeal A B) :=
    FiniteMultiplicity.of_prime_left ((Ideal.prime_iff_isPrime hP).mpr inferInstance) hD
  have hsum : multiplicity P (differentIdeal A B) =
      ∑ i ∈ range n, (Nat.card ((P ^ (i + 1)).inertia (B ≃ₐ[A] B)) - 1) := by
    rw [differentIdeal_eq_span_autProd_of_monogenic A K L B x hx, span_singleton_finsetProd,
      multiplicity_prod_of_ne_bot P hP _ _ hne]
    have hsign : ∀ σ : B ≃ₐ[A] B, Ideal.span {x - σ x} = Ideal.span {σ • x - x} := by
      intro σ
      rw [← neg_sub, Ideal.span_singleton_neg]
      rfl
    simp_rw [hsign]
    exact sum_displacementMultiplicity_eq_sum_powerInertiaCard (R := A) P hP hx (hn n le_rfl)
  exact ⟨n, hn n le_rfl, hfinite.multiplicity_eq_iff.mp hsum⟩

end IntegralClosure

end ZInQ.Contrib.HilbertDifferent
