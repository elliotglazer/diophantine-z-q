import ZInQKernel.Contrib.HilbertDifferent.Global
import ZInQKernel.Contrib.HilbertDifferent.Counting

open NumberField Finset Polynomial
open scoped Classical

namespace ZInQ.Contrib.HilbertDifferent

variable (L : Type*) [Field L] [NumberField L] [IsGalois ℚ L]

/-- A monogenic ring of integers has different generated by the derivative at its generator.
The field-generation hypothesis needed by Mathlib is derived, not assumed. -/
theorem differentIdeal_eq_span_derivative_of_monogenic (x : 𝓞 L)
    (hx : Algebra.adjoin ℤ {x} = ⊤) :
    differentIdeal ℤ (𝓞 L) = Ideal.span {aeval x (derivative (minpoly ℤ x))} := by
  have hfield : IntermediateField.adjoin ℚ {algebraMap (𝓞 L) L x} = ⊤ :=
    field_adjoin_eq_top_of_ring_adjoin_eq_top hx
  have hQ : Algebra.adjoin ℚ {algebraMap (𝓞 L) L x} = ⊤ :=
    (IntermediateField.adjoin_eq_top_iff_of_isAlgebraic
      (fun y _ ↦ IsAlgebraic.of_finite ℚ y)).mp hfield
  rw [← conductor_mul_differentIdeal ℤ ℚ L x hQ, conductor_eq_top_of_adjoin_eq_top hx,
    Ideal.top_mul]

/-- The different generator is the product of all nonidentity Galois displacements in the
original ring of integers. It is not an equality only after extending to the field. -/
theorem differentIdeal_eq_span_displacementProd_of_monogenic (x : 𝓞 L)
    (hx : Algebra.adjoin ℤ {x} = ⊤) :
    differentIdeal ℤ (𝓞 L) =
      Ideal.span {∏ σ ∈ (univ : Finset Gal(L/ℚ)).erase 1, (x - σ • x)} := by
  classical
  rw [differentIdeal_eq_span_derivative_of_monogenic L x hx]
  congr 2
  apply NumberField.RingOfIntegers.ext
  have hfield : IntermediateField.adjoin ℚ {algebraMap (𝓞 L) L x} = ⊤ :=
    field_adjoin_eq_top_of_ring_adjoin_eq_top hx
  have hint : IsIntegral ℤ x := IsIntegral.of_finite ℤ x
  have h : algebraMap (𝓞 L) L (aeval x (derivative (minpoly ℤ x))) =
      aeval (algebraMap (𝓞 L) L x)
        (derivative (minpoly ℚ (algebraMap (𝓞 L) L x))) := by
    rw [minpoly.isIntegrallyClosed_eq_field_fractions ℚ L hint, derivative_map,
      aeval_map_algebraMap, aeval_algebraMap_apply]
  rw [aeval_derivative_minpoly_eq_prod_of_adjoin_eq_top hfield] at h
  have hsmul (σ : Gal(L/ℚ)) (y : 𝓞 L) :
      algebraMap (𝓞 L) L (σ • y) = σ (algebraMap (𝓞 L) L y) :=
    integralClosure.coe_smul σ y
  simpa only [RingOfIntegers.coe_eq_algebraMap, map_prod, map_sub, hsmul] using h

/-- Hilbert's global arithmetic identity for a monogenic ring of integers, at any triviality
witness `n` of the actual global filtration. All nonzero primes are covered in this special case. -/
theorem multiplicity_different_eq_sum_of_monogenic (x : 𝓞 L)
    (hx : Algebra.adjoin ℤ {x} = ⊤) (P : Ideal (𝓞 L)) [P.IsPrime] (hP : P ≠ ⊥)
    {n : ℕ} (hn : GlueConductor.ramGroup L P n = ⊥) :
    multiplicity P (differentIdeal ℤ (𝓞 L)) = ramificationSum L P n := by
  classical
  let := ringOfIntegers_faithfulSMul L
  have hne : ∀ σ ∈ (univ : Finset Gal(L/ℚ)).erase 1,
      Ideal.span {x - σ • x} ≠ (⊥ : Ideal (𝓞 L)) := by
    intro σ hσ hzero
    have hfix : σ • x = x := (sub_eq_zero.mp (Ideal.span_singleton_eq_bot.mp hzero)).symm
    exact (ne_of_mem_erase hσ) (eq_one_of_smul_generator_eq hx hfix)
  rw [differentIdeal_eq_span_displacementProd_of_monogenic L x hx,
    span_singleton_finsetProd, multiplicity_prod_of_ne_bot P hP _ _ hne]
  have hsign : ∀ σ : Gal(L/ℚ),
      Ideal.span {x - σ • x} = Ideal.span {σ • x - x} := by
    intro σ
    rw [← neg_sub, Ideal.span_singleton_neg]
  simp_rw [hsign]
  exact sum_displacementMultiplicity_eq_sum_powerInertiaCard (R := ℤ) P hP hx hn

/-- Precisely proved partial: the main GLOBAL Hilbert conclusion for every nonzero prime in
any Galois number field whose ring of integers is monogenic. The generator is an explicit extra
hypothesis; this theorem does not close `GlueConductor.HilbertDifferentFormula`. -/
theorem hilbertDifferentAt_of_monogenic (x : 𝓞 L) (hx : Algebra.adjoin ℤ {x} = ⊤)
    (P : Ideal (𝓞 L)) [P.IsPrime] (hP : P ≠ ⊥) :
    ∃ n, GlueConductor.ramGroup L P n = ⊥ ∧
      P ^ (ramificationSum L P n) ∣ differentIdeal ℤ (𝓞 L) ∧
      ¬ P ^ (ramificationSum L P n + 1) ∣ differentIdeal ℤ (𝓞 L) := by
  obtain ⟨n, hn⟩ := exists_forall_ramGroup_eq_bot L P
  refine ⟨n, hn n le_rfl, ?_⟩
  exact (multiplicity_different_eq_iff L P hP _).mp
    (multiplicity_different_eq_sum_of_monogenic L x hx P hP (hn n le_rfl))

end ZInQ.Contrib.HilbertDifferent
