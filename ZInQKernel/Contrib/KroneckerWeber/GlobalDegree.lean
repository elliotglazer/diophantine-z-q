/-
Pure global group/degree endpoints for Kronecker–Weber, using only the pinned
Mathlib v4.35.0 libraries and additive global helper modules. This proves no
local Kronecker–Weber theorem and does not assert that inertia bounds or generation
are available for an arbitrary candidate number field.
-/
module

public import ZInQKernel.Contrib.KroneckerWeber.GlobalCyclotomic
public import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
public import Mathlib.Algebra.BigOperators.Group.Finset.Pi

/-!
# Inertia-product cardinality and exact cyclotomic degree squeeze

These are the global algebraic endpoints of Milne, *Class Field Theory* v4.03,
Chapter I, Theorem 4.16 / Lemma 4.17. The actual generating subgroups, their local
cardinality bounds and the cyclotomic-field inclusion remain explicit inputs;
those arithmetic inputs are not established or assumed as hidden facts here.
-/

@[expose] public section

set_option autoImplicit false

namespace ZInQ.Contrib.KroneckerWeber

open scoped IsMulCommutative

section GroupProduct

variable {G : Type*} [Group G] [IsMulCommutative G]
  {ι : Type*} [Fintype ι]

/-- Multiply one element from each of finitely many subgroups of an abelian group.
The map is a genuine homomorphism, not an arbitrary cardinality comparison. -/
noncomputable def subgroupProductMap (I : ι → Subgroup G) : (∀ i, I i) →* G := by
  classical
  exact ∏ i, (I i).subtype.comp (Pi.evalMonoidHom (fun i => I i) i)

/-- If the subgroups generate the whole group, their product map is surjective. -/
theorem subgroupProductMap_surjective (I : ι → Subgroup G) (hI : (⨆ i, I i) = ⊤) :
    Function.Surjective (subgroupProductMap I) := by
  classical
  have hle (i : ι) : I i ≤ (subgroupProductMap I).range := by
    intro x hx
    refine ⟨Pi.mulSingle i ⟨x, hx⟩, ?_⟩
    simp [subgroupProductMap]
    change (∏ j, ((Pi.mulSingle i (⟨x, hx⟩ : I i) : ∀ k, I k) j : G)) = x
    rw [Finset.prod_eq_single i]
    · simp
    · intro j _ hji
      simp [hji]
    · intro hi
      exact False.elim (hi (Finset.mem_univ i))
  apply MonoidHom.range_eq_top.mp
  apply top_unique
  rw [← hI]
  exact iSup_le hle

/-- A finite abelian group generated by `I i` has size at most the product of
the sizes of those actual subgroups. Empty-index families are permitted. -/
theorem card_le_prod_of_subgroup_generation [Finite G]
    (I : ι → Subgroup G) (hI : (⨆ i, I i) = ⊤) :
    Nat.card G ≤ ∏ i, Nat.card (I i) := by
  calc
    Nat.card G ≤ Nat.card (∀ i, I i) :=
      Nat.card_le_card_of_surjective (subgroupProductMap I) (subgroupProductMap_surjective I hI)
    _ = ∏ i, Nat.card (I i) := Nat.card_pi

end GroupProduct

/-- The degree of the actual positive cyclotomic subfield is its Euler totient. -/
theorem finrank_cyclotomicLayer (n : ℕ+) :
    Module.finrank ℚ (cyclotomicLayer n) = (n : ℕ).totient := by
  have : NeZero (n : ℕ) := ⟨n.pos.ne'⟩
  have : IsCyclotomicExtension {(n : ℕ)} ℚ (cyclotomicLayer n) :=
    cyclotomicLayer_isCyclotomic n
  exact IsCyclotomicExtension.finrank (cyclotomicLayer n)
    (Polynomial.cyclotomic.irreducible_rat n.pos)

/-- An actual finite field containing the positive cyclotomic subfield, and having
no larger rational degree, IS that same intermediate field. This is equality in
the given algebraic closure, not just a noncanonical abstract isomorphism. -/
theorem eq_cyclotomicLayer_of_degree_bound
    (E : IntermediateField ℚ (AlgebraicClosure ℚ)) [FiniteDimensional ℚ E]
    (n : ℕ+) (hinc : cyclotomicLayer n ≤ E)
    (hdeg : Module.finrank ℚ E ≤ (n : ℕ).totient) :
    E = cyclotomicLayer n := by
  apply (IntermediateField.eq_of_le_of_finrank_le hinc ?_).symm
  simpa only [finrank_cyclotomicLayer] using hdeg

/-- The exact global degree squeeze, from a generating family of subgroups and
its cardinality bounds. For an inertia application the supplied `I i` must be the
actual global inertia groups; this theorem does not identify arbitrary subgroups
with inertia or infer their bounds from a local theorem name. -/
theorem eq_cyclotomicLayer_of_subgroup_bounds
    (E : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField E]
    [IsAbelianGalois ℚ E] {ι : Type*} [Fintype ι]
    (I : ι → Subgroup (E ≃ₐ[ℚ] E)) (hI : (⨆ i, I i) = ⊤)
    (b : ι → ℕ) (hb : ∀ i, Nat.card (I i) ≤ b i)
    (n : ℕ+) (hinc : cyclotomicLayer n ≤ E)
    (hprod : (∏ i, b i) = (n : ℕ).totient) :
    E = cyclotomicLayer n := by
  have hcard := card_le_prod_of_subgroup_generation I hI
  have hdeg : Module.finrank ℚ E ≤ (n : ℕ).totient := by
    rw [IsGalois.card_aut_eq_finrank] at hcard
    exact hcard.trans (hprod ▸ Finset.prod_le_prod (fun i _ => hb i))
  exact eq_cyclotomicLayer_of_degree_bound E n hinc hdeg

end ZInQ.Contrib.KroneckerWeber
