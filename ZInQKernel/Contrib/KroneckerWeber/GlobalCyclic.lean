/-
Global algebraic reduction for the Kronecker–Weber task, on the unchanged
Mathlib v4.35.0 pin. This additive module does not alter the frozen quadratic
partial contribution and does not assert the unrestricted embedding theorem.
-/
module

public import Mathlib.FieldTheory.Galois.Abelian
public import Mathlib.GroupTheory.FiniteAbelian.Basic
public import Mathlib.NumberTheory.NumberField.Basic

/-!
# Every abelian number field is generated by cyclic subextensions

The input is the full finite-abelian Galois domain, not an exponent-two or radical
presentation. The output fields are actual intermediate fields of the original
`L`, and their supremum is proved to be all of `L`. This is a closed algebraic
reduction; it does not supply the missing arithmetic cyclotomic containment for
arbitrary cyclic extensions and invokes no global/local class-field premise.
-/

public section

set_option autoImplicit false

namespace ZInQ.Contrib.KroneckerWeber

open scoped IsMulCommutative

/-- Every finite abelian number field is a finite compositum of actual cyclic
Galois subextensions. The trivial extension is included (the index family may
be empty). No cyclotomic embedding or radical presentation is assumed. -/
theorem exists_cyclic_subextensions (L : Type*) [Field L] [NumberField L]
    [IsAbelianGalois ℚ L] :
    ∃ (ι : Type) (_ : Fintype ι) (F : ι → IntermediateField ℚ L),
      (∀ i, IsGalois ℚ (F i) ∧ IsCyclic ((F i) ≃ₐ[ℚ] (F i))) ∧
      (⨆ i, F i) = ⊤ := by
  classical
  obtain ⟨ι, hι, n, hn, ⟨e⟩⟩ :=
    CommGroup.equiv_prod_multiplicative_zmod_of_finite (L ≃ₐ[ℚ] L)
  let π (i : ι) : (L ≃ₐ[ℚ] L) →* Multiplicative (ZMod (n i)) :=
    (Pi.evalMonoidHom (fun i => Multiplicative (ZMod (n i))) i).comp e.toMonoidHom
  have hπ (i : ι) : Function.Surjective (π i) := by
    intro x
    exact ⟨e.symm (Pi.mulSingle i x), by simp [π]⟩
  let F (i : ι) : IntermediateField ℚ L := IntermediateField.fixedField (π i).ker
  have hcyc (i : ι) : IsCyclic ((F i) ≃ₐ[ℚ] (F i)) := by
    let eqv : ((F i) ≃ₐ[ℚ] (F i)) ≃* Multiplicative (ZMod (n i)) :=
      (IsGalois.normalAutEquivQuotient (π i).ker).symm.trans
        (QuotientGroup.quotientKerEquivOfSurjective (π i) (hπ i))
    exact isCyclic_of_surjective eqv.symm eqv.symm.surjective
  have hfix : (⨆ i, F i).fixingSubgroup = ⊥ := by
    rw [eq_bot_iff]
    intro σ hσ
    rw [Subgroup.mem_bot]
    apply e.injective
    ext i
    have hσi : σ ∈ (F i).fixingSubgroup :=
      IntermediateField.fixingSubgroup_antitone (le_iSup F i) hσ
    change σ ∈ (IntermediateField.fixedField (π i).ker).fixingSubgroup at hσi
    rw [IntermediateField.fixingSubgroup_fixedField] at hσi
    simpa [π] using (MonoidHom.mem_ker.mp hσi)
  have htop : (⨆ i, F i) = ⊤ := by
    have h := IsGalois.fixedField_fixingSubgroup (⨆ i, F i)
    rw [hfix, IntermediateField.fixedField_bot] at h
    exact h.symm
  exact ⟨ι, hι, F, fun i => ⟨inferInstance, hcyc i⟩, htop⟩

/-- The same algebraic reduction with the literal commutativity hypothesis used
by the full frozen T17 statement. This theorem proves generation, not T17. -/
theorem exists_cyclic_subextensions_of_comm (L : Type*) [Field L] [NumberField L]
    [IsGalois ℚ L] (hcomm : ∀ σ τ : L ≃ₐ[ℚ] L, σ * τ = τ * σ) :
    ∃ (ι : Type) (_ : Fintype ι) (F : ι → IntermediateField ℚ L),
      (∀ i, IsGalois ℚ (F i) ∧ IsCyclic ((F i) ≃ₐ[ℚ] (F i))) ∧
      (⨆ i, F i) = ⊤ := by
  have : IsMulCommutative (L ≃ₐ[ℚ] L) := ⟨⟨hcomm⟩⟩
  have : IsAbelianGalois ℚ L := { }
  exact exists_cyclic_subextensions L

end ZInQ.Contrib.KroneckerWeber
