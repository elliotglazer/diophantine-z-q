module

public import ZInQKernel.Contrib.KroneckerWeber.GlobalUnramified
public import ZInQKernel.Contrib.GlobalDifferentTransport.FixedFieldPrimeInvariants

/-!
# Actual global inertia groups generate the Galois group over `ℚ`

This proves the global step of Milne, *Class Field Theory* v4.03, I Lemma 4.17.
The base is `ℚ`, not a cyclotomic extension. The actual fixed field is used,
its actual integer prime contractions are unramified by the global index tower,
and the global discriminant/Minkowski theorem gives degree one. No local field
model, local character or local Kronecker–Weber theorem is implemented here.

The imported supplier `FixedFieldPrimeInvariants.lean` has SHA-256
`bc7a6f4d625577997a5b0f372165bca00b0cbed9d2d70e410ed82855bab0c60e`
at source revision `11a2303f0a707553465613c75f3124de298c89d0`.
Its nine-module source import closure is pinned separately in the source addendum;
this new application is checked anew rather than borrowing another review's scope.
-/

public section

set_option autoImplicit false

namespace ZInQ.Contrib.KroneckerWeber

open NumberField IntermediateField IsDedekindDomain
open scoped NumberField Pointwise

/-- If the actual inertia subgroup at `P` fixes `M^H`, then the actual prime
contracted to `𝓞(M^H)` has rational ramification index one. The equality follows
from the original and relative inertia cardinalities and the SAME global tower. -/
theorem ramificationIdx_under_fixedField_eq_one_of_inertia_le
    (M : Type*) [Field M] [NumberField M] [IsGalois ℚ M]
    (H : Subgroup Gal(M/ℚ)) (P : Ideal (𝓞 M)) [P.IsPrime]
    (hI : P.inertia Gal(M/ℚ) ≤ H) :
    (P.under (𝓞 ↥(fixedField H))).ramificationIdx ℤ = 1 := by
  let E := fixedField H
  have hcard : Nat.card (P.inertia Gal(M/ℚ)) = P.ramificationIdx ℤ := by
    rw [Ideal.card_inertia_eq_ramificationIdxIn (P.under ℤ) P,
      Ideal.ramificationIdxIn_eq_ramificationIdx (P.under ℤ) P Gal(M/ℚ)]
  have hrel : P.ramificationIdx (𝓞 E) = P.ramificationIdx ℤ := by
    rw [GlobalDifferentTransport.ramificationIdx_fixedField_eq_card_inf M H P,
      inf_eq_left.mpr hI, hcard]
  have hpos : P.ramificationIdx ℤ ≠ 0 := by
    rw [← hcard]
    exact Nat.card_pos.ne'
  have ht := Ideal.ramificationIdx_tower (R := ℤ) (P.under (𝓞 E)) P
  rw [hrel] at ht
  exact (right_eq_mul₀ hpos).mp ht

/-- The subgroup generated by the actual inertia groups at all nonzero primes of
`𝓞 M`, in the original Galois group `Gal(M/ℚ)`. -/
@[expose] noncomputable def globalInertiaSpan (M : Type*) [Field M] [NumberField M] :
    Subgroup Gal(M/ℚ) :=
  ⨆ P : HeightOneSpectrum (𝓞 M), P.asIdeal.inertia Gal(M/ℚ)

/-- The exact defining family, exposed as a theorem for downstream global consumers. -/
theorem globalInertiaSpan_def (M : Type*) [Field M] [NumberField M] :
    globalInertiaSpan M =
      ⨆ P : HeightOneSpectrum (𝓞 M), P.asIdeal.inertia Gal(M/ℚ) := rfl

/-- The fixed field of all global inertia groups is unramified at every actual
maximal ideal of its integer ring. No normality of that fixed field is assumed. -/
theorem globalInertiaSpan_fixedField_unramified
    (M : Type*) [Field M] [NumberField M] [IsGalois ℚ M]
    (Q : Ideal (𝓞 ↥(fixedField (globalInertiaSpan M)))) [Q.IsMaximal] :
    Algebra.IsUnramifiedAt ℤ Q := by
  let H := globalInertiaSpan M
  let E := fixedField H
  have : Module.Finite (𝓞 E) (𝓞 M) := Module.Finite.right ℤ (𝓞 E) (𝓞 M)
  obtain ⟨P, hP, hPQ⟩ := Ideal.exists_maximal_ideal_liesOver_of_isIntegral (S := 𝓞 M) Q
  have : P.IsPrime := hP.isPrime
  have hQ0 : Q ≠ ⊥ := Ideal.IsMaximal.ne_bot_of_isIntegral_int Q
  have hP0 : P ≠ ⊥ := Ideal.ne_bot_of_mem_primesOver hQ0 ⟨hP.isPrime, hPQ⟩
  let v : HeightOneSpectrum (𝓞 M) := ⟨P, hP.isPrime, hP0⟩
  have hI : P.inertia Gal(M/ℚ) ≤ H := le_iSup
    (fun v : HeightOneSpectrum (𝓞 M) => v.asIdeal.inertia Gal(M/ℚ)) v
  have he := ramificationIdx_under_fixedField_eq_one_of_inertia_le M H P hI
  have hunder : P.under (𝓞 E) = Q := hPQ.over.symm
  rw [hunder] at he
  exact Ideal.ramificationIdx_eq_one_iff.mp he

/-- Every finite Galois extension of `ℚ` has its Galois group generated by the
actual global inertia groups. This is a CLOSED global statement, not an assumption
of the generator property and not the local Kronecker–Weber theorem. -/
theorem globalInertiaSpan_eq_top
    (M : Type*) [Field M] [NumberField M] [IsGalois ℚ M] :
    globalInertiaSpan M = ⊤ := by
  let H := globalInertiaSpan M
  let E := fixedField H
  have hdeg : Module.finrank ℚ E = 1 :=
    finrank_eq_one_of_unramified_at_all_integer_maximals E
      (fun Q _ => globalInertiaSpan_fixedField_unramified M Q)
  have he : fixedField H = (⊥ : IntermediateField ℚ M) :=
    IntermediateField.finrank_eq_one_iff.mp hdeg
  have hfix := IntermediateField.fixingSubgroup_fixedField H
  rw [he, IntermediateField.fixingSubgroup_bot] at hfix
  exact hfix.symm

end ZInQ.Contrib.KroneckerWeber
