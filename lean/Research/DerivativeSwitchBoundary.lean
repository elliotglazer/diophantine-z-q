import Mathlib.Algebra.Module.Equiv.Basic
import Mathlib.Tactic.Ring

/-!
# Derivative-switch boundary algebra (independent research module)

This file concerns an abstract characteristic-zero localisation model:
  * F and S are the finite and singular local vector spaces;
  * H is the common strict-complex degree-two cohomology;
  * dF and dS are its connecting maps;
  * J transports finite to singular coordinates;
  * `axesKernel` is the exact relaxed localisation image.

Nothing here constructs an arithmetic Selmer complex, a Poitou--Tate
comparison, a duality-defined functional, or the manuscript's integral
class-functional determinant equality. The proposed identity-on-strict
triangle square is *not* asserted; it is excluded under these hypotheses.

This module is intentionally outside the frozen `ZInQ` module snapshot.
Its Lean 4.35/Mathlib build must be run independently before acceptance.
-/

namespace Research.DerivativeSwitch

variable {K F S H : Type*}
variable [Field K]
variable [AddCommGroup F] [Module K F]
variable [AddCommGroup S] [Module K S]
variable [AddCommGroup H] [Module K H]

/-- The relaxed boundary has exactly the two independent axes generated
by the old finite vector and its transported singular derivative.
This is a *hypothesis* abstracting the manuscript's self-annihilator
argument, not a new proof of its arithmetic occurrence. -/
def AxesKernel
    (dF : F →ₗ[K] H) (dS : S →ₗ[K] H)
    (J : F ≃ₗ[K] S) (v : F) : Prop :=
  ∀ x : F, ∀ y : S,
    dF x + dS y = 0 ↔
      ∃ a b : K, x = a • v ∧ y = b • (J v)

/-- The finite generic kernel is precisely the old class line. -/
theorem finite_kernel_line
    (dF : F →ₗ[K] H) (dS : S →ₗ[K] H)
    (J : F ≃ₗ[K] S) (v : F)
    (hker : AxesKernel dF dS J v) (x : F) :
    dF x = 0 ↔ ∃ a : K, x = a • v := by
  constructor
  · intro hx
    have h : dF x + dS (0 : S) = 0 := by simpa using hx
    obtain ⟨a, _b, ha, _⟩ := (hker x 0).mp h
    exact ⟨a, ha⟩
  · rintro ⟨a, ha⟩
    have h : dF x + dS (0 : S) = 0 :=
      (hker x 0).mpr ⟨a, 0, ha, by simp⟩
    simpa using h

/-- The singular generic kernel is precisely the derivative line. -/
theorem singular_kernel_line
    (dF : F →ₗ[K] H) (dS : S →ₗ[K] H)
    (J : F ≃ₗ[K] S) (v : F)
    (hker : AxesKernel dF dS J v) (y : S) :
    dS y = 0 ↔ ∃ b : K, y = b • (J v) := by
  constructor
  · intro hy
    have h : dF (0 : F) + dS y = 0 := by simpa using hy
    obtain ⟨_a, b, _, hb⟩ := (hker 0 y).mp h
    exact ⟨b, hb⟩
  · rintro ⟨b, hb⟩
    have h : dF (0 : F) + dS y = 0 :=
      (hker 0 y).mpr ⟨0, b, by simp, hb⟩
    simpa using h

/-- The two strict boundary images meet only in zero.
This is stronger than merely knowing both generic kernels have rank one. -/
theorem boundary_images_meet_zero
    (dF : F →ₗ[K] H) (dS : S →ₗ[K] H)
    (J : F ≃ₗ[K] S) (v : F)
    (hker : AxesKernel dF dS J v)
    (x : F) (y : S) (heq : dF x = dS y) :
    dF x = 0 ∧ dS y = 0 := by
  have hz : dF x + dS (-y) = 0 := by
    calc
      dF x + dS (-y) = dS y + -(dS y) := by rw [heq, map_neg]
      _ = 0 := add_neg_cancel _
  obtain ⟨a, _b, ha, _hb⟩ := (hker x (-y)).mp hz
  have hfx : dF x = 0 := (finite_kernel_line dF dS J v hker x).mpr ⟨a, ha⟩
  exact ⟨hfx, heq ▸ hfx⟩

/-- If F is not generated by v, there is no morphism of connecting
maps that is the identity on the strict cohomology and J on the quotient.
In particular this rules out the proposed identity-on-strict triangle
square without asserting any generic rank drop. -/
theorem no_identity_strict_square
    (dF : F →ₗ[K] H) (dS : S →ₗ[K] H)
    (J : F ≃ₗ[K] S) (v : F)
    (hker : AxesKernel dF dS J v)
    (hout : ∃ x : F, ∀ a : K, x ≠ a • v) :
    ¬ ∀ x : F, dF x = dS (J x) := by
  intro hcomm
  obtain ⟨x, hx⟩ := hout
  have hz : dF x + dS (-(J x)) = 0 := by
    calc
      dF x + dS (-(J x)) = dS (J x) + -(dS (J x)) := by
        rw [hcomm x, map_neg]
      _ = 0 := add_neg_cancel _
  obtain ⟨a, _b, ha, _hb⟩ := (hker x (-(J x))).mp hz
  exact hx a ha

end Research.DerivativeSwitch

namespace Research.DerivativeSwitch.Volume

variable {R : Type*} [CommRing R]

/-- Signed exterior volume for two column vectors. -/
def area (v w : R × R) : R := v.1 * w.2 - v.2 * w.1

/-- A general integral two-by-two local change of coordinates. -/
def action (a b c d : R) (v : R × R) : R × R :=
  (a * v.1 + b * v.2, c * v.1 + d * v.2)

/-- Exterior volume transforms by the *actual* matrix determinant,
with no assumption that the input vectors are primitive. -/
theorem area_action (a b c d : R) (v w : R × R) :
    area (action a b c d v) (action a b c d w) =
      (a * d - b * c) * area v w := by
  dsimp [area, action]
  ring

/-- In particular, a local conjugation matrix of determinant -1
preserves unit volume up to the integral unit -1. -/
theorem area_neg_one
    (a b c d : R) (v w : R × R)
    (hdet : a * d - b * c = -1)
    (hvol : area v w = 1) :
    area (action a b c d v) (action a b c d w) = -1 := by
  rw [area_action, hdet, hvol]
  ring

end Research.DerivativeSwitch.Volume
