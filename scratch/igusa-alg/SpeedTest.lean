import Mathlib

namespace IgusaAlgEval

/-- Polynomial expressions in four variables with integer coefficients. -/
inductive PE : Type
  | v (i : Fin 4)
  | c (n : ℤ)
  | add (a b : PE)
  | mul (a b : PE)
  | pow (a : PE) (n : ℕ)

/-- Evaluation of a `PE` in a commutative ring. -/
def PE.eval {R : Type*} [CommRing R] (s0 s1 s2 s3 : R) : PE → R
  | .v i => if i.val = 0 then s0 else if i.val = 1 then s1 else if i.val = 2 then s2 else s3
  | .c n => (n : R)
  | .add a b => a.eval s0 s1 s2 s3 + b.eval s0 s1 s2 s3
  | .mul a b => a.eval s0 s1 s2 s3 * b.eval s0 s1 s2 s3
  | .pow a n => a.eval s0 s1 s2 s3 ^ n

/-- `e_k` of a list of blocks `(q, r)`, each contributing `1 + qX + rX²`, as the coefficient list
`[e₀, …, e_K]` (fold). -/
def blkStep {R : Type*} [CommRing R] (q r : R) : List R → R → R → List R
  | [], _, _ => []
  | a :: l, p1, p2 => (a + q * p1 + r * p2) :: blkStep q r l a p1

def esymmV {R : Type*} [CommRing R] : List (R × R) → List R → List R
  | [], v => v
  | (q, r) :: l, v => esymmV l (blkStep q r v 0 0)

