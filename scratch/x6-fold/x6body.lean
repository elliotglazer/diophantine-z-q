/-! # shimura-glue: Möbius transformations of maps to `P¹` (the glue `MobiusCompose`, proved)

For `π : X → P¹` given by charts (the kernel's `ToP1`), three constructions:
* `ToP1.translate π b` (`t ↦ t + b`, `b ∈ Γ(X, ⊤)`): the chart `V` is replaced by the union of
  `{f + b invertible} ⊆ U` and `{1 + bg invertible} ⊆ V`, with `1/(t + b)` glued from `(f + b)⁻¹` and
  `g (1 + bg)⁻¹` (`TopCat.Sheaf.objSupIsoProdEqLocus`);
* `ToP1.scale π a` (`t ↦ a t`, `a ∈ Γ(X, ⊤)ˣ`);
* `ToP1.swap π` (`t ↦ 1/t`).
Their values on field points are computed (`val_translate`, `val_scale`, `val_swap`), and `GL₂(ℚ)` is
generated by the corresponding matrices and the scalars, which gives `MobiusCompose`. -/

namespace ShimuraGlue.Mob

open CategoryTheory AlgebraicGeometry Limits Opposite TopologicalSpace
open LeafQM.AV

variable {X : Scheme.{0}}

theorem res_res {U V W : X.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (f : Γ(X, U)) :
    X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op f) =
      X.presheaf.map (homOfLE (h2.trans h1)).op f := by
  simp only [← CommRingCat.comp_apply, ← Functor.map_comp, ← op_comp, homOfLE_comp]

theorem eval_res' {U U' : X.Opens} (h : U' ≤ U) (x : X) (hx : x ∈ U') (f : Γ(X, U)) :
    X.evaluation U' x hx (X.presheaf.map (homOfLE h).op f) = X.evaluation U x (h hx) f := by
  simp only [Scheme.evaluation, CommRingCat.comp_apply]
  rw [TopCat.Presheaf.germ_res_apply]

/-- A global section, restricted to `U`. -/
def onU (b : Γ(X, ⊤)) (U : X.Opens) : Γ(X, U) := X.presheaf.map (homOfLE le_top).op b

theorem onU_res (b : Γ(X, ⊤)) {U V : X.Opens} (h : V ≤ U) :
    X.presheaf.map (homOfLE h).op (onU b U) = onU b V := by
  rw [onU, res_res]; rfl

theorem eval_onU (b : Γ(X, ⊤)) (U : X.Opens) (x : X) (hx : x ∈ U) :
    X.evaluation U x hx (onU b U) = X.evaluation ⊤ x trivial b := eval_res' _ _ _ _

/-- The inverse relation of a `ToP1`, restricted to any `O ≤ U ⊓ V`. -/
theorem inv_res (π : ToP1 X) {O : X.Opens} (hO : O ≤ π.U ⊓ π.V) :
    X.presheaf.map (homOfLE (hO.trans inf_le_left)).op π.f *
      X.presheaf.map (homOfLE (hO.trans inf_le_right)).op π.g = 1 := by
  have := congrArg (X.presheaf.map (homOfLE hO).op) π.inv
  rw [map_mul, map_one, res_res, res_res] at this
  exact this

/-! ## The translation `t ↦ t + b` -/

section Translate

variable (π : ToP1 X) (b : Γ(X, ⊤))

/-- `f + b` on `U`. -/
def fT : Γ(X, π.U) := π.f + onU b π.U

/-- `1 + b g` on `V`. -/
def hT : Γ(X, π.V) := 1 + onU b π.V * π.g

/-- `{f + b invertible} ⊆ U`. -/
def W₁ : X.Opens := X.basicOpen (fT π b)

/-- `{1 + bg invertible} ⊆ V`. -/
def W₂ : X.Opens := X.basicOpen (hT π b)

theorem W₁_le : W₁ π b ≤ π.U := X.basicOpen_le _
theorem W₂_le : W₂ π b ≤ π.V := X.basicOpen_le _

theorem isUnit₁ : IsUnit (X.presheaf.map (homOfLE (W₁_le π b)).op (fT π b)) :=
  X.toRingedSpace.isUnit_res_basicOpen (fT π b)

theorem isUnit₂ : IsUnit (X.presheaf.map (homOfLE (W₂_le π b)).op (hT π b)) :=
  X.toRingedSpace.isUnit_res_basicOpen (hT π b)

/-- `(f + b)⁻¹` on `W₁`. -/
def s₁ : Γ(X, W₁ π b) := ↑(isUnit₁ π b).unit⁻¹

/-- `g (1 + bg)⁻¹` on `W₂`. -/
def s₂ : Γ(X, W₂ π b) :=
  X.presheaf.map (homOfLE (W₂_le π b)).op π.g * ↑(isUnit₂ π b).unit⁻¹

theorem fT_mul_s₁ : X.presheaf.map (homOfLE (W₁_le π b)).op (fT π b) * s₁ π b = 1 :=
  (isUnit₁ π b).mul_val_inv

theorem hT_mul_inv :
    X.presheaf.map (homOfLE (W₂_le π b)).op (hT π b) * ↑(isUnit₂ π b).unit⁻¹ = 1 :=
  (isUnit₂ π b).mul_val_inv

/-- Restricting a relation `a * s = 1`. -/
theorem res_inv_rel {W O : X.Opens} (h : O ≤ W) {a s : Γ(X, W)} (has : a * s = 1) :
    X.presheaf.map (homOfLE h).op a * X.presheaf.map (homOfLE h).op s = 1 := by
  rw [← map_mul, has, map_one]

theorem uniq_inv {R : Type*} [CommRing R] {u s t : R} (hs : u * s = 1) (ht : u * t = 1) : s = t := by
  calc s = s * (u * t) := by rw [ht, mul_one]
    _ = (u * s) * t := by ring
    _ = t := by rw [hs, one_mul]

theorem W₁₂_le : W₁ π b ⊓ W₂ π b ≤ π.U ⊓ π.V :=
  inf_le_inf (W₁_le π b) (W₂_le π b)

/-- The two local expressions of `1/(t + b)` agree on `W₁ ⊓ W₂`. -/
theorem s_agree :
    X.presheaf.map (homOfLE (inf_le_left : W₁ π b ⊓ W₂ π b ≤ W₁ π b)).op (s₁ π b) =
      X.presheaf.map (homOfLE (inf_le_right : W₁ π b ⊓ W₂ π b ≤ W₂ π b)).op (s₂ π b) := by
  set O := W₁ π b ⊓ W₂ π b
  have hOU : O ≤ π.U := (W₁₂_le π b).trans inf_le_left
  have hOV : O ≤ π.V := (W₁₂_le π b).trans inf_le_right
  set F := X.presheaf.map (homOfLE hOU).op π.f
  set G := X.presheaf.map (homOfLE hOV).op π.g
  set B : Γ(X, O) := onU b O
  have hFG : F * G = 1 := inv_res π (W₁₂_le π b)
  -- `(f + b)|O * s₁|O = 1`
  have h1 := res_inv_rel (inf_le_left : O ≤ W₁ π b) (fT_mul_s₁ π b)
  rw [res_res] at h1
  have e1 : X.presheaf.map (homOfLE ((inf_le_left : O ≤ W₁ π b).trans (W₁_le π b))).op (fT π b) =
      F + B := by
    rw [fT, map_add, onU_res]
  rw [e1] at h1
  -- `(1 + bg)|O * (1 + bg)⁻¹|O = 1`
  have h2 := res_inv_rel (inf_le_right : O ≤ W₂ π b) (hT_mul_inv π b)
  rw [res_res] at h2
  have e2 : X.presheaf.map (homOfLE ((inf_le_right : O ≤ W₂ π b).trans (W₂_le π b))).op (hT π b) =
      1 + B * G := by
    rw [hT, map_add, map_one, map_mul, onU_res]
  rw [e2] at h2
  apply uniq_inv h1
  rw [s₂, map_mul, res_res]
  change (F + B) * (G * _) = 1
  calc (F + B) * (G * X.presheaf.map (homOfLE (inf_le_right : O ≤ W₂ π b)).op
          ↑(isUnit₂ π b).unit⁻¹)
      = (F * G + B * G) * X.presheaf.map (homOfLE (inf_le_right : O ≤ W₂ π b)).op
          ↑(isUnit₂ π b).unit⁻¹ := by ring
    _ = 1 := by rw [hFG]; exact h2

/-- `1/(t + b)` on `W₁ ⊔ W₂`, glued. -/
def gT : Γ(X, W₁ π b ⊔ W₂ π b) :=
  (X.sheaf.objSupIsoProdEqLocus (W₁ π b) (W₂ π b)).inv ⟨(s₁ π b, s₂ π b), s_agree π b⟩

theorem gT_res₁ : X.presheaf.map (homOfLE (le_sup_left : W₁ π b ≤ W₁ π b ⊔ W₂ π b)).op (gT π b) =
    s₁ π b :=
  TopCat.Sheaf.objSupIsoProdEqLocus_inv_fst X.sheaf _ _ _

theorem gT_res₂ : X.presheaf.map (homOfLE (le_sup_right : W₂ π b ≤ W₁ π b ⊔ W₂ π b)).op (gT π b) =
    s₂ π b :=
  TopCat.Sheaf.objSupIsoProdEqLocus_inv_snd X.sheaf _ _ _

theorem eval_fT (x : X) (hx : x ∈ π.U) :
    X.evaluation π.U x hx (fT π b) =
      X.evaluation π.U x hx π.f + X.evaluation ⊤ x trivial b := by
  rw [fT, map_add, eval_onU]

theorem eval_hT (x : X) (hx : x ∈ π.V) :
    X.evaluation π.V x hx (hT π b) =
      1 + X.evaluation ⊤ x trivial b * X.evaluation π.V x hx π.g := by
  rw [hT, map_add, map_one, map_mul, eval_onU]

/-- Pointwise: at `x ∈ U ⊓ V`, `f(x) g(x) = 1`. -/
theorem eval_fg (x : X) (hU : x ∈ π.U) (hV : x ∈ π.V) :
    X.evaluation π.U x hU π.f * X.evaluation π.V x hV π.g = 1 := by
  have := congrArg (X.evaluation (π.U ⊓ π.V) x ⟨hU, hV⟩) π.inv
  rw [map_mul, map_one] at this
  have e1 := eval_res' (inf_le_left : π.U ⊓ π.V ≤ π.U) x ⟨hU, hV⟩ π.f
  have e2 := eval_res' (inf_le_right : π.U ⊓ π.V ≤ π.V) x ⟨hU, hV⟩ π.g
  rw [e1, e2] at this
  exact this

theorem mem_W₁_iff (x : X) (hx : x ∈ π.U) :
    x ∈ W₁ π b ↔ X.evaluation π.U x hx π.f + X.evaluation ⊤ x trivial b ≠ 0 := by
  rw [W₁, ← Scheme.evaluation_ne_zero_iff_mem_basicOpen X x hx, eval_fT]

theorem mem_W₂_iff (x : X) (hx : x ∈ π.V) :
    x ∈ W₂ π b ↔ 1 + X.evaluation ⊤ x trivial b * X.evaluation π.V x hx π.g ≠ 0 := by
  rw [W₂, ← Scheme.evaluation_ne_zero_iff_mem_basicOpen X x hx, eval_hT]

theorem g_eval_eq_zero (x : X) (hV : x ∈ π.V) (hU : x ∉ π.U) :
    X.evaluation π.V x hV π.g = 0 := by
  rw [Scheme.evaluation_eq_zero_iff_notMem_basicOpen, π.basicOpen_g]
  exact fun h => hU h.1

/-- `U ⊓ W₂ ≤ W₁`. -/
theorem U_inf_W₂_le : π.U ⊓ W₂ π b ≤ W₁ π b := by
  intro x hx
  have hU : x ∈ π.U := hx.1
  have h2 : x ∈ W₂ π b := hx.2
  show x ∈ W₁ π b
  have hV := W₂_le π b h2
  rw [mem_W₂_iff π b x hV] at h2
  rw [mem_W₁_iff π b x hU]
  intro h0
  apply h2
  have hfg := eval_fg π x hU hV
  linear_combination (X.evaluation π.V x hV π.g) * h0 - hfg

theorem U_inf_V' : π.U ⊓ (W₁ π b ⊔ W₂ π b) = W₁ π b := by
  apply le_antisymm
  · rw [inf_sup_left]
    exact sup_le inf_le_right (U_inf_W₂_le π b)
  · exact le_inf (W₁_le π b) le_sup_left

/-- **The translate `t ↦ t + b` of `π`.** -/
def ToP1.translate : ToP1 X where
  U := π.U
  V := W₁ π b ⊔ W₂ π b
  cover := by
    apply le_antisymm le_top
    intro x _
    by_cases hU : x ∈ π.U
    · exact Or.inl hU
    · have hV : x ∈ π.V := by
        have : x ∈ π.U ⊔ π.V := by rw [π.cover]; trivial
        exact this.resolve_left hU
      refine Or.inr (Or.inr ?_)
      show x ∈ W₂ π b
      rw [mem_W₂_iff π b x hV, g_eval_eq_zero π x hV hU, mul_zero, add_zero]
      exact one_ne_zero
  f := fT π b
  g := gT π b
  inv := by
    -- check on the cover `W₁`, `U ⊓ W₂` of `U ⊓ V' = W₁`
    have key : X.presheaf.map (homOfLE (inf_le_left : π.U ⊓ (W₁ π b ⊔ W₂ π b) ≤ π.U)).op (fT π b) *
        X.presheaf.map (homOfLE (inf_le_right : π.U ⊓ (W₁ π b ⊔ W₂ π b) ≤ W₁ π b ⊔ W₂ π b)).op
          (gT π b) = 1 := by
      have hW : π.U ⊓ (W₁ π b ⊔ W₂ π b) ≤ W₁ π b := (U_inf_V' π b).le
      have hW' : W₁ π b ≤ π.U ⊓ (W₁ π b ⊔ W₂ π b) := (U_inf_V' π b).ge
      apply X.sheaf.eq_of_locally_eq₂ (homOfLE hW') (homOfLE hW') (by rw [sup_idem]; exact hW)
      all_goals
        change X.presheaf.map _ (_ * _) = X.presheaf.map _ 1
        rw [map_mul, map_one, res_res, res_res]
        rw [show X.presheaf.map (homOfLE (le_trans hW' inf_le_right)).op (gT π b) =
            X.presheaf.map (homOfLE (le_sup_left : W₁ π b ≤ W₁ π b ⊔ W₂ π b)).op (gT π b) from rfl,
          gT_res₁]
        exact fT_mul_s₁ π b
    exact key
  basicOpen_f := (U_inf_V' π b).symm
  basicOpen_g := by
    rw [U_inf_V']
    apply le_antisymm
    · intro x hx
      have hxV : x ∈ W₁ π b ⊔ W₂ π b := X.basicOpen_le _ hx
      show x ∈ W₁ π b
      by_cases h1 : x ∈ W₁ π b
      · exact h1
      · have h2 : x ∈ W₂ π b := (Opens.mem_sup.1 hxV).resolve_left h1
        -- on `W₂`, `g' = g (1 + bg)⁻¹`, nonzero only on `U`
        have hev := (Scheme.evaluation_ne_zero_iff_mem_basicOpen X x hxV (gT π b)).2 hx
        rw [← eval_res' (le_sup_right : W₂ π b ≤ W₁ π b ⊔ W₂ π b) x h2, gT_res₂, s₂, map_mul,
          eval_res'] at hev
        have hV := W₂_le π b h2
        by_cases hU : x ∈ π.U
        · exact U_inf_W₂_le π b ⟨hU, h2⟩
        · rw [g_eval_eq_zero π x hV hU, zero_mul] at hev
          exact absurd rfl hev
    · intro x h1
      have h1 : x ∈ W₁ π b := h1
      show x ∈ X.basicOpen (gT π b)
      have hxV : x ∈ W₁ π b ⊔ W₂ π b := Opens.mem_sup.2 (Or.inl h1)
      rw [← Scheme.evaluation_ne_zero_iff_mem_basicOpen X x hxV,
        ← eval_res' (le_sup_left : W₁ π b ≤ W₁ π b ⊔ W₂ π b) x h1, gT_res₁]
      intro h0
      have := congrArg (X.evaluation (W₁ π b) x h1) (fT_mul_s₁ π b)
      rw [map_mul, map_one, h0, mul_zero] at this
      exact zero_ne_one this

end Translate

/-! ## The scaling `t ↦ a t` and the inversion `t ↦ 1/t` -/

section ScaleSwap

variable (π : ToP1 X)

/-- **The scaling `t ↦ a t`** by a unit `a ∈ Γ(X, ⊤)ˣ`. -/
def ToP1.scale (a : Γ(X, ⊤)ˣ) : ToP1 X where
  U := π.U
  V := π.V
  cover := π.cover
  f := onU (a : Γ(X, ⊤)) π.U * π.f
  g := onU (↑a⁻¹ : Γ(X, ⊤)) π.V * π.g
  inv := by
    rw [map_mul, map_mul, onU_res, onU_res]
    calc onU (a : Γ(X, ⊤)) (π.U ⊓ π.V) * X.presheaf.map (homOfLE inf_le_left).op π.f *
          (onU (↑a⁻¹ : Γ(X, ⊤)) (π.U ⊓ π.V) * X.presheaf.map (homOfLE inf_le_right).op π.g)
        = (onU (a : Γ(X, ⊤)) (π.U ⊓ π.V) * onU (↑a⁻¹ : Γ(X, ⊤)) (π.U ⊓ π.V)) *
          (X.presheaf.map (homOfLE inf_le_left).op π.f *
            X.presheaf.map (homOfLE inf_le_right).op π.g) := by ring
      _ = 1 := by
        rw [π.inv, mul_one, onU, onU, ← map_mul, Units.mul_inv, map_one]
  basicOpen_f := by
    have hu : IsUnit (onU (a : Γ(X, ⊤)) π.U) := a.isUnit.map (X.presheaf.map (homOfLE le_top).op).hom
    rw [Scheme.basicOpen_mul, X.basicOpen_of_isUnit hu, π.basicOpen_f,
      inf_eq_right.2 inf_le_left]
  basicOpen_g := by
    have hu : IsUnit (onU (↑a⁻¹ : Γ(X, ⊤)) π.V) :=
      a⁻¹.isUnit.map (X.presheaf.map (homOfLE le_top).op).hom
    rw [Scheme.basicOpen_mul, X.basicOpen_of_isUnit hu, π.basicOpen_g,
      inf_eq_right.2 inf_le_right]

/-- **The inversion `t ↦ 1/t`**: the two charts exchanged. -/
def ToP1.swap : ToP1 X where
  U := π.V
  V := π.U
  cover := by rw [sup_comm]; exact π.cover
  f := π.g
  g := π.f
  inv := by
    have := π.inv
    have e1 : (π.V ⊓ π.U : X.Opens) = π.U ⊓ π.V := inf_comm _ _
    -- transport along `V ⊓ U = U ⊓ V`
    have key : ∀ (O : X.Opens) (hO : O = π.U ⊓ π.V) (h1 : O ≤ π.V) (h2 : O ≤ π.U),
        X.presheaf.map (homOfLE h1).op π.g * X.presheaf.map (homOfLE h2).op π.f = 1 := by
      intro O hO h1 h2; subst hO; rw [mul_comm]; exact this
    exact key _ e1 _ _
  basicOpen_f := by rw [π.basicOpen_g, inf_comm]
  basicOpen_g := by rw [π.basicOpen_f, inf_comm]

end ScaleSwap

/-! ## Values on field points -/

section Values

variable {K : Type} [Field K] (π : ToP1 X) (y : Spec (CommRingCat.of K) ⟶ X)

/-- The value at `y` of a global section. -/
def gval (b : Γ(X, ⊤)) : K :=
  (Scheme.SpecToEquivOfField K X y).2 (X.evaluation ⊤ (Scheme.SpecToEquivOfField K X y).1 trivial b)

theorem val_translate (b : Γ(X, ⊤)) :
    (ToP1.translate π b).val y = OnePoint.map (fun z => z + gval y b) (π.val y) := by
  by_cases h : (Scheme.SpecToEquivOfField K X y).1 ∈ π.U
  · have h' : (Scheme.SpecToEquivOfField K X y).1 ∈ (ToP1.translate π b).U := h
    unfold ToP1.val
    rw [dif_pos h', dif_pos h, OnePoint.map_some]
    congr 1
    change (Scheme.SpecToEquivOfField K X y).2 (X.evaluation π.U _ h (fT π b)) = _
    rw [eval_fT, map_add]; rfl
  · have h' : (Scheme.SpecToEquivOfField K X y).1 ∉ (ToP1.translate π b).U := h
    unfold ToP1.val
    rw [dif_neg h', dif_neg h]; rfl

theorem val_scale (a : Γ(X, ⊤)ˣ) :
    (ToP1.scale π a).val y = OnePoint.map (fun z => gval y (a : Γ(X, ⊤)) * z) (π.val y) := by
  by_cases h : (Scheme.SpecToEquivOfField K X y).1 ∈ π.U
  · have h' : (Scheme.SpecToEquivOfField K X y).1 ∈ (ToP1.scale π a).U := h
    unfold ToP1.val
    rw [dif_pos h', dif_pos h, OnePoint.map_some]
    congr 1
    change (Scheme.SpecToEquivOfField K X y).2
      (X.evaluation π.U _ h (onU (a : Γ(X, ⊤)) π.U * π.f)) = _
    rw [map_mul, map_mul, eval_onU]; rfl
  · have h' : (Scheme.SpecToEquivOfField K X y).1 ∉ (ToP1.scale π a).U := h
    unfold ToP1.val
    rw [dif_neg h', dif_neg h]; rfl

open Classical in
/-- `t ↦ 1/t` on `P¹(K)`. -/
def invP1 : OnePoint K → OnePoint K
  | OnePoint.infty => OnePoint.some 0
  | OnePoint.some z => if z = 0 then OnePoint.infty else OnePoint.some z⁻¹

theorem val_swap : (ToP1.swap π).val y = invP1 (π.val y) := by
  set p := (Scheme.SpecToEquivOfField K X y).1 with hp
  set ι := (Scheme.SpecToEquivOfField K X y).2 with hι
  by_cases hV : p ∈ π.V <;> by_cases hU : p ∈ π.U
  · have hV' : p ∈ (ToP1.swap π).U := hV
    unfold ToP1.val
    rw [dif_pos hV', dif_pos hU]
    have hfg := congrArg ι (eval_fg π p hU hV)
    rw [map_mul, map_one] at hfg
    have hf0 : ι (X.evaluation π.U p hU π.f) ≠ 0 := left_ne_zero_of_mul_eq_one hfg
    simp only [invP1]
    rw [if_neg hf0]
    congr 1
    change ι (X.evaluation π.V p hV π.g) = _
    exact eq_inv_of_mul_eq_one_left (by rw [mul_comm]; exact hfg)
  · have hV' : p ∈ (ToP1.swap π).U := hV
    unfold ToP1.val
    rw [dif_pos hV', dif_neg hU]
    simp only [invP1]
    congr 1
    change ι (X.evaluation π.V p hV π.g) = 0
    rw [g_eval_eq_zero π p hV hU, map_zero]
  · have hV' : p ∉ (ToP1.swap π).U := hV
    unfold ToP1.val
    rw [dif_neg hV', dif_pos hU]
    have hf : X.evaluation π.U p hU π.f = 0 := by
      rw [Scheme.evaluation_eq_zero_iff_notMem_basicOpen, π.basicOpen_f]
      exact fun h => hV h.2
    simp only [invP1]
    rw [hf, map_zero, if_pos rfl]
  · exfalso
    have : p ∈ π.U ⊔ π.V := by rw [π.cover]; trivial
    exact (Opens.mem_sup.1 this).elim hU hV

end Values

/-! ## `GL₂(ℚ)` -/

open scoped Classical

/-- The constants `ℚ → Γ(X, ⊤)` of a `ℚ`-scheme. -/
def cQ (X : Over (Spec (CommRingCat.of ℚ))) : ℚ →+* Γ(X.left, ⊤) :=
  X.hom.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of ℚ)).inv.hom

theorem gval_cQ (X : Over (Spec (CommRingCat.of ℚ))) {K : Type} [Field K] [CharZero K]
    (y : Spec (CommRingCat.of K) ⟶ X.left) (q : ℚ) : gval y (cQ X q) = (q : K) :=
  eq_ratCast (((Scheme.SpecToEquivOfField K X.left y).2.hom.comp
    (X.left.evaluation ⊤ (Scheme.SpecToEquivOfField K X.left y).1 trivial).hom).comp (cQ X)) q

/-- `!![a, b; c, d]` as an element of `GL₂(ℚ)`. -/
noncomputable def gl2 (a b c d : ℚ) (h : a * d - b * c ≠ 0) : GL (Fin 2) ℚ :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero !![a, b; c, d] (by rwa [Matrix.det_fin_two_of])

theorem gl2_apply (a b c d : ℚ) (h : a * d - b * c ≠ 0) (i j : Fin 2) :
    (gl2 a b c d h) i j = !![a, b; c, d] i j := rfl

theorem gl2_smul_some (a b c d : ℚ) (h : a * d - b * c ≠ 0) (k : ℚ) :
    gl2 a b c d h • (k : OnePoint ℚ) =
      if c * k + d = 0 then OnePoint.infty else ((a * k + b) / (c * k + d) : ℚ) := by
  rw [OnePoint.smul_some_eq_ite]; simp [gl2_apply]

theorem gl2_smul_infty (a b c d : ℚ) (h : a * d - b * c ≠ 0) :
    gl2 a b c d h • (OnePoint.infty : OnePoint ℚ) =
      if c = 0 then OnePoint.infty else ((a / c : ℚ) : OnePoint ℚ) := by
  rw [OnePoint.smul_infty_eq_ite]; simp [gl2_apply]

/-- `g` is realized on every `ToP1` of every `ℚ`-scheme. -/
def Good (g : GL (Fin 2) ℚ) : Prop :=
  ∀ (X : Over (Spec (CommRingCat.of ℚ))) (π : ToP1 X.left),
    ∃ π' : ToP1 X.left, ∀ x : fieldPt Qbar ⟶ X,
      π'.val (K := Qbar) x.left =
        Matrix.GeneralLinearGroup.map (algebraMap ℚ Qbar) g • π.val (K := Qbar) x.left

theorem good_mul {g h : GL (Fin 2) ℚ} (hg : Good g) (hh : Good h) : Good (g * h) := by
  intro X π
  obtain ⟨π₁, h₁⟩ := hh X π
  obtain ⟨π₂, h₂⟩ := hg X π₁
  exact ⟨π₂, fun x => by rw [h₂, h₁, ← mul_smul, ← map_mul]⟩

/-- The action of the image of `gl2 a b c d` on `P¹(ℚ̄)`. -/
theorem map_gl2_smul (a b c d : ℚ) (h : a * d - b * c ≠ 0) (s : OnePoint Qbar) :
    Matrix.GeneralLinearGroup.map (algebraMap ℚ Qbar) (gl2 a b c d h) • s =
      match s with
      | OnePoint.infty => if (c : Qbar) = 0 then OnePoint.infty else (((a : Qbar) / c : Qbar) : OnePoint Qbar)
      | OnePoint.some k => if (c : Qbar) * k + d = 0 then OnePoint.infty
          else (((a : Qbar) * k + b) / ((c : Qbar) * k + d) : Qbar) := by
  induction s using OnePoint.rec with
  | infty =>
    rw [OnePoint.smul_infty_eq_ite]
    simp [Matrix.GeneralLinearGroup.map_apply, gl2_apply, eq_ratCast]
  | coe k =>
    rw [OnePoint.smul_some_eq_ite]
    simp [Matrix.GeneralLinearGroup.map_apply, gl2_apply, eq_ratCast]

theorem good_T (q : ℚ) : Good (gl2 1 q 0 1 (by norm_num)) := by
  intro X π
  refine ⟨ToP1.translate π (cQ X q), fun x => ?_⟩
  refine (val_translate (K := Qbar) π x.left (cQ X q)).trans ?_
  have hq : gval (K := Qbar) x.left (cQ X q) = (q : Qbar) := gval_cQ X x.left q
  rw [hq, map_gl2_smul]
  induction π.val (K := Qbar) x.left using OnePoint.rec with
  | infty => simp
  | coe k => simp

theorem good_D (a : ℚ) (ha : a ≠ 0) : Good (gl2 a 0 0 1 (by simpa using ha)) := by
  intro X π
  refine ⟨ToP1.scale π (Units.map (cQ X).toMonoidHom (Units.mk0 a ha)), fun x => ?_⟩
  refine (val_scale (K := Qbar) π x.left _).trans ?_
  have : gval (K := Qbar) x.left ((Units.map (cQ X).toMonoidHom (Units.mk0 a ha) : Γ(X.left, ⊤)ˣ) :
      Γ(X.left, ⊤)) = (a : Qbar) := gval_cQ X x.left a
  rw [this, map_gl2_smul]
  induction π.val (K := Qbar) x.left using OnePoint.rec with
  | infty => simp
  | coe k => simp

theorem good_W : Good (gl2 0 1 1 0 (by norm_num)) := by
  intro X π
  refine ⟨ToP1.swap π, fun x => ?_⟩
  refine (val_swap (K := Qbar) π x.left).trans ?_
  rw [map_gl2_smul]
  induction π.val (K := Qbar) x.left using OnePoint.rec with
  | infty => simp [invP1]
  | coe k =>
    simp only [invP1]
    split_ifs with hk <;> simp_all

theorem good_Sc (d : ℚ) (hd : d ≠ 0) : Good (gl2 d 0 0 d (by simpa using hd)) := by
  intro X π
  refine ⟨π, fun x => ?_⟩
  rw [map_gl2_smul]
  have hd' : (d : Qbar) ≠ 0 := by exact_mod_cast hd
  induction π.val (K := Qbar) x.left using OnePoint.rec with
  | infty => simp
  | coe k => simp [hd']; try field_simp

/-- **Every `g ∈ GL₂(ℚ)` is realized** (`g = d·T(b/d)·D(a/d)` if `c = 0`, and
`g = T(a/c)·D(−det/c)·W·T(d)·D(c)` otherwise). -/
theorem good_all (g : GL (Fin 2) ℚ) : Good g := by
  have hdet := g.det_ne_zero
  rw [Matrix.det_fin_two] at hdet
  by_cases hc : g 1 0 = 0
  · rw [hc, mul_zero, sub_zero] at hdet
    have ha : g 0 0 ≠ 0 := left_ne_zero_of_mul hdet
    have hd : g 1 1 ≠ 0 := right_ne_zero_of_mul hdet
    have e : g = gl2 (g 1 1) 0 0 (g 1 1) (by simpa using hd) * gl2 1 (g 0 1 / g 1 1) 0 1 (by norm_num) *
        gl2 (g 0 0 / g 1 1) 0 0 1 (by simpa using div_ne_zero ha hd) := by
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [Matrix.mul_apply, Fin.sum_univ_two, gl2_apply, hc] <;> field_simp
    rw [e]
    exact good_mul (good_mul (good_Sc _ hd) (good_T _)) (good_D _ (div_ne_zero ha hd))
  · set dt := g 0 0 * g 1 1 - g 0 1 * g 1 0
    have e : g = gl2 1 (g 0 0 / g 1 0) 0 1 (by norm_num) *
        gl2 (-dt / g 1 0) 0 0 1 (by simpa using div_ne_zero (neg_ne_zero.2 hdet) hc) *
        gl2 0 1 1 0 (by norm_num) * gl2 1 (g 1 1) 0 1 (by norm_num) *
        gl2 (g 1 0) 0 0 1 (by simpa using hc) := by
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [Matrix.mul_apply, Fin.sum_univ_two, gl2_apply, dt] <;> field_simp <;> ring
    rw [e]
    exact good_mul (good_mul (good_mul (good_mul (good_T _)
      (good_D _ (div_ne_zero (neg_ne_zero.2 hdet) hc))) good_W) (good_T _)) (good_D _ hc)

end ShimuraGlue.Mob

namespace HDec.QMSplit.Moduli

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV

open scoped Classical

/-- **GLUE (now proved, `mobiusCompose`): postcomposing a morphism `X → P¹` with a Möbius
transformation over `ℚ`.** For a `ℚ`-scheme `X`, `π : X → P¹` (by charts) and `g ∈ GL₂(ℚ)` there is
`π' = g ∘ π : X → P¹`, with `π'(x) = g·π(x)` on `ℚ̄`-points (Mathlib's `GL₂`-action on `OnePoint`). -/
def MobiusCompose : Prop :=
  ∀ (X : Over (Spec (CommRingCat.of ℚ))) (π : ToP1 X.left) (g : GL (Fin 2) ℚ),
    ∃ π' : ToP1 X.left, ∀ x : fieldPt Qbar ⟶ X,
      π'.val (K := Qbar) x.left =
        Matrix.GeneralLinearGroup.map (algebraMap ℚ Qbar) g • π.val (K := Qbar) x.left

/-- **`MobiusCompose` is a theorem** (`ShimuraGlue.Mob.good_all`). -/
theorem mobiusCompose : MobiusCompose := fun X π g => ShimuraGlue.Mob.good_all g X π

end HDec.QMSplit.Moduli

/-! # shimura-glue Part E: parts/MobiusNew.lean -/
/-! # shimura-glue: Baba–Granath and Elkies leaves without the `j`-normalization; Möbius glue -/

namespace HDec.QMSplit.Moduli

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV

open scoped Classical
open ShimuraGlue.Mob (gl2 gl2_apply gl2_smul_some gl2_smul_infty)

/-- **A Möbius transformation over `ℚ` sends three distinct points of `P¹(ℚ)` to `0, ∞, 1`.** -/
theorem exists_mobius01 (a b c : OnePoint ℚ) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    ∃ g : GL (Fin 2) ℚ, g • a = ((0 : ℚ) : OnePoint ℚ) ∧ g • b = OnePoint.infty ∧
      g • c = ((1 : ℚ) : OnePoint ℚ) := by
  induction a using OnePoint.rec with
  | infty =>
    induction b using OnePoint.rec with
    | infty => exact absurd rfl hab
    | coe b =>
      induction c using OnePoint.rec with
      | infty => exact absurd rfl hac
      | coe c =>
        have hcb : c - b ≠ 0 := sub_ne_zero.2 fun e => hbc (by rw [e])
        refine ⟨gl2 0 (c - b) 1 (-b) (by intro e; apply hcb; linear_combination -e), ?_, ?_, ?_⟩
        · rw [gl2_smul_infty]; simp
        · rw [gl2_smul_some]; simp
        · rw [gl2_smul_some, if_neg (by intro e; apply hcb; linear_combination e)]
          congr 1
          rw [div_eq_one_iff_eq (by intro e; apply hcb; linear_combination e)]; ring
  | coe a =>
    induction b using OnePoint.rec with
    | infty =>
      induction c using OnePoint.rec with
      | infty => exact absurd rfl hbc
      | coe c =>
        have hca : c - a ≠ 0 := sub_ne_zero.2 fun e => hac (by rw [e])
        refine ⟨gl2 (1 / (c - a)) (-a / (c - a)) 0 1 (by simpa using hca), ?_, ?_, ?_⟩
        · rw [gl2_smul_some, if_neg (by simp)]
          congr 1; field_simp; ring
        · rw [gl2_smul_infty]; simp
        · rw [gl2_smul_some, if_neg (by simp)]
          congr 1; field_simp; try ring
    | coe b =>
      have hab' : a - b ≠ 0 := sub_ne_zero.2 fun e => hab (by rw [e])
      induction c using OnePoint.rec with
      | infty =>
        refine ⟨gl2 1 (-a) 1 (-b) (by intro e; apply hab'; linear_combination e), ?_, ?_, ?_⟩
        · rw [gl2_smul_some, if_neg (by intro e; apply hab'; linear_combination e)]; simp
        · rw [gl2_smul_some]; simp
        · rw [gl2_smul_infty]; simp
      | coe c =>
        have hca : c - a ≠ 0 := sub_ne_zero.2 fun e => hac (by rw [e])
        have hcb : c - b ≠ 0 := sub_ne_zero.2 fun e => hbc (by rw [e])
        set k := (c - b) / (c - a) with hkdef
        have hk : k ≠ 0 := div_ne_zero hcb hca
        have hkc : k * (c - a) = c - b := by rw [hkdef]; field_simp
        refine ⟨gl2 k (-k * a) 1 (-b) (by
          intro e; apply mul_ne_zero hk hab'; linear_combination e), ?_, ?_, ?_⟩
        · rw [gl2_smul_some, if_neg (by intro e; apply hab'; linear_combination e)]
          congr 1; rw [div_eq_zero_iff]; left; ring
        · rw [gl2_smul_some]; simp
        · rw [gl2_smul_some, if_neg (by intro e; apply hcb; linear_combination e)]
          congr 1
          rw [div_eq_one_iff_eq (by intro e; apply hcb; linear_combination e)]
          linear_combination hkc

/-- Three distinct points of `P¹(ℚ)` go to `0, ∞, −16/27`. -/
theorem exists_mobiusBG (a b c : OnePoint ℚ) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    ∃ g : GL (Fin 2) ℚ, g • a = ((0 : ℚ) : OnePoint ℚ) ∧ g • b = OnePoint.infty ∧
      g • c = ((-16 / 27 : ℚ) : OnePoint ℚ) := by
  obtain ⟨g, h0, h1, h2⟩ := exists_mobius01 a b c hab hac hbc
  let s := gl2 (-16 / 27) 0 0 1 (by norm_num)
  refine ⟨s * g, ?_, ?_, ?_⟩
  · rw [mul_smul, h0, gl2_smul_some]; simp
  · rw [mul_smul, h1, gl2_smul_infty]; simp
  · rw [mul_smul, h2, gl2_smul_some]; simp

/-- The value transfer: `G·s = (g·t)` over `ℚ̄` iff `s = t`, for `G` the image of `g`. -/
theorem smul_map_iff (g : GL (Fin 2) ℚ) (t : OnePoint ℚ) (s : OnePoint Qbar) :
    Matrix.GeneralLinearGroup.map (algebraMap ℚ Qbar) g • s = (g • t).map (algebraMap ℚ Qbar) ↔
      s = t.map (algebraMap ℚ Qbar) := by
  rw [OnePoint.map_smul]
  exact (MulAction.injective _).eq_iff

/-- **LEAF (Baba–Granath, Canad. J. Math. 60 (2008), Thm 2.1 (p. 737) and Lemma 3.1 (pp. 739–740),
read by the locator audit: YES; with the CM assignment read from the §3.1 elliptic-order table, p. 740),
without the `j`-normalization.** Some coarse witness of the moduli clause lists carries `π : X₆ → P¹` with
* the fibre clause (Thm 2.1: the polarized moduli space is `V/W`; two `ℚ̄`-points have the same value
  iff their QM pairs are `Aut(𝒪)`-twists, i.e. `W`-conjugate), and
* three distinct points `t₄, t₃, t₂₄ ∈ P¹(ℚ)` (Lemma 3.1: `V/W ≅ P¹_ℚ` and the three distinguished images
  are rational) such that the CM points of discriminants `−4, −3, −24` are exactly the fibres over them.
The last clause (each of `CM(−4)`, `CM(−3)`, `CM(−24)` is one `W`-orbit, over a distinguished point) is read
from the §3.1 elliptic-order table; locators.md grades that table's row NO for a different claim (the
ramification indices), and this reading is UNVERIFIED. Unlike `BabaGranathX6'` the leaf does not fix the
coordinate's values `0, ∞, −16/27` (the normalization the audit did not locate in Thm 2.1/Lemma 3.1); that
is the Möbius computation `babaGranathX6'_of_rational`. It is implied by `BabaGranathX6'` (take
`t = 0, ∞, −16/27`). -/
def BabaGranathRational : Prop :=
  ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y) (X : Over (Spec (CommRingCat.of ℚ)))
    (Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)) (fY : Y ⟶ X) (π : ToP1 X.left)
    (t₄ t₃ t₂₄ : OnePoint ℚ),
    R1fpProps Y Φ ∧ X6Props Y Φ X Ψ fY ∧ t₄ ≠ t₃ ∧ t₄ ≠ t₂₄ ∧ t₃ ≠ t₂₄ ∧
    ∀ (x x' : fieldPt Qbar ⟶ X) (P Q : QMPair Qbar),
      Ψ x = Quotient.mk _ P → Ψ x' = Quotient.mk _ Q →
        (π.val (K := Qbar) x.left = π.val (K := Qbar) x'.left ↔
            ∃ α : O ≃+* O, Nonempty (QMIso (P.q.twist α) Q.q)) ∧
        (HasCM4 P.q ↔ π.val (K := Qbar) x.left = t₄.map (algebraMap ℚ Qbar)) ∧
        (HasCM3 P.q ↔ π.val (K := Qbar) x.left = t₃.map (algebraMap ℚ Qbar)) ∧
        (HasCM24 P.q ↔ π.val (K := Qbar) x.left = t₂₄.map (algebraMap ℚ Qbar))

/-- **`BabaGranathX6'` from `BabaGranathRational` and the Möbius glue**: the coordinate sending the
three CM values to `0, ∞, −16/27` (`exists_mobiusBG`). -/
theorem babaGranathX6'_of_rational (h : BabaGranathRational) (hM : MobiusCompose) :
    BabaGranathX6' := by
  obtain ⟨Y, Φ, X, Ψ, fY, π, t₄, t₃, t₂₄, h1, h6, d1, d2, d3, hcl⟩ := h
  obtain ⟨g, hg4, hg3, hg24⟩ := exists_mobiusBG t₄ t₃ t₂₄ d1 d2 d3
  obtain ⟨π', hπ'⟩ := hM X π g
  refine ⟨Y, Φ, X, Ψ, fY, h1, h6, π', fun x x' P Q hP hQ => ?_⟩
  obtain ⟨hf, h4, h3, h24⟩ := hcl x x' P Q hP hQ
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hπ', hπ', (MulAction.injective _).eq_iff]; exact hf
  · rw [h4, hπ', show (OnePoint.some (0 : Qbar)) = (g • t₄).map (algebraMap ℚ Qbar) by
      rw [hg4]; simp, smul_map_iff]
  · rw [h3, hπ', show (OnePoint.infty : OnePoint Qbar) = (g • t₃).map (algebraMap ℚ Qbar) by
      rw [hg3]; simp, smul_map_iff]
  · rw [h24, hπ', show (OnePoint.some (-16 / 27 : Qbar)) = (g • t₂₄).map (algebraMap ℚ Qbar) by
      rw [hg24]; simp, smul_map_iff]

/-- The conic model in Elkies' coordinate `t = −X²/Z²` (`t = ∞` at the points at infinity). -/
def ConicModelT (X : Over (Spec (CommRingCat.of ℚ))) (t : ToP1 X.left) : Prop :=
  ∃ e : (fieldPt Qbar ⟶ X) ≃ X6Kummer.ConicPt,
    (∀ (σ : Qbar ≃ₐ[ℚ] Qbar) (x : fieldPt Qbar ⟶ X),
      e (fieldMap (σ : Qbar →ₐ[ℚ] Qbar) ≫ x) = X6Kummer.conicGal σ (e x)) ∧
    (∀ (x : fieldPt Qbar ⟶ X) p, e x = Sum.inl p →
      t.val (K := Qbar) x.left = OnePoint.some (-(p.1.1 ^ 2))) ∧
    (∀ (x : fieldPt Qbar ⟶ X) b, e x = Sum.inr b → t.val (K := Qbar) x.left = OnePoint.infty)

/-- **LEAF (Elkies, ANTS-III, LNCS 1423 (1998), §3, in his coordinate; locators UNVERIFIED).** Some
witness of the moduli clause lists carries Elkies' coordinate `t : X₆ → X*(6) = X₆/W ≅ P¹` with
* the fibre clause (`t` is a coordinate on `X₆/W`: equal values iff `W`-conjugate),
* `t = 0, 1, ∞` at the CM points of discriminants `−24, −4, −3`, and
* the Kummer description `X₆ = X*(6)(√−t, √(3(t − 1)))` on `ℚ̄`-points, written in the Kummer coordinates
  `X/Z = √−t`, `Y/Z = √(3(t − 1))` (so `Y² + 3X² + 3Z² = 0` and `t = −X²/Z²`): `ConicModelT`.
Reading (SPECULATIVE): Elkies' statement is about function fields; this is its form on the points of the
smooth projective model. Residue fields pin `t = 1 ↔ D = −4` (the fibre over `t = 1` has residue field
`ℚ(i)`); the assignment of `0, ∞` to `D = −24, −3` rests on Elkies' text (UNVERIFIED, no network). It does not use Baba–Granath's `j` (the relation `j = 16(t − 1)/27` is the
Möbius computation in `elkiesConicX6_of_t`). -/
def ElkiesConicT : Prop :=
  ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y) (X : Over (Spec (CommRingCat.of ℚ)))
    (Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)) (fY : Y ⟶ X) (t : ToP1 X.left),
    R1fpProps Y Φ ∧ X6Props Y Φ X Ψ fY ∧
    (∀ (x x' : fieldPt Qbar ⟶ X) (P Q : QMPair Qbar),
      Ψ x = Quotient.mk _ P → Ψ x' = Quotient.mk _ Q →
        (t.val (K := Qbar) x.left = t.val (K := Qbar) x'.left ↔
            ∃ α : O ≃+* O, Nonempty (QMIso (P.q.twist α) Q.q)) ∧
        (HasCM24 P.q → t.val (K := Qbar) x.left = OnePoint.some 0) ∧
        (HasCM4 P.q → t.val (K := Qbar) x.left = OnePoint.some 1) ∧
        (HasCM3 P.q → t.val (K := Qbar) x.left = OnePoint.infty)) ∧
    ConicModelT X t

/-- `j = 16(t − 1)/27`. -/
noncomputable def gJ : GL (Fin 2) ℚ := gl2 (16 / 27) (-16 / 27) 0 1 (by norm_num)

theorem gJ_smul (s : OnePoint Qbar) :
    Matrix.GeneralLinearGroup.map (algebraMap ℚ Qbar) gJ • s =
      s.map (fun z : Qbar => 16 * (z - 1) / 27) := by
  induction s using OnePoint.rec with
  | infty => rw [OnePoint.smul_infty_eq_ite]; simp [Matrix.GeneralLinearGroup.map_apply, gJ, gl2_apply]
  | coe z =>
    rw [OnePoint.smul_some_eq_ite]
    simp [Matrix.GeneralLinearGroup.map_apply, gJ, gl2_apply]
    ring

/-- **`ElkiesConicX6` from Elkies' statement in his coordinate and the Möbius glue** (`j = 16(t−1)/27`
sends `0, 1, ∞` to `−16/27, 0, ∞` and `−X²/Z²` to `−16(X² + Z²)/(27Z²)`). -/
theorem elkiesConicX6_of_t (h : ElkiesConicT) (hM : MobiusCompose) : ElkiesConicX6 := by
  obtain ⟨Y, Φ, X, Ψ, fY, t, h1, h6, hcl, e, he, hp, hi⟩ := h
  obtain ⟨π', hπ'⟩ := hM X t gJ
  refine ⟨Y, Φ, X, Ψ, fY, π', h1, h6, fun x x' P Q hP hQ => ?_, e, he, fun x p hx => ?_,
    fun x b hx => ?_⟩
  · obtain ⟨hf, h24, h4, h3⟩ := hcl x x' P Q hP hQ
    refine ⟨?_, fun c => ?_, fun c => ?_, fun c => ?_⟩
    · rw [hπ', hπ', (MulAction.injective _).eq_iff]; exact hf
    · rw [hπ', gJ_smul, h4 c]; simp
    · rw [hπ', gJ_smul, h3 c]; rfl
    · rw [hπ', gJ_smul, h24 c]; simp; try ring
  · rw [hπ', gJ_smul, hp x p hx]; simp; try ring
  · rw [hπ', gJ_smul, hi x b hx]; rfl

/-! ### Converses: the new leaves follow from the old ones (so they are not stronger) -/

/-- **`BabaGranathX6'` from `BabaGranathRational` alone** (the Möbius glue is proved:
`mobiusCompose`). -/
theorem babaGranathX6'_of_rational' (h : BabaGranathRational) : BabaGranathX6' :=
  babaGranathX6'_of_rational h mobiusCompose

/-- **`ElkiesConicX6` from `ElkiesConicT` alone.** -/
theorem elkiesConicX6_of_t' (h : ElkiesConicT) : ElkiesConicX6 :=
  elkiesConicX6_of_t h mobiusCompose

end HDec.QMSplit.Moduli

/-! # shimura-glue Part F: parts/RayClassNew.lean -/
/-! # shimura-glue: `ReciprocityCanonical` from Shimura's theorem on CM points in ray-class form -/

namespace ShimuraGlue.Ray

open TauCeti.ClassFieldTheory TauCeti.GlobalNumberFields NumberField IsDedekindDomain
open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV

/-- The modulus `3·𝒪_K` (no infinite part; `K` imaginary quadratic has no real places). -/
noncomputable def mod3 (K : Type) [Field K] [NumberField K] : Modulus K :=
  ⟨Ideal.span {3}, by
    rw [Ne, Ideal.span_singleton_eq_bot]
    exact_mod_cast (show ((3 : ℕ) : 𝓞 K) ≠ 0 from Nat.cast_ne_zero.2 (by norm_num)), ∅⟩

/-- A prime of `𝒪_K` above `p ≥ 5` is outside the support of `3·𝒪_K`. -/
theorem not_mem_support_mod3 {K : Type} [Field K] [NumberField K] (v : HeightOneSpectrum (𝓞 K))
    {p : ℕ} (hp : p.Prime) (h5 : 5 ≤ p) (hpv : (p : 𝓞 K) ∈ v.asIdeal) : v ∉ (mod3 K).support := by
  rw [Modulus.mem_support_iff]
  intro hdvd
  have h3 : (3 : 𝓞 K) ∈ v.asIdeal := Ideal.le_of_dvd hdvd (Ideal.mem_span_singleton_self 3)
  have hcop : IsCoprime (3 : ℤ) p := by
    rw [Int.isCoprime_iff_gcd_eq_one]
    have : Nat.Coprime 3 p := (Nat.coprime_primes Nat.prime_three hp).2 (by omega)
    simpa [Int.gcd] using this
  obtain ⟨a, b, hab⟩ := hcop
  have h1 : (1 : 𝓞 K) ∈ v.asIdeal := by
    have := v.asIdeal.add_mem (v.asIdeal.mul_mem_left (a : 𝓞 K) h3)
      (v.asIdeal.mul_mem_left (b : 𝓞 K) hpv)
    have e : ((a : 𝓞 K) * 3 + (b : 𝓞 K) * (p : 𝓞 K)) = 1 := by exact_mod_cast congrArg (Int.cast : ℤ → 𝓞 K) hab
    rwa [e] at this
  exact v.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 h1)

/-- **Glue: a subfield of `ℚ̄` embedding into the ray class field of conductor 3 of a number field `K`
unramified above every `p ≥ 5` is unramified above every `p ≥ 5`.** (Tau Ceti:
`IsAdmissibleModulus.isUnramifiedAway`; Mathlib: `Algebra.IsUnramifiedAt.comp`,
`NumberField.not_dvd_discr_iff_forall_mem`, `NumberField.discr_dvd_discr`.) -/
theorem unramifiedAbove5_of_embed (K : Type) [Field K] [NumberField K]
    (hK : ∀ p : ℕ, p.Prime → 5 ≤ p → ¬ (p : ℤ) ∣ discr K)
    (F : IntermediateField ℚ Qbar) (τ : F →+* rayClassField (mod3 K)) : UnramifiedAbove5 F := by
  let L := rayClassField (mod3 K)
  have hfd : FiniteDimensional ℚ F :=
    FiniteDimensional.of_injective τ.toRatAlgHom.toLinearMap τ.injective
  refine ⟨hfd, fun p hp h5 hdvd => ?_⟩
  letI : NumberField F := @NumberField.mk F _ _ hfd
  letI : Algebra F L := τ.toAlgebra
  have h1 : discr F ∣ discr L := NumberField.discr_dvd_discr F L
  have hpZ : Prime (p : ℤ) := Nat.prime_iff_prime_int.1 hp
  have h2 : ¬ (p : ℤ) ∣ discr L := by
    rw [NumberField.not_dvd_discr_iff_forall_mem L (𝓞 L) hpZ]
    intro P hP hpP
    let Q := P.comap (algebraMap (𝓞 K) (𝓞 L))
    haveI : Q.IsPrime := Ideal.comap_isPrime _ _
    haveI : P.LiesOver Q := ⟨rfl⟩
    have hpQ : ((p : ℤ) : 𝓞 K) ∈ Q := by
      rw [Ideal.mem_comap, map_intCast]; exact hpP
    haveI : Algebra.IsUnramifiedAt ℤ Q :=
      (NumberField.not_dvd_discr_iff_forall_mem K (𝓞 K) hpZ).1 (hK p hp h5) Q inferInstance hpQ
    have hQ0 : Q ≠ ⊥ := by
      intro h0
      rw [h0, Ideal.mem_bot] at hpQ
      exact hp.ne_zero (by exact_mod_cast hpQ)
    let v : HeightOneSpectrum (𝓞 K) := ⟨Q, inferInstance, hQ0⟩
    have hpv : (p : 𝓞 K) ∈ v.asIdeal := by exact_mod_cast hpQ
    haveI : P.LiesOver v.asIdeal := ‹P.LiesOver Q›
    haveI : Algebra.IsUnramifiedAt (𝓞 K) P :=
      (isAdmissibleModulus_rayClassField (mod3 K)).isUnramifiedAway v
        (not_mem_support_mod3 v hp h5 hpv) P
    exact Algebra.IsUnramifiedAt.comp Q P
  exact h2 (dvd_trans hdvd h1)

instance instNeZero24 : NeZero ((24 : ℕ) : ℚ) := ⟨by norm_num⟩
instance instNeZero4 : NeZero ((4 : ℕ) : ℚ) := ⟨by norm_num⟩
instance instNeZero3 : NeZero ((3 : ℕ) : ℚ) := ⟨by norm_num⟩
instance instCyc24 : IsCyclotomicExtension {24} ℚ (CyclotomicField 24 ℚ) :=
  CyclotomicField.isCyclotomicExtension 24 ℚ
instance instCyc4 : IsCyclotomicExtension {4} ℚ (CyclotomicField 4 ℚ) :=
  CyclotomicField.isCyclotomicExtension 4 ℚ
instance instCyc3 : IsCyclotomicExtension {3} ℚ (CyclotomicField 3 ℚ) :=
  CyclotomicField.isCyclotomicExtension 3 ℚ

/-- A cyclotomic field `ℚ(ζ_m)` is unramified above every prime not dividing `m` (Tau Ceti). -/
theorem cyclotomic_unram (m : ℕ) [NeZero m] [IsCyclotomicExtension {m} ℚ (CyclotomicField m ℚ)] {p : ℕ} (hp : p.Prime) (hpm : ¬ p ∣ m) :
    ¬ (p : ℤ) ∣ discr (CyclotomicField m ℚ) := by
  intro h
  rcases IsCyclotomicExtension.prime_dvd_natAbs_discr_or_dvd_of_dvd_natAbs_discr ℚ
      (CyclotomicField m ℚ) m hp (Int.natCast_dvd.1 h) with h' | h'
  · rw [NumberField.discr_rat] at h'; simp at h'; exact hp.one_lt.ne' h'
  · exact hpm h'

/-- `ℚ(i) = ℚ(ζ₄)`. -/
abbrev K4 : Type := CyclotomicField 4 ℚ
/-- `ℚ(ζ₃)`. -/
abbrev K3 : Type := CyclotomicField 3 ℚ

/-- `ζ₂₄`. -/
noncomputable abbrev z24 : CyclotomicField 24 ℚ := IsCyclotomicExtension.zeta 24 ℚ (CyclotomicField 24 ℚ)

/-- `√−6 = (2ζ₃ + 1)(ζ₈ + ζ₈⁷)` in `ℚ(ζ₂₄)`, with `ζ₃ = ζ₂₄⁸`, `ζ₈ = ζ₂₄³`. -/
noncomputable def s6 : CyclotomicField 24 ℚ := (2 * z24 ^ 8 + 1) * (z24 ^ 3 + z24 ^ 21)

/-- `ℚ(√−6) = ℚ(s6) ⊆ ℚ(ζ₂₄)`. -/
abbrev K24 : IntermediateField ℚ (CyclotomicField 24 ℚ) := IntermediateField.adjoin ℚ {s6}

theorem hK4 : ∀ p : ℕ, p.Prime → 5 ≤ p → ¬ (p : ℤ) ∣ discr K4 := fun p hp h5 =>
  cyclotomic_unram 4 hp (fun h => by have := Nat.le_of_dvd (by norm_num) h; omega)

theorem hK3 : ∀ p : ℕ, p.Prime → 5 ≤ p → ¬ (p : ℤ) ∣ discr K3 := fun p hp h5 =>
  cyclotomic_unram 3 hp (fun h => by have := Nat.le_of_dvd (by norm_num) h; omega)

theorem hK24 : ∀ p : ℕ, p.Prime → 5 ≤ p → ¬ (p : ℤ) ∣ discr K24 := by
  intro p hp h5 h
  have h24 : ¬ p ∣ 24 := by
    intro hd
    have h24' : (24 : ℕ) = 2 ^ 3 * 3 := by norm_num
    rw [h24'] at hd
    rcases (Nat.Prime.dvd_mul hp).1 hd with h2 | h3
    · have := Nat.le_of_dvd (by norm_num) (hp.dvd_of_dvd_pow h2); omega
    · have := Nat.le_of_dvd (by norm_num) h3; omega
  exact cyclotomic_unram 24 hp h24 (dvd_trans h (NumberField.discr_dvd_discr K24 _))

/-- **LEAF (Shimura's reciprocity at CM points, in ray-class form; a consequence).** Some fine witness
`(Y, Φ)` of the moduli clause lists (the canonical model `Y₃ = Sh_{K₃}`) has: for every `ℚ̄`-point `y`
whose object has CM by the maximal order of `k = ℚ(i)`, `ℚ(ζ₃)`, `ℚ(√−6)`, the residue field `ℚ(y) ⊆ ℚ̄`
embeds into the ray class field of `k` of conductor `3·𝒪_k` (Tau Ceti's `rayClassField`).

*Published statement*: Shimura reciprocity at CM points of the canonical model (Shimura, Ann. of Math. 85
(1967), Main Thm I; Deligne, Sém. Bourbaki 389 (1971), §3; Milne, *Introduction to Shimura varieties*
(2005), §12-13; locators UNVERIFIED): for a CM point `x = [h_k, g]` of `Sh_K`, `k(x)` is the class field of
`k` attached to `k^× k_∞^× · {s ∈ 𝔸_{k,f}^× : ι(s) ∈ gKg⁻¹}`. For `K = K₃` and an optimal embedding of the
maximal order (`HasCM*` means `End` contains `𝒪_k`, which is maximal), `ι(1 + 3𝒪̂_k) ⊆ g(1 + 3𝒪̂)g⁻¹` (at 2
and 3, where `B` ramifies, `𝒪_p` is the unique maximal order of the division algebra and `K₃` at 3 is
`1 + 3𝒪₃`), so this subgroup contains the ray subgroup of conductor 3 and
`k(x) ⊆` the ray class field of conductor 3; `ℚ(x) ⊆ k(x)`. *Form*: a **consequence** (the class field is
bounded by the ray class field, and only the embedding of `ℚ(x)` is kept). Lemma QP as for `R1fp`. -/
def RayClassCM : Prop :=
  ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y), R1fpProps Y Φ ∧
    ∀ (y : fieldPt Qbar ⟶ Y) (P : QML3 Qbar), Φ Qbar y = M3.mk P →
      (HasCM4 P.q → Nonempty (residueImage (X := Y.left) y.left →+* rayClassField (mod3 K4))) ∧
      (HasCM3 P.q → Nonempty (residueImage (X := Y.left) y.left →+* rayClassField (mod3 K3))) ∧
      (HasCM24 P.q → Nonempty (residueImage (X := Y.left) y.left →+* rayClassField (mod3 K24)))

/-- **`ReciprocityCanonical` (shimura-split) from the ray-class leaf** (`unramifiedAbove5_of_embed`, with
`ℚ(i)`, `ℚ(ζ₃)`, `ℚ(√−6)` unramified above `p ≥ 5`: `hK4`, `hK3`, `hK24`). -/
theorem reciprocityCanonical_of_rayClass (h : RayClassCM) :
    HDec.QMSplit.Moduli.ReciprocityCanonical := by
  obtain ⟨Y, Φ, h1, hc⟩ := h
  refine ⟨Y, Φ, h1, fun y P hP hcm => ?_⟩
  obtain ⟨c4, c3, c24⟩ := hc y P hP
  rcases hcm with h | h | h
  · obtain ⟨τ⟩ := c4 h; exact unramifiedAbove5_of_embed K4 hK4 _ τ
  · obtain ⟨τ⟩ := c3 h; exact unramifiedAbove5_of_embed K3 hK3 _ τ
  · obtain ⟨τ⟩ := c24 h; exact unramifiedAbove5_of_embed K24 hK24 _ τ

end ShimuraGlue.Ray

/-! # shimura-glue Part G: parts/Bundle3New.lean -/
/-! # shimura-glue: the bundle with the ray-class form of Shimura reciprocity -/

namespace HDec.QMSplit.Moduli

end HDec.QMSplit.Moduli

/-! # x6-glue part: parts/EvalAffine.lean -/
/-! # x6-glue Part 1: values of sections at field points of an affine open

For an affine open `U ⊆ X` and a field `K`, the `K`-points of `X` lying in `U` are in bijection with
the ring homs `Γ(X, U) → K`, by "values of sections" (`ev`). Mathlib only. -/

namespace X6Glue

open CategoryTheory AlgebraicGeometry Limits

section Generic

variable {X : Scheme.{0}} {K : Type} [Field K]

/-- The value of sections over `U` at a `K`-point `y` lying in `U`: the same recipe as the kernel's
`ToP1.val` (evaluation in `κ(x)`, then `κ(x) → K`). -/
noncomputable def ev (U : X.Opens) (y : Spec (CommRingCat.of K) ⟶ X)
    (h : (Scheme.SpecToEquivOfField K X y).1 ∈ U) : Γ(X, U) →+* K :=
  ((Scheme.SpecToEquivOfField K X y).2).hom.comp (X.evaluation U _ h).hom

theorem ev_apply (U : X.Opens) (y : Spec (CommRingCat.of K) ⟶ X)
    (h : (Scheme.SpecToEquivOfField K X y).1 ∈ U) (s : Γ(X, U)) :
    ev U y h s = (Scheme.SpecToEquivOfField K X y).2 (X.evaluation U _ h s) := rfl

theorem pt_mem_top (U : X.Opens) (y : Spec (CommRingCat.of K) ⟶ X)
    (h : (Scheme.SpecToEquivOfField K X y).1 ∈ U) : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ y ⁻¹ᵁ U :=
  (Scheme.preimage_eq_top_of_closedPoint_mem y h).ge

/-- The ring hom `Γ(X, U) → K` of a point in `U`, through `appLE`. -/
noncomputable def psi (U : X.Opens) (y : Spec (CommRingCat.of K) ⟶ X)
    (h : (Scheme.SpecToEquivOfField K X y).1 ∈ U) : Γ(X, U) ⟶ CommRingCat.of K :=
  y.appLE U ⊤ (pt_mem_top U y h) ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom

/-- **A point in an affine open is `Spec` of its ring hom.** -/
theorem eq_specMap_psi (U : X.Opens) (hU : IsAffineOpen U) (y : Spec (CommRingCat.of K) ⟶ X)
    (h : (Scheme.SpecToEquivOfField K X y).1 ∈ U) :
    y = Spec.map (psi U y h) ≫ hU.fromSpec := by
  have e := IsAffineOpen.SpecMap_appLE_fromSpec y hU (isAffineOpen_top _) (pt_mem_top U y h)
  rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at e
  rw [psi, Spec.map_comp, Category.assoc, e, ← Category.assoc, ← Spec.map_comp, Iso.inv_hom_id,
    Spec.map_id, Category.id_comp]

/-- **`ev` is `psi`.** -/
theorem ev_eq_psi (U : X.Opens) (y : Spec (CommRingCat.of K) ⟶ X)
    (h : (Scheme.SpecToEquivOfField K X y).1 ∈ U) : ev U y h = (psi U y h).hom := by
  have key : X.presheaf.germ U _ h ≫ Scheme.stalkClosedPointTo y = psi U y h := by
    refine (Scheme.germ_stalkClosedPointTo y U h).trans ?_
    rw [psi, Scheme.Hom.appLE]
    simp only [Iso.trans_hom, Functor.mapIso_hom, Iso.op_hom, eqToIso.hom, Category.assoc]
    rfl
  ext s
  exact congrArg (fun φ => φ.hom s) key

theorem ev_injective (U : X.Opens) (hU : IsAffineOpen U) (y₁ y₂ : Spec (CommRingCat.of K) ⟶ X)
    (h₁ : (Scheme.SpecToEquivOfField K X y₁).1 ∈ U) (h₂ : (Scheme.SpecToEquivOfField K X y₂).1 ∈ U)
    (e : ev U y₁ h₁ = ev U y₂ h₂) : y₁ = y₂ := by
  rw [eq_specMap_psi U hU y₁ h₁, eq_specMap_psi U hU y₂ h₂]
  rw [ev_eq_psi, ev_eq_psi] at e
  rw [CommRingCat.hom_ext e]

theorem ev_surjective (U : X.Opens) (hU : IsAffineOpen U) (φ : Γ(X, U) →+* K) :
    ∃ (y : Spec (CommRingCat.of K) ⟶ X) (h : (Scheme.SpecToEquivOfField K X y).1 ∈ U),
      ev U y h = φ := by
  let y := Spec.map (CommRingCat.ofHom φ) ≫ hU.fromSpec
  have h : (Scheme.SpecToEquivOfField K X y).1 ∈ U := by
    have hr : (Scheme.SpecToEquivOfField K X y).1 ∈ Set.range hU.fromSpec := ⟨_, rfl⟩
    rw [hU.range_fromSpec] at hr
    exact hr
  refine ⟨y, h, ?_⟩
  have e := eq_specMap_psi U hU y h
  have e2 : Spec.map (psi U y h) = Spec.map (CommRingCat.ofHom φ) :=
    (cancel_mono hU.fromSpec).mp e.symm
  rw [ev_eq_psi, Spec.map_inj.mp e2]
  rfl

/-- **Naturality of `ev`** in the field. -/
theorem ev_comp {L : Type} [Field L] (f : K →+* L) (U : X.Opens)
    (y : Spec (CommRingCat.of K) ⟶ X) (h : (Scheme.SpecToEquivOfField K X y).1 ∈ U)
    (h' : (Scheme.SpecToEquivOfField L X (Spec.map (CommRingCat.ofHom f) ≫ y)).1 ∈ U)
    (s : Γ(X, U)) :
    ev U (Spec.map (CommRingCat.ofHom f) ≫ y) h' s = f (ev U y h s) := by
  rw [ev_apply, ev_apply]
  generalize hp : Scheme.SpecToEquivOfField L X (Spec.map (CommRingCat.ofHom f) ≫ y) = p at h'
  rw [LeafQM.AV.specToEquivOfField_comp] at hp
  subst hp
  rfl

theorem mem_comp_iff {L : Type} [Field L] (f : K →+* L) (U : X.Opens)
    (y : Spec (CommRingCat.of K) ⟶ X) :
    (Scheme.SpecToEquivOfField L X (Spec.map (CommRingCat.ofHom f) ≫ y)).1 ∈ U ↔
      (Scheme.SpecToEquivOfField K X y).1 ∈ U := by
  rw [LeafQM.AV.specToEquivOfField_comp]

end Generic

/-- Morphisms `Spec K → Spec ℚ` are unique (ring homs out of `ℚ` are unique). -/
theorem specQ_hom_ext {K : Type} [Field K] (a b : Spec (CommRingCat.of K) ⟶ Spec (CommRingCat.of ℚ)) :
    a = b := by
  rw [← Spec.map_preimage a, ← Spec.map_preimage b]
  congr 1
  ext1
  exact RingHom.ext_rat _ _

end X6Glue

/-! # x6-glue part: parts/Charts.lean -/
/-! # x6-glue Part 2: Elkies' equations over the `t`-line, and the conic model on `ℚ̄`-points

`ElkiesCharts X t`: over each of the two standard opens of the `t`-line, `X` is the affine curve
`s² = −t, r² = 3(t − 1)`, glued by `s ↦ 1/s, r ↦ r/s`. `conicModelT_of_charts` derives shimura-glue's
points form `ConicModelT X t` from it. -/

namespace X6Glue

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV

/-- The ideal of Elkies' affine equations `s² = −t`, `r² = 3(t − 1)` in `ℚ[t, s, r]`
(variables `t = X 0`, `s = X 1`, `r = X 2`). -/
noncomputable def elkiesIdeal : Ideal (MvPolynomial (Fin 3) ℚ) :=
  Ideal.span {MvPolynomial.X 1 ^ 2 + MvPolynomial.X 0,
    MvPolynomial.X 2 ^ 2 - 3 * (MvPolynomial.X 0 - 1)}

/-- `ℚ[t, s, r]/(s² + t, r² − 3(t − 1))`, the coordinate ring of `X*(6)(√−t, √(3(t − 1)))` over the
affine `t`-line. -/
abbrev ElkiesRing : Type := MvPolynomial (Fin 3) ℚ ⧸ elkiesIdeal

/-- The coordinates `t, s, r` in `ElkiesRing`. -/
noncomputable abbrev eT : ElkiesRing := Ideal.Quotient.mk _ (MvPolynomial.X 0)
noncomputable abbrev eS : ElkiesRing := Ideal.Quotient.mk _ (MvPolynomial.X 1)
noncomputable abbrev eR : ElkiesRing := Ideal.Quotient.mk _ (MvPolynomial.X 2)

theorem rel1 : eS ^ 2 + eT = 0 := by
  rw [← map_pow, ← map_add, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Set.mem_insert _ _)

theorem rel2 : eR ^ 2 - 3 * (eT - 1) = 0 := by
  have : eR ^ 2 - 3 * (eT - 1) = Ideal.Quotient.mk elkiesIdeal
      (MvPolynomial.X 2 ^ 2 - 3 * (MvPolynomial.X 0 - 1)) := by
    simp only [map_sub, map_pow, map_mul, map_one, map_ofNat]
  rw [this, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)

/-- Ring homs out of `ElkiesRing` agree if they agree on `s` and `r` (then also on `t = −s²`). -/
theorem elkies_hom_ext {A : Type*} [CommRing A] (ψ₁ ψ₂ : ElkiesRing →+* A)
    (hS : ψ₁ eS = ψ₂ eS) (hR : ψ₁ eR = ψ₂ eR) : ψ₁ = ψ₂ := by
  have hT : ψ₁ eT = ψ₂ eT := by
    have e1 := congrArg ψ₁ rel1
    have e2 := congrArg ψ₂ rel1
    simp only [map_add, map_pow, map_zero] at e1 e2
    rw [hS] at e1
    linear_combination e1 - e2
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro c
    exact congrArg (fun φ : ℚ →+* A => φ c) (RingHom.ext_rat ((ψ₁.comp _).comp MvPolynomial.C)
      ((ψ₂.comp _).comp MvPolynomial.C))
  · intro i
    fin_cases i
    · exact hT
    · exact hS
    · exact hR

/-- The ring hom `ElkiesRing → K` of a solution `(t, s, r)`. -/
noncomputable def elkiesLift {K : Type*} [CommRing K] [Algebra ℚ K] (t s r : K)
    (h1 : s ^ 2 + t = 0) (h2 : r ^ 2 - 3 * (t - 1) = 0) : ElkiesRing →+* K :=
  Ideal.Quotient.lift elkiesIdeal (MvPolynomial.aeval ![t, s, r]).toRingHom (by
    intro a ha
    refine Submodule.span_induction (p := fun a _ => (MvPolynomial.aeval ![t, s, r]).toRingHom a = 0)
      ?_ ?_ ?_ ?_ ha
    · rintro x (rfl | rfl)
      · simpa using h1
      · simpa using h2
    · simp
    · intro x y _ _ hx hy; simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at hx hy ⊢
      rw [map_add, hx, hy, add_zero]
    · intro c x _ hx; simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, smul_eq_mul] at hx ⊢
      rw [map_mul, hx, mul_zero])

theorem elkiesLift_T {K : Type*} [CommRing K] [Algebra ℚ K] (t s r : K) h1 h2 :
    elkiesLift t s r h1 h2 eT = t := by simp [elkiesLift]
theorem elkiesLift_S {K : Type*} [CommRing K] [Algebra ℚ K] (t s r : K) h1 h2 :
    elkiesLift t s r h1 h2 eS = s := by simp [elkiesLift]
theorem elkiesLift_R {K : Type*} [CommRing K] [Algebra ℚ K] (t s r : K) h1 h2 :
    elkiesLift t s r h1 h2 eR = r := by simp [elkiesLift]

/-- **Elkies' equations as charts of `X` over the `t`-line.** For a `ℚ`-scheme `X` with `t : X → P¹`
(the kernel's charts `t.U = {t ≠ ∞}`, `t.V = {t ≠ 0}`, `t.f = t`, `t.g = 1/t`):
* `t.U` and `t.V` are affine;
* `Γ(t.U) ≅ ℚ[t, s, r]/(s² + t, r² − 3(t − 1))` with `t ↦ t.f` (that is, over `t ≠ ∞`, `X` is the
  curve `s² = −t`, `r² = 3(t − 1)`);
* `Γ(t.V) ≅ ℚ[u, a, b]/(a² + u, b² − 3(u − 1))` with `u ↦ t.g = 1/t` (over `t ≠ 0`, with
  `a = 1/s`, `b = r/s`: `a² = −1/t`, `b² = 3(t − 1)/(−t) = 3(1/t − 1)`);
* on `t.U ∩ t.V`: `s·a = 1` and `r·a = b` (the gluing).
This is the curve `X*(6)(√−t, √(3(t − 1)))` over the `t`-line, written in the two standard charts. -/
def ElkiesCharts (X : Over (Spec (CommRingCat.of ℚ))) (t : ToP1 X.left) : Prop :=
  IsAffineOpen t.U ∧ IsAffineOpen t.V ∧
  ∃ (φU : ElkiesRing ≃+* Γ(X.left, t.U)) (φV : ElkiesRing ≃+* Γ(X.left, t.V)),
    φU eT = t.f ∧ φV eT = t.g ∧
    X.left.presheaf.map (homOfLE (inf_le_left : t.U ⊓ t.V ≤ t.U)).op (φU eS) *
      X.left.presheaf.map (homOfLE (inf_le_right : t.U ⊓ t.V ≤ t.V)).op (φV eS) = 1 ∧
    X.left.presheaf.map (homOfLE (inf_le_left : t.U ⊓ t.V ≤ t.U)).op (φU eR) *
      X.left.presheaf.map (homOfLE (inf_le_right : t.U ⊓ t.V ≤ t.V)).op (φV eS) =
      X.left.presheaf.map (homOfLE (inf_le_right : t.U ⊓ t.V ≤ t.V)).op (φV eR)

end X6Glue

/-! # x6-glue part: parts/ConicProof.lean -/
/-! # x6-glue Part 3: `ConicModelT` from `ElkiesCharts` -/

namespace X6Glue

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV

section Proof

variable {X : Over (Spec (CommRingCat.of ℚ))} {t : ToP1 X.left}

/-- The point of `X` under a `ℚ̄`-point. -/
noncomputable abbrev pt {X : Over (Spec (CommRingCat.of ℚ))} (y : Spec (CommRingCat.of Qbar) ⟶ X.left) :
    X.left :=
  (Scheme.SpecToEquivOfField Qbar X.left y).1

theorem memV_of_not_memU (y : Spec (CommRingCat.of Qbar) ⟶ X.left) (h : ¬ (pt y) ∈ t.U) : (pt y) ∈ t.V := by
  have hc : (pt y) ∈ (t.U ⊔ t.V) := by rw [t.cover]; trivial
  rcases hc with hc | hc
  · exact absurd hc h
  · exact hc

/-- At a point outside `t.U`, the section `t.g = 1/t` vanishes. -/
theorem ev_g_eq_zero (y : Spec (CommRingCat.of Qbar) ⟶ X.left) (h : ¬ (pt y) ∈ t.U) (hv : (pt y) ∈ t.V) :
    ev t.V y hv t.g = 0 := by
  rw [ev_apply]
  have : X.left.evaluation t.V _ hv t.g = 0 := by
    rw [Scheme.evaluation_eq_zero_iff_notMem_basicOpen, t.basicOpen_g]
    exact fun hm => h hm.1
  rw [this, map_zero]

/-- At a point of `t.V` where `t.g` vanishes, the point is outside `t.U`. -/
theorem not_memU_of_ev_g (y : Spec (CommRingCat.of Qbar) ⟶ X.left)
    (hv : (Scheme.SpecToEquivOfField Qbar X.left y).1 ∈ t.V) (h0 : ev t.V y hv t.g = 0) :
    ¬ (Scheme.SpecToEquivOfField Qbar X.left y).1 ∈ t.U := by
  intro hu
  have hb : (Scheme.SpecToEquivOfField Qbar X.left y).1 ∈ X.left.basicOpen t.g := by
    rw [t.basicOpen_g]; exact ⟨hu, hv⟩
  rw [← Scheme.evaluation_ne_zero_iff_mem_basicOpen _ _ hv] at hb
  rw [ev_apply] at h0
  exact hb ((map_eq_zero_iff _ (RingHom.injective _)).mp h0)

variable (φU : ElkiesRing ≃+* Γ(X.left, t.U)) (φV : ElkiesRing ≃+* Γ(X.left, t.V))

/-- The composite `ElkiesRing → Γ(t.U) → ℚ̄` at a point of `t.U`. -/
noncomputable def psiU (y : Spec (CommRingCat.of Qbar) ⟶ X.left)
    (h : (Scheme.SpecToEquivOfField Qbar X.left y).1 ∈ t.U) : ElkiesRing →+* Qbar :=
  (ev t.U y h).comp (φU : ElkiesRing →+* Γ(X.left, t.U))

noncomputable def psiV (y : Spec (CommRingCat.of Qbar) ⟶ X.left)
    (h : (Scheme.SpecToEquivOfField Qbar X.left y).1 ∈ t.V) : ElkiesRing →+* Qbar :=
  (ev t.V y h).comp (φV : ElkiesRing →+* Γ(X.left, t.V))

theorem conic_rel (ψ : ElkiesRing →+* Qbar) : ψ eR ^ 2 + 3 * ψ eS ^ 2 + 3 = 0 := by
  have e1 := congrArg ψ rel1
  have e2 := congrArg ψ rel2
  simp only [map_add, map_pow, map_zero, map_sub, map_mul, map_one, map_ofNat] at e1 e2
  linear_combination e2 + 3 * e1

theorem inf_rel (ψ : ElkiesRing →+* Qbar) (h0 : ψ eT = 0) : ψ eR ^ 2 = -3 := by
  have e2 := congrArg ψ rel2
  simp only [map_pow, map_sub, map_mul, map_one, map_ofNat, map_zero, h0] at e2
  linear_combination e2

theorem s_zero (ψ : ElkiesRing →+* Qbar) (h0 : ψ eT = 0) : ψ eS = 0 := by
  have e1 := congrArg ψ rel1
  simp only [map_add, map_pow, map_zero, h0, add_zero] at e1
  exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp e1

variable (hTg : φV eT = t.g)

include hTg in
theorem psiV_T (y : Spec (CommRingCat.of Qbar) ⟶ X.left) (h : ¬ (pt y) ∈ t.U) (hv : (pt y) ∈ t.V) :
    psiV φV y hv eT = 0 := by
  simp only [psiV, RingHom.comp_apply, RingHom.coe_coe, hTg]
  exact ev_g_eq_zero y h hv

open Classical in
/-- The map `X(ℚ̄) → C(ℚ̄)`: `(s, r)` on `t.U`, and `b` (with `[X : Y : Z] = [1 : b : 0]`) off `t.U`. -/
noncomputable def conicMapL (y : Spec (CommRingCat.of Qbar) ⟶ X.left) : HDec.X6Kummer.ConicPt :=
  if h : (pt y) ∈ t.U then
    Sum.inl ⟨(psiU φU y h eS, psiU φU y h eR), conic_rel _⟩
  else
    Sum.inr ⟨psiV φV y (memV_of_not_memU y h) eR,
      inf_rel _ (psiV_T φV hTg y h (memV_of_not_memU y h))⟩

theorem psiU_comp (σ : Qbar →+* Qbar) (y : Spec (CommRingCat.of Qbar) ⟶ X.left) (h : (pt y) ∈ t.U)
    (h' : (pt (Spec.map (CommRingCat.ofHom σ) ≫ y)) ∈ t.U) (a : ElkiesRing) :
    psiU φU (Spec.map (CommRingCat.ofHom σ) ≫ y) h' a = σ (psiU φU y h a) :=
  ev_comp σ t.U y h h' _

theorem psiV_comp (σ : Qbar →+* Qbar) (y : Spec (CommRingCat.of Qbar) ⟶ X.left) (h : (pt y) ∈ t.V)
    (h' : (pt (Spec.map (CommRingCat.ofHom σ) ≫ y)) ∈ t.V) (a : ElkiesRing) :
    psiV φV (Spec.map (CommRingCat.ofHom σ) ≫ y) h' a = σ (psiV φV y h a) :=
  ev_comp σ t.V y h h' _

/-- **Galois equivariance.** -/
theorem conicMapL_comp (σ : Qbar ≃ₐ[ℚ] Qbar) (y : Spec (CommRingCat.of Qbar) ⟶ X.left) :
    conicMapL φU φV hTg (Spec.map (CommRingCat.ofHom ((σ : Qbar →ₐ[ℚ] Qbar) : Qbar →+* Qbar)) ≫ y) =
      HDec.X6Kummer.conicGal σ (conicMapL φU φV hTg y) := by
  by_cases h : pt y ∈ t.U
  · have h' : pt (Spec.map (CommRingCat.ofHom ((σ : Qbar →ₐ[ℚ] Qbar) : Qbar →+* Qbar)) ≫ y) ∈ t.U :=
      (mem_comp_iff _ _ _).mpr h
    rw [conicMapL, dif_pos h', conicMapL, dif_pos h]
    simp only [HDec.X6Kummer.conicGal]
    congr 1
    apply Subtype.ext
    simp only
    rw [psiU_comp φU _ y h h', psiU_comp φU _ y h h']
    rfl
  · have h' : ¬ pt (Spec.map (CommRingCat.ofHom ((σ : Qbar →ₐ[ℚ] Qbar) : Qbar →+* Qbar)) ≫ y) ∈ t.U :=
      fun hh => h ((mem_comp_iff _ _ _).mp hh)
    rw [conicMapL, dif_neg h', conicMapL, dif_neg h]
    simp only [HDec.X6Kummer.conicGal]
    congr 1
    apply Subtype.ext
    simp only
    rw [psiV_comp φV _ y (memV_of_not_memU y h) (memV_of_not_memU _ h')]
    rfl

variable (hT : φU eT = t.f)

include hT in
/-- **The value of `t` on the affine part**: `t = −s²`. -/
theorem val_of_inl (y : Spec (CommRingCat.of Qbar) ⟶ X.left) (p)
    (hp : conicMapL φU φV hTg y = Sum.inl p) : t.val y = OnePoint.some (-(p.1.1 ^ 2)) := by
  by_cases h : pt y ∈ t.U
  · rw [conicMapL, dif_pos h] at hp
    have hp' := Sum.inl_injective hp
    subst hp'
    simp only [ToP1.val]
    rw [dif_pos h]
    congr 1
    change ev t.U y h t.f = _
    rw [← hT]
    change psiU φU y h eT = _
    have e1 := congrArg (psiU φU y h) rel1
    simp only [map_add, map_pow, map_zero] at e1
    linear_combination e1
  · rw [conicMapL, dif_neg h] at hp
    exact absurd hp (by simp)

/-- **`t = ∞` at the two points at infinity.** -/
theorem val_of_inr (y : Spec (CommRingCat.of Qbar) ⟶ X.left) (b)
    (hb : conicMapL φU φV hTg y = Sum.inr b) : t.val y = OnePoint.infty := by
  by_cases h : pt y ∈ t.U
  · rw [conicMapL, dif_pos h] at hb
    exact absurd hb (by simp)
  · simp only [ToP1.val]
    rw [dif_neg h]

omit hT in
theorem conicMapL_injective (hU : IsAffineOpen t.U) (hV : IsAffineOpen t.V)
    (y₁ y₂ : Spec (CommRingCat.of Qbar) ⟶ X.left)
    (e : conicMapL φU φV hTg y₁ = conicMapL φU φV hTg y₂) : y₁ = y₂ := by
  by_cases h₁ : pt y₁ ∈ t.U <;> by_cases h₂ : pt y₂ ∈ t.U
  · rw [conicMapL, dif_pos h₁, conicMapL, dif_pos h₂] at e
    have e' := congrArg Subtype.val (Sum.inl_injective e)
    simp only [Prod.mk.injEq] at e'
    have hψ : psiU φU y₁ h₁ = psiU φU y₂ h₂ := elkies_hom_ext _ _ e'.1 e'.2
    apply ev_injective t.U hU y₁ y₂ h₁ h₂
    ext s
    have := congrArg (fun ψ => ψ (φU.symm s)) hψ
    simpa [psiU] using this
  · rw [conicMapL, dif_pos h₁, conicMapL, dif_neg h₂] at e
    exact absurd e (by simp)
  · rw [conicMapL, dif_neg h₁, conicMapL, dif_pos h₂] at e
    exact absurd e (by simp)
  · rw [conicMapL, dif_neg h₁, conicMapL, dif_neg h₂] at e
    have e' := congrArg Subtype.val (Sum.inr_injective e)
    simp only at e'
    have v₁ := memV_of_not_memU y₁ h₁
    have v₂ := memV_of_not_memU y₂ h₂
    have hψ : psiV φV y₁ v₁ = psiV φV y₂ v₂ := by
      apply elkies_hom_ext _ _ _ e'
      rw [s_zero _ (psiV_T φV hTg y₁ h₁ v₁), s_zero _ (psiV_T φV hTg y₂ h₂ v₂)]
    apply ev_injective t.V hV y₁ y₂ v₁ v₂
    ext s
    have := congrArg (fun ψ => ψ (φV.symm s)) hψ
    simpa [psiV] using this

omit hT in
theorem conicMapL_surjective (hU : IsAffineOpen t.U) (hV : IsAffineOpen t.V)
    (c : HDec.X6Kummer.ConicPt) : ∃ y, conicMapL φU φV hTg y = c := by
  rcases c with ⟨⟨a, b⟩, hab⟩ | ⟨b, hb⟩
  · let ψ := elkiesLift (K := Qbar) (-(a ^ 2)) a b (by ring) (by simp only at hab; linear_combination hab)
    obtain ⟨y, h, hy⟩ := ev_surjective t.U hU (ψ.comp (φU.symm : Γ(X.left, t.U) →+* ElkiesRing))
    refine ⟨y, ?_⟩
    have hp : psiU φU y h = ψ := by
      unfold psiU; rw [hy]; exact RingHom.ext fun z => by simp
    rw [conicMapL, dif_pos h]
    congr 1
    apply Subtype.ext
    simp only [hp, ψ, elkiesLift_S, elkiesLift_R]
  · let ψ := elkiesLift (K := Qbar) 0 0 b (by ring) (by linear_combination hb)
    obtain ⟨y, hv, hy⟩ := ev_surjective t.V hV (ψ.comp (φV.symm : Γ(X.left, t.V) →+* ElkiesRing))
    have hp : psiV φV y hv = ψ := by
      unfold psiV; rw [hy]; exact RingHom.ext fun z => by simp
    have h0 : ev t.V y hv t.g = 0 := by
      rw [← hTg]
      change psiV φV y hv eT = 0
      rw [hp, elkiesLift_T]
    have h := not_memU_of_ev_g y hv h0
    refine ⟨y, ?_⟩
    rw [conicMapL, dif_neg h]
    congr 1
    apply Subtype.ext
    simp only [hp, ψ, elkiesLift_R]

end Proof

/-- **The conic model on `ℚ̄`-points from Elkies' equations** (`ConicModelT X t`, shimura-glue's
points form, from the chart form `ElkiesCharts X t`). -/
theorem conicModelT_of_charts {X : Over (Spec (CommRingCat.of ℚ))} {t : ToP1 X.left}
    (h : ElkiesCharts X t) : HDec.QMSplit.Moduli.ConicModelT X t := by
  obtain ⟨hU, hV, φU, φV, hT, hTg, -, -⟩ := h
  let F : (fieldPt Qbar ⟶ X) → HDec.X6Kummer.ConicPt := fun x => conicMapL φU φV hTg x.left
  have hinj : Function.Injective F := fun x₁ x₂ e =>
    Over.OverMorphism.ext (conicMapL_injective φU φV hTg hU hV _ _ e)
  have hsurj : Function.Surjective F := fun c => by
    obtain ⟨y, hy⟩ := conicMapL_surjective φU φV hTg hU hV c
    exact ⟨Over.homMk y (specQ_hom_ext _ _), hy⟩
  refine ⟨Equiv.ofBijective F ⟨hinj, hsurj⟩, fun σ x => ?_, fun x p hp => ?_, fun x b hb => ?_⟩
  · exact conicMapL_comp φU φV hTg σ x.left
  · exact val_of_inl φU φV hTg hT x.left p hp
  · exact val_of_inr φU φV hTg x.left b hb

end X6Glue

/-! # x6-glue part: parts/X6New.lean -/
/-! # x6-glue Part 4: Elkies' leaf in printed (equations) form; `r1r2` and `x6ConicModel` from published-form
leaves -/

namespace HDec.QMSplit.Moduli

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV

/-- **LEAF (Elkies, *Shimura curve computations*, ANTS-III, LNCS 1423 (1998), §3 (the curve `X*(6)`);
locators and the exact display UNVERIFIED, from memory, no network).** Some witness of the moduli clause
lists (the canonical `Y₃`, `X₆ = X₀(6,1)` with its moduli bijection `Ψ`) carries Elkies' coordinate
`t : X₆ → X*(6) = X₆/W ≅ P¹` with:
* the fibre clause: `t` is a coordinate on `X₆/W` (equal values iff the QM pairs are `Aut(𝒪)`-twists;
  `W ≅ Aut(𝒪) ≅ (ℤ/2)²` acting by twists is the moduli meaning of the Atkin–Lehner group, as in
  Baba–Granath Thm 2.1);
* `t = 0, 1, ∞` at the CM points of discriminants `−24, −4, −3` (Elkies' normalization; the assignment of
  `0` and `∞` is UNVERIFIED, residue fields pin `t = 1 ↔ D = −4`);
* **Elkies' equations** `X₆ = X*(6)(√−t, √(3(t − 1)))`, as the curve over the `t`-line:
  `ElkiesCharts X t` says that over `t ≠ ∞` the curve is `s² = −t, r² = 3(t − 1)` and over `t ≠ 0` it is
  `a² = −1/t, b² = 3(1/t − 1)` with `a = 1/s, b = r/s` (both opens affine with exactly these coordinate
  rings).
*Form*: Elkies prints the function field `ℚ(X₆) = ℚ(t)(√−t, √(3(t−1)))`; `ElkiesCharts` is the smooth
projective model of that function field (the affine curve `s² = −t, r² = 3(t − 1)` is smooth, since it is
`r² + 3s² + 3 = 0` with `t = −s²`, so it is the normalization of the `t`-line in that field; Hartshorne
I.6, II.6.7). The model statement replaces shimura-glue's points form `ConicModelT`, which
`X6Glue.conicModelT_of_charts` now derives. The fibre and CM clauses are those of `ElkiesConicT`
verbatim. -/
def ElkiesEquationsX6 : Prop :=
  ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y) (X : Over (Spec (CommRingCat.of ℚ)))
    (Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)) (fY : Y ⟶ X) (t : ToP1 X.left),
    R1fpProps Y Φ ∧ X6Props Y Φ X Ψ fY ∧
    (∀ (x x' : fieldPt Qbar ⟶ X) (P Q : QMPair Qbar),
      Ψ x = Quotient.mk _ P → Ψ x' = Quotient.mk _ Q →
        (t.val (K := Qbar) x.left = t.val (K := Qbar) x'.left ↔
            ∃ α : O ≃+* O, Nonempty (QMIso (P.q.twist α) Q.q)) ∧
        (HasCM24 P.q → t.val (K := Qbar) x.left = OnePoint.some 0) ∧
        (HasCM4 P.q → t.val (K := Qbar) x.left = OnePoint.some 1) ∧
        (HasCM3 P.q → t.val (K := Qbar) x.left = OnePoint.infty)) ∧
    X6Glue.ElkiesCharts X t

/-- **shimura-glue's `ElkiesConicT` from Elkies' equations** (`conicModelT_of_charts`). -/
theorem elkiesConicT_of_equations (h : ElkiesEquationsX6) : ElkiesConicT := by
  obtain ⟨Y, Φ, X, Ψ, fY, t, h1, h6, hcl, hc⟩ := h
  exact ⟨Y, Φ, X, Ψ, fY, t, h1, h6, hcl, X6Glue.conicModelT_of_charts hc⟩

/-- **shimura-split's `ElkiesConicX6` from Elkies' equations** (with the proved Möbius glue,
`j = 16(t − 1)/27`). -/
theorem elkiesConicX6_of_equations (h : ElkiesEquationsX6) : ElkiesConicX6 :=
  elkiesConicX6_of_t' (elkiesConicT_of_equations h)

/-- **The row `r1r2` from published-form leaves** (and one consequence, `RayClassCM`):
* `DeligneComponentsX6Printed`: Deligne's `π₀` display at level `𝒪̂^×` (printed form; the double coset
  `ℚ^×_{>0}\𝔸_f^×/nrd(𝒪̂^×) = 1` is computed in Lean, `ShimuraGlue.pi0_Kfull_eq_one`);
* `GeomConnOfAlgClosure`: EGA IV 4.5 / Stacks 0389, weakened (textbook);
* T5 (`PkgI2.TorsionStructure`, `A(k̄)[n] ≅ (ℤ/n)^{2g}`, textbook; Mumford §4);
* `BabaGranathRational`: Baba–Granath Thm 2.1 and Lemma 3.1 (printed; the CM assignment read from the §3.1
  table, UNVERIFIED);
* `RayClassCM`: Shimura reciprocity at CM points in ray-class form (**consequence**);
* `GonzalezRotgerX6`: González–Rotger 2006 Thm 5.12 (printed, on the canonical model). -/
theorem r1r2_of_published (hD : ShimuraGlue.DeligneComponentsX6Printed) (hE : GeomConnOfAlgClosure)
    (hT : PkgI2.TorsionStructure.{0}) (hB : BabaGranathRational) (hR : ShimuraGlue.Ray.RayClassCM)
    (hG : GonzalezRotgerX6) : LeafAdopt.R1R2fpRep :=
  r1r2fpRep_of_printed_t5 (ShimuraGlue.deligneComponentsX6_of_printed hD) hE hT
    (babaGranathX6'_of_rational' hB) (ShimuraGlue.Ray.reciprocityCanonical_of_rayClass hR) hG

/-- **The row `x6ConicModel` from published-form leaves**: those of `r1r2_of_published` and Elkies'
equations `ElkiesEquationsX6`. -/
theorem x6ConicModel_of_published (hD : ShimuraGlue.DeligneComponentsX6Printed)
    (hE : GeomConnOfAlgClosure) (hT : PkgI2.TorsionStructure.{0}) (hB : BabaGranathRational)
    (hR : ShimuraGlue.Ray.RayClassCM) (hG : GonzalezRotgerX6) (hC : ElkiesEquationsX6) :
    X6Kummer.X6ConicModel :=
  x6ConicModel_of_elkies_t5 (r1r2_of_published hD hE hT hB hR hG) (elkiesConicX6_of_equations hC) hT

/-- **The leaves of the two `X₆` fields** `r1r2` and `x6ConicModel`. -/
structure X6Leaves : Prop where
  deligneX6P : ShimuraGlue.DeligneComponentsX6Printed
  geomConn : GeomConnOfAlgClosure
  t5 : PkgI2.TorsionStructure.{0}
  babaGranathR : BabaGranathRational
  rayClass : ShimuraGlue.Ray.RayClassCM
  gonzalezRotger : GonzalezRotgerX6
  elkiesEq : ElkiesEquationsX6

theorem x6Rows_of_leaves (L : X6Leaves) : LeafAdopt.R1R2fpRep ∧ X6Kummer.X6ConicModel :=
  ⟨r1r2_of_published L.deligneX6P L.geomConn L.t5 L.babaGranathR L.rayClass L.gonzalezRotger,
    x6ConicModel_of_published L.deligneX6P L.geomConn L.t5 L.babaGranathR L.rayClass L.gonzalezRotger
      L.elkiesEq⟩

end HDec.QMSplit.Moduli

