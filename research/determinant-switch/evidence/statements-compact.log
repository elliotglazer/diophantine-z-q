    u_4} : ∀ {K : Type u_1} {F : Type u_2} {S : Type u_3} {H : Type u_4} [inst : Field.{u_1} K]
  [inst_1 : AddCommGroup.{u_2} F] [inst_2 : Module.{u_1, u_2} K F] [inst_3 : AddCommGroup.{u_3} S]
  [inst_4 : Module.{u_1, u_3} K S] [inst_5 : AddCommGroup.{u_4} H] [inst_6 : Module.{u_1, u_4} K H]
  (dF : LinearMap.{u_1, u_1, u_2, u_4} (RingHom.id.{u_1} K) F H)
  (dS : LinearMap.{u_1, u_1, u_3, u_4} (RingHom.id.{u_1} K) S H)
  (J : LinearEquiv.{u_1, u_1, u_2, u_3} (RingHom.id.{u_1} K) F S) (v : F),
  Research.DerivativeSwitch.AxesKernel.{u_1, u_2, u_3, u_4} dF dS J v →
    ∀ (x : F), Eq.{u_4 + 1} (dF x) 0 ↔ ∃ a, Eq.{u_2 + 1} x (HSMul.hSMul.{u_1, u_2, u_2} a v)
@Research.DerivativeSwitch.singular_kernel_line.{u_1, u_2, u_3,
