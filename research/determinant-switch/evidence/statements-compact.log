@Research.DerivativeSwitch.Volume.area_action.{u_1} : ∀ {R : Type u_1} [inst : CommRing.{u_1} R] (a b c d : R)
  (v w : Prod.{u_1, u_1} R R),
  Eq.{u_1 + 1}
    (Research.DerivativeSwitch.Volume.area.{u_1} (Research.DerivativeSwitch.Volume.action.{u_1} a b c d v)
      (Research.DerivativeSwitch.Volume.action.{u_1} a b c d w))
    (HMul.hMul.{u_1, u_1, u_1}
      (HSub.hSub.{u_1, u_1, u_1} (HMul.hMul.{u_1, u_1, u_1} a d) (HMul.hMul.{u_1, u_1, u_1} b c))
      (Research.DerivativeSwitch.Volume.area.{u_1} v w))
@Research.DerivativeSwitch.Volume.area_neg_one.{u_1} : ∀ {R : Type u_1} [inst : CommRing.{u_1} R] (a b c d : R)
  (v w : Prod.{u_1, u_1} R R),
  Eq.{u_1 + 1} (HSub.hSub.{u_1, u_1, u_1} (HMul.hMul.{u_1, u_1, u_1} a d) (HMul.hMul.{u_1, u_1, u_1} b c)) (-1) →
    Eq.{u_1 + 1} (Research.DerivativeSwitch.Volume.area.{u_1} v w) 1 →
      Eq.{u_1 + 1}
        (Research.DerivativeSwitch.Volume.area.{u_1} (Research.DerivativeSwitch.Volume.action.{u_1} a b c d v)
          (Research.DerivativeSwitch.Volume.action.{u_1} a b c d w))
        (-1)
