def Research.DerivativeSwitch.AxesKernel.{u_1, u_2, u_3, u_4} : {K : Type u_1} →
  {F : Type u_2} →
    {S : Type u_3} →
      {H : Type u_4} →
        [inst : Field.{u_1} K] →
          [inst_1 : AddCommGroup.{u_2} F] →
            [inst_2 : Module.{u_1, u_2} K F] →
              [inst_3 : AddCommGroup.{u_3} S] →
                [inst_4 : Module.{u_1, u_3} K S] →
                  [inst_5 : AddCommGroup.{u_4} H] →
                    [inst_6 : Module.{u_1, u_4} K H] →
                      LinearMap.{u_1, u_1, u_2, u_4} (RingHom.id.{u_1} K) F H →
                        LinearMap.{u_1, u_1, u_3, u_4} (RingHom.id.{u_1} K) S H →
                          LinearEquiv.{u_1, u_1, u_2, u_3} (RingHom.id.{u_1} K) F S → F → Prop :=
fun {K} {F} {S} {H} [Field.{u_1} K] [AddCommGroup.{u_2} F] [Module.{u_1, u_2} K F] [AddCommGroup.{u_3} S]
    [Module.{u_1, u_3} K S] [AddCommGroup.{u_4} H] [Module.{u_1, u_4} K H] dF dS J v =>
  ∀ (x : F) (y : S),
    Eq.{u_4 + 1} (HAdd.hAdd.{u_4, u_4, u_4} (dF x) (dS y)) 0 ↔
      ∃ a b, Eq.{u_2 + 1} x (HSMul.hSMul.{u_1, u_2, u_2} a v) ∧ Eq.{u_3 + 1} y (HSMul.hSMul.{u_1, u_3, u_3} b (J v))
