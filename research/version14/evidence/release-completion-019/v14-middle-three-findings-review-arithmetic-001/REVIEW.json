  "findings": [
    {
      "id": "SC-D128-EARLY-JACOBIAN",
      "decision": "accepted_record_repair",
      "basis": "Actual earlier J1(N), same Lprime, dimension two A, genus at least two and exponent24 remain explicit. Faltings Hom descent, same-field complement, genus/Belyi bounds, original-height normalization, source-J isogeny bound, variation and Bost lower bound match retained reviews. No later J_H/R19 assumptions substituted."
    },
    {
      "id": "SC-D137-KOENIGSMANN",
      "decision": "accepted_record_repair",
      "basis": "Actual two-trace quaternion (2,3) argument and convention use the retained sum-of-two trace theorem. Scalar-coordinate normalization and real splitting retained. Third original single-trace row is outside this intake, not deleted or newly adjudicated."
    },
    {
      "id": "SC-D141-41FORMS",
      "decision": "accepted_record_repair",
      "basis": "Actual m<=41 system retains GI39/MN39 and fixed coefficients/cutoff before X. Mertens density and product bounds preserve local logarithmic comparison and separate Selberg/truncation arguments. CM reduction uses prime-to-characteristic Tate injection, rational centralizer only, integral Frobenius, trace/determinant and Hasse; opposite twists/full two-torsion remain local premises."
    }
  ],
