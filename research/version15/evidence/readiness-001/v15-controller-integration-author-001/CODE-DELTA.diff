@@ -0,0 +1,91 @@
+"""Protected state routing prototype. No network or initialization on import."""
+import copy,re
+from git_state import Invalid,canonical,object_id
+
+def need(ok,message):
+    if not ok: raise Invalid(message)
+
+def exact(value,keys,message):
+    need(type(value) is dict and set(value)==set(keys.split()),message)
+
+def load(config):
+    base='schema controller_repository controller_repository_id jobs'
+    if config.get('schema')=='protocol-controller/v1':
+        exact(config,base,'invalid legacy controller config')
+        return None
+    exact(config,base+' state_routing','invalid routed controller config')
+    need(config['schema']=='protocol-controller/v2','unknown controller schema')
+    r=copy.deepcopy(config['state_routing'])
+    exact(r,'schema active namespaces owners','invalid routing fields')
+    need(r['schema']=='protocol-state-routing/v1','unknown routing schema')
+    need(type(r['namespaces']) is dict and 1<=len(r['namespaces'])<=2,'invalid namespace count')
+    ledger_ids=[]
+    for branch,ids in r['namespaces'].items():
+        need(branch in ('protocol-state','protocol-state-v15'),'unapproved state branch')
+        exact(ids,'operator intake','invalid expected ledger IDs')
+        for kind in ('operator','intake'):
+            need(type(ids[kind]) is str and re.fullmatch('[A-Za-z0-9._-]{1,100}',ids[kind]) is not None,'invalid ledger ID')
+            ledger_ids.append(ids[kind])
+    need(len(ledger_ids)==len(set(ledger_ids)),'shared ledger identity')
+    need(r['active'] in r['namespaces'],'unknown active namespace')
+    need(type(r['owners']) is dict and len(r['owners'])<=25000,'invalid ownership inventory')
+    for key,branch in r['owners'].items():
+        need(type(key) is str and re.fullmatch('[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*:[0-9a-f]{40}',key) is not None,'invalid ownership key')
+        need(branch in r['namespaces'],'unknown owner namespace')
+    return r
+
+def job(route,publisher,packet):
+    if route is None:return
+    need(publisher.target_mode=='head','routed prototype supports head publication only')
+    key=f'{publisher.app_id}:{publisher.installation_id}:{publisher.repository_id}:{packet["head"]["commit"]}'
+    need(route['owners'].get(key)==route['active'],'unassigned or foreign publication head')
+
+def checkpoints(route,index):
+    if route is None:return
+    expected=route['namespaces'][route['active']]
+    for kind in ('operator','intake'):
+        need(index['checkpoints'][kind]['ledger_id']==expected[kind],'wrong namespace ledger identity')
+
+def publisher_state(route,state):
+    if route is None:return
+    for row in state['generations']:
+        need(route['owners'].get(row['key'])==route['active'],'foreign publisher generation')
+    for row in state['targets']:
+        need(route['owners'].get(row['key'])==route['active'],'foreign publisher target owner')
+        need(row['target']==row['key'].rsplit(':',1)[1],'foreign historical publication target')
+
+def transition(old,new,cutover):
+    """Local config-review check; cutover evidence must be independently authenticated."""
+    need(old is not None and new is not None,'explicit old and new routing registry required')
+    for k,v in old['namespaces'].items():need(new['namespaces'].get(k)==v,'removed or changed namespace')
+    for k,v in old['owners'].items():need(new['owners'].get(k)==v,'removed or reassigned lifetime owner')
+    if old['active']!=new['active']:
+        exact(cutover,'old_branch old_state_commit old_index_sha256 no_active_writers finalization_complete','exact cutover evidence required')
+        need(cutover['old_branch']==old['active'],'wrong retired branch')
+        need(type(cutover['old_state_commit']) is str and re.fullmatch('[0-9a-f]{40}',cutover['old_state_commit']) is not None,'invalid retired state pin')
+        need(type(cutover['old_index_sha256']) is str and re.fullmatch('[0-9a-f]{64}',cutover['old_index_sha256']) is not None,'invalid retired index pin')
+        need(cutover['no_active_writers'] is True and cutover['finalization_complete'] is True,'unfinished old authority')
+    return True
+
+def initial_files(route,existing_refs):
+    """Pure proposed bytes only. Does not create a ref or authenticate a ref inventory."""
+    import hashlib,operator_ledger,audit_intake
+    branch=route['active'];need(branch not in existing_refs,'state ref already exists')
+    ids=route['namespaces'][branch]
+    snapshot={'schema':'protocol-controller-generation/v1','controller_sha':None,'state':{'schema':'protocol-publisher-state/v1','generations':[],'targets':[]},'publication':None}
+    raw=canonical(snapshot);sha=hashlib.sha256(raw).hexdigest();path='state/snapshots/'+sha+'.json'
+    index={'schema':1,'generation':0,'parent':None,'files':{path:{'blob':object_id('blob',raw),'sha256':sha,'size':len(raw)}},'checkpoints':{'operator':operator_ledger.genesis(ids['operator']),'intake':audit_intake.genesis(ids['intake']),'publisher':{'snapshot_sha256':sha}}}
+    return {path:raw,'state/index.json':canonical(index)}
+
+
+def authorized(config,environment):
+    """Digest supplied by protected controller environment, never by packet/batch."""
+    import hashlib
+    route=load(config)
+    expected=environment.get('PROTOCOL_STATE_ROUTING_SHA256','')
+    if route is None:
+        need(not expected,'routed authority cannot downgrade to legacy config')
+        return None
+    need(type(expected) is str and re.fullmatch('[0-9a-f]{64}',expected) is not None,'protected routing digest required')
+    need(hashlib.sha256(canonical(route)).hexdigest()==expected,'protected routing digest mismatch')
+    return route
--- a/controller/namespace_lifecycle.py
+++ b/controller/namespace_lifecycle.py
@@ -0,0 +1,130 @@
+"""Offline namespace archive/cutover helpers. No credentials, network, or ref writes."""
+import base64,copy,hashlib,re
+import audit_intake,operator_ledger,state_routing as routing
+from git_state import canonical,object_id,path_ok,MAX_BLOB,MAX_TOTAL,MAX_FILES
+from runtime import MAX_ENTRIES
+need=routing.need
+sha=lambda raw:hashlib.sha256(raw).hexdigest()
+
+def check_entry_count(count):
+    need(count <= MAX_ENTRIES, 'export ledger entry cap')
+
+def export_namespace(remote,route,keys):
+    """Caller supplies the existing guarded RemoteState; returns exact file bytes."""
+    need(remote.store.branch==route['active'],'export route mismatch')
+    routing.checkpoints(route,remote.current.index)
+    remote.entries('operator',operator_ledger,keys['operator'])
+    remote.entries('intake',audit_intake,keys['intake'])
+    remote.check()
+    files=copy.deepcopy(remote.current.entries)
+    files['state/index.json']=canonical(remote.current.index)
+    descriptor={'schema':'protocol-namespace-export/v1','branch':route['active'],
+        'state_commit':remote.current.commit,'tree':remote.current.tree,
+        'index_sha256':sha(files['state/index.json']),
+        'files':{p:{'sha256':sha(raw),'size':len(raw)}for p,raw in sorted(files.items())}}
+    remote.check()
+    return descriptor,files
+
+def inspect_export(descriptor,files,expected_sha256,route,keys):
+    """Expected descriptor digest must come from separately authenticated seal/review."""
+    need(sha(canonical(descriptor))==expected_sha256,'wrong sealed export digest')
+    routing.exact(descriptor,'schema branch state_commit tree index_sha256 files','invalid export schema')
+    need(descriptor['schema']=='protocol-namespace-export/v1' and descriptor['branch']==route['active'],'wrong export namespace')
+    need(all(type(descriptor[k]) is str and re.fullmatch('[0-9a-f]{40}',descriptor[k]) for k in ('state_commit','tree')),'invalid export Git IDs')
+    need(type(files) is dict and set(files)==set(descriptor['files']) and len(files)<=MAX_FILES,'export file inventory')
+    for p,raw in files.items():
+        need(p=='state/index.json' or path_ok(p),'export path outside state')
+        need(type(raw) is bytes and len(raw)<=MAX_BLOB,'export blob limit')
+        need(descriptor['files'][p]=={'sha256':sha(raw),'size':len(raw)},'export file mismatch')
+    import json
+    index=json.loads(files['state/index.json'])
+    routing.exact(index,'schema generation parent files checkpoints','invalid exported index schema')
+    need(index['schema']==1 and type(index['generation'])is int and index['generation']>=0,'invalid exported generation')
+    routing.exact(index['checkpoints'],'operator intake publisher','invalid exported checkpoints')
+    need(canonical(index)==files['state/index.json'] and sha(files['state/index.json'])==descriptor['index_sha256'],'export index mismatch')
+    need(set(index['files'])==set(files)-{'state/index.json'},'indexed export differs')
+    need(sum(v['size']for v in index['files'].values())<=MAX_TOTAL,'export total limit')
+    for p,v in index['files'].items():
+        need(v=={'blob':object_id('blob',files[p]),'sha256':sha(files[p]),'size':len(files[p])},'indexed blob mismatch')
+    routing.checkpoints(route,index)
+    states={}
+    for kind,codec in (('operator',operator_ledger),('intake',audit_intake)):
+        cp=index['checkpoints'][kind];codec.check_checkpoint(cp)
+        check_entry_count(cp['sequence'])
+        prefix='state/entries/'+kind+'/'
+        paths=[prefix+f'{n:010d}.json'for n in range(1,cp['sequence']+1)]
+        need(set(paths)=={p for p in files if p.startswith(prefix)},'export ledger inventory mismatch')
+        entries=[json.loads(files[p])for p in paths]
+        need(all(canonical(e)==files[p]for e,p in zip(entries,paths)),'noncanonical export entry')
+        states[kind]=codec.verify(entries,keys[kind],cp)
+    pointer=index['checkpoints']['publisher']['snapshot_sha256']
+    raw=files['state/snapshots/'+pointer+'.json'];need(sha(raw)==pointer,'publisher snapshot digest')
+    wrapper=json.loads(raw);need(canonical(wrapper)==raw,'noncanonical publisher snapshot')
+    routing.exact(wrapper,'schema controller_sha state publication','publisher wrapper fields')
+    need(wrapper['schema']=='protocol-controller-generation/v1','publisher wrapper schema')
+    states['publisher']=wrapper['state']
+    return index,states
+
+def ownership(states,branch,publishers):
+    """Conservative reservation of every authenticated frozen/captured/publication head."""
+    owners={}
+    def reserve(repository,head):
+        need(type(repository) is int and repository>0 and type(head)is str and re.fullmatch('[0-9a-f]{40}',head),'invalid historical head')
+        identities=publishers.get(str(repository))
+        need(type(identities)is list and identities,'missing historical publisher identity')
+        for pair in identities:
+            need(type(pair)is list and len(pair)==2 and all(type(x)is int and x>0 for x in pair),'invalid publisher identity')
+            owners[f'{pair[0]}:{pair[1]}:{repository}:{head}']=branch
+    for row in states['operator']['freezes'].values():
+        b=row['event']['binding'];reserve(b['repository_id'],b['head_commit'])
+    for row in states['intake']['captures'].values():
+        b=row['binding'];reserve(b['repository_id'],b['head_commit'])
+    state=states['publisher']
+    routing.exact(state,'schema generations targets','publisher state fields')
+    need(state['schema']=='protocol-publisher-state/v1','publisher state schema')
+    for row in state['generations']+state['targets']:
+        need(type(row.get('key'))is str and re.fullmatch('[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*:[0-9a-f]{40}',row['key']),'invalid publisher key')
+        app,install,repo,head=row['key'].split(':')
+        need([int(app),int(install)] in publishers.get(repo,[]),'unbound historical publisher')
+        reserve(int(repo),head)
+        if 'target'in row:reserve(int(repo),row['target'])
+    return owners
+
+def prepare_transition(old_config,new_config,descriptor,files,export_sha256,old_route,keys,publishers,cutover,review):
+    """Pure preparation; exact independent review binds all proposed trust inputs."""
+    new_route=routing.load(new_config);need(new_route is not None,'v2 downgrade forbidden')
+    existing=routing.load(old_config)
+    if existing is not None:need(existing==old_route,'old protected registry mismatch')
+    else:
+        need(old_route['active']=='protocol-state','legacy migration must preserve original branch')
+    subject={'old_config_sha256':sha(canonical(old_config)),'new_config_sha256':sha(canonical(new_config)),
+        'export_sha256':export_sha256,'old_route_sha256':sha(canonical(old_route)),
+        'publishers_sha256':sha(canonical(publishers)),'cutover':cutover}
+    need(review.get('decision')=='accepted' and review.get('subject_sha256')==sha(canonical(subject)),'exact independent cutover acceptance required')
+    index,states=inspect_export(descriptor,files,export_sha256,old_route,keys)
+    need(cutover.get('old_state_commit')==descriptor['state_commit'] and cutover.get('old_index_sha256')==descriptor['index_sha256'],'cutover sealed state mismatch')
+    required=ownership(states,old_route['active'],publishers)
+    for k,v in required.items():need(old_route['owners'].get(k)==v,'historical owner omitted')
+    routing.transition(old_route,new_route,cutover)
+    return {'schema':'protocol-routing-preparation/v1','old_state_commit':descriptor['state_commit'],
+        'new_config_sha256':sha(canonical(new_config)),
+        'required_protected_variable':{'name':'PROTOCOL_STATE_ROUTING_SHA256','value':sha(canonical(new_route))},
+        'subject_sha256':sha(canonical(subject)),
+        'scope':'Offline exact preparation only; live ref absence/no-writer/final state and approved revision must be rechecked by owner before mutation.'}
+
+
+def prepare_bootstrap(route,observation,review,expected_controller,expected_retired_commit):
+    """Only prepare bytes from a separately reviewed exact ref observation.
+
+    A future root writer must recheck live identity/refs and use create-only ref
+    creation, which rejects an intervening creator. This function never writes.
+    """
+    routing.exact(observation,'schema repository repository_id approved_controller_sha refs','invalid bootstrap observation')
+    need(observation['schema']=='protocol-bootstrap-ref-observation/v1','bootstrap observation schema')
+    need((observation['repository'],observation['repository_id'],observation['approved_controller_sha'])==expected_controller,'bootstrap controller identity mismatch')
+    need(review.get('decision')=='accepted' and review.get('subject_sha256')==sha(canonical(observation)),'exact ref-observation acceptance required')
+    refs=observation['refs'];need(type(refs)is dict,'ref observation required')
+    need(refs.get('protocol-state')==expected_retired_commit,'retired state changed')
+    need(route['active']=='protocol-state-v15','bootstrap only prepares fresh V15 namespace')
+    need(route['active'] not in refs,'V15 state ref already exists')
+    return routing.initial_files(route,refs)
